---
import { url } from "@/utils/url-utils";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import novelData from "@/data/novels.json";
import { proxyCoverUrl } from "@/utils/cover";
import StarRating from "@/components/misc/StarRating.astro";

export async function getStaticPaths() {
  const { novels: entries } = novelData;
  return (entries || []).map(item => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { novels: novelEntries } = novelData;

// 计量单位：章/话/卷，默认「章」
const unit: string =
	"unit" in item && typeof (item as { unit?: unknown }).unit === "string"
		? ((item as { unit: string }).unit)
		: "章";

// 封面统一走同源代理（外链才代理，本地路径原样返回）
const coverSrc = (cover?: string, w?: number) => proxyCoverUrl(cover, w);

// 相关小说：同分类的优先，不足再用共同标签补
const sameCategory = (novelEntries || []).filter(
	a => a.id !== item.id && item.category && a.category === item.category
);
const sameTag = (novelEntries || []).filter(
	a => a.id !== item.id && !sameCategory.includes(a) && a.tags && a.tags.some(t => item.tags?.includes(t))
);
const relatedNovels = [...sameCategory, ...sameTag].slice(0, 6);
---
<MainGridLayout title={`${item.title} - 小说`} description={item.synopsis || item.title}>
  <div class="card-base novel-page-root z-10 px-6 py-6 relative w-full">

    <!-- 返回按钮 -->
    <a href={url("/novel/")} style="display: inline-flex; align-items: center; gap: 6px; color: var(--primary); font-size: 1rem; margin-bottom: 16px; text-decoration: none;">
      <span>←</span> 返回小说列表
    </a>

    <!-- 头部信息 -->
    <div class="novel-detail-header" style="display: flex; gap: 20px; margin-bottom: 28px;">
      <div class="novel-detail-cover" style="position: relative; width: 160px; flex-shrink: 0; aspect-ratio: 3/4; border-radius: 12px; overflow: hidden; background: var(--card-bg-transparent);">
        {item.cover ? (
          <img src={coverSrc(item.cover, 400)} alt={item.title} style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;" />
        ) : (
          <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 3rem;">📖</div>
        )}
      </div>
      <div class="novel-detail-info" style="flex: 1;">
        <h1 style="font-size: 2rem; font-weight: 700; margin-bottom: 4px; color: var(--text-primary);">{item.title}</h1>
        {item.titleJp && <p style="color: var(--text-secondary); font-size: 1.1rem; margin-bottom: 12px;">{item.titleJp}</p>}

        <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 12px; font-size: 1rem; align-items: center;">
          <StarRating score={item.score} size="1.15rem" showValue />
          {item.year && <span style="color: var(--text-secondary);">· {item.year}</span>}
          {item.studio && <span style="color: var(--text-secondary);">· {item.studio}</span>}
          {item.totalEpisodes && <span style="color: var(--text-secondary);">· {item.totalEpisodes}{unit}</span>}
        </div>

        {item.progress > 0 && item.totalEpisodes ? (
          <div style="margin-bottom: 8px; color: var(--text-secondary); font-size: 0.95rem;">
            进度: {item.progress}/{item.totalEpisodes}{unit}
          </div>
        ) : null}

        {(item.category || item.platform) && (
          <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px;">
            {item.category && (
              <span style="font-size: 0.85rem; padding: 3px 10px; border-radius: 4px; background: var(--card-bg-transparent); color: var(--text-secondary);">{item.category}</span>
            )}
            {item.platform && (
              <span style="font-size: 0.85rem; padding: 3px 10px; border-radius: 4px; background: var(--card-bg-transparent); color: var(--text-secondary);">{item.platform}</span>
            )}
            {(item.tags || []).map(tag => (
              <span style="font-size: 0.85rem; padding: 3px 10px; border-radius: 4px; background: var(--card-bg-transparent); color: var(--text-secondary);">#{tag}</span>
            ))}
          </div>
        )}
      </div>
    </div>

    <!-- 简介 -->
    {item.synopsis && (
      <div style="margin-bottom: 28px;">
        <h2 style="font-size: 1.3rem; font-weight: 600; margin-bottom: 8px; color: var(--text-primary);">简介</h2>
        <p style="color: var(--text-secondary); line-height: 1.8; font-size: 1.05rem; white-space: pre-wrap;">{item.synopsis}</p>
      </div>
    )}

    <!-- 读后感 -->
    {item.review && (
      <div style="margin-bottom: 28px;">
        <h2 style="font-size: 1.3rem; font-weight: 600; margin-bottom: 8px; color: var(--text-primary);">读后感</h2>
        <div class="novel-review-content" style="line-height: 1.9; color: var(--text-primary); font-size: 1.05rem; white-space: pre-wrap;">{item.review}</div>
        {item.reviewDate && (
          <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 12px;">写于 {new Date(item.reviewDate).toLocaleDateString('zh-CN')}</p>
        )}
      </div>
    )}

    <!-- 相关推荐 -->
    {relatedNovels.length > 0 && (
      <div>
        <h2 style="font-size: 1.3rem; font-weight: 600; margin-bottom: 12px; color: var(--text-primary);">相关小说</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 12px;">
          {relatedNovels.map(rel => (
            <a href={url(`/novel/${rel.id}/`)} style="text-decoration: none; color: inherit;">
              <div style="position: relative; aspect-ratio: 3/4; border-radius: 8px; overflow: hidden; background: var(--card-bg-transparent); margin-bottom: 4px;">
                {rel.cover ? (
                  <img src={coverSrc(rel.cover, 200)} alt={rel.title} loading="lazy" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;" />
                ) : (
                  <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">📖</div>
                )}
              </div>
              <div style="font-size: 0.9rem; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-primary);">{rel.title}</div>
              <div style="font-size: 0.85rem; color: #ffc53d;">{'★'.repeat(rel.score || 0)}</div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</MainGridLayout>

<style is:global>
  /* 小说详情页文字颜色变量,根据暗色/亮色模式自动切换,只作用于小说页面 */
  .novel-page-root {
    --text-primary: rgba(0, 0, 0, 0.9);
    --text-secondary: rgba(0, 0, 0, 0.65);
    --text-muted: rgba(0, 0, 0, 0.45);
  }
  .dark .novel-page-root {
    --text-primary: rgba(255, 255, 255, 0.95);
    --text-secondary: rgba(255, 255, 255, 0.65);
    --text-muted: rgba(255, 255, 255, 0.45);
  }
  @media (max-width: 640px) {
    .novel-detail-header { flex-direction: column; }
    .novel-detail-cover { width: 120px; margin: 0 auto; }
    .novel-detail-info { text-align: center; }
  }
</style>
