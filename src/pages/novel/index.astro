---
import { url } from "@/utils/url-utils";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import novelData from "@/data/novels.json";
import { proxyCoverUrl, textCoverUrl } from "@/utils/cover";
import StarRating from "@/components/misc/StarRating.astro";

const { novels: novelEntries } = novelData;

const allNovels = novelEntries || [];

// 封面统一走同源代理（外链才代理，本地路径原样返回）
const coverSrc = (cover?: string, w?: number) => proxyCoverUrl(cover, w);

// 固定三大分类：日轻 / 韩轻 / 网文。分类存在条目的 category 字段上。
const CATEGORY_OPTIONS = ["日本轻小说", "韩国轻小说", "中国网文"];
const categories = [
  { name: "全部", value: "all" },
  ...CATEGORY_OPTIONS.map(name => ({ name, value: name })),
];

export async function getStaticPaths() {
  return [];
}
---
<MainGridLayout title="小说 - 阅读清单" description="我的小说清单和读后感">
  <div class="card-base novel-page-root z-10 px-6 py-6 relative w-full">
    <div class="novel-header" style="margin-bottom: 24px;">
      <h1 style="font-size: 2rem; font-weight: 700; margin-bottom: 4px; color: var(--text-primary);">小说</h1>
      <p style="color: var(--text-secondary); font-size: 1.05rem;">我的小说清单 —— 日轻、韩轻、网文</p>
    </div>

    <!-- 分类筛选 -->
    <div class="novel-categories" style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px;">
      {categories.map(cat => (
        <button class="novel-cat-btn active" data-category={cat.value}>{cat.name}</button>
      ))}
    </div>

    <!-- 小说卡片网格 -->
    <div class="novel-grid" id="novelGrid">
      {allNovels.map(item => (
        <a href={url(`/novel/${item.id}/`)} class="novel-card" data-category={item.category || ''} data-tags={(item.tags || []).join(',')}>
          <div class="novel-cover" style={`aspect-ratio: 3/4; border-radius: 12px; overflow: hidden; background: var(--card-bg-transparent); position: relative;${item.cover ? `background-image: url("${textCoverUrl(item.title)}"); background-size: cover; background-position: center;` : ""}`}>
            <img src={item.cover ? coverSrc(item.cover, 400) : textCoverUrl(item.title)} alt={item.title} loading="lazy" onerror="this.style.display='none'" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block;" />
          </div>
          <div class="novel-info" style="padding: 8px 4px;">
            <div class="novel-title" style="font-weight: 600; font-size: 1rem; line-height: 1.3; margin-bottom: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-primary);">{item.title}</div>
            <div class="novel-meta" style="display: flex; align-items: center; gap: 6px; font-size: 0.9rem; color: var(--text-secondary);">
              <StarRating score={item.score} size="0.95rem" />
              {item.year && <span>· {item.year}</span>}
            </div>
            <div class="novel-bottom-row" style="display: flex; align-items: center; gap: 6px; margin-top: 6px; flex-wrap: wrap;">
              {(item.tags || []).slice(0, 3).map(tag => (
                <span style="font-size: 0.8rem; padding: 2px 8px; border-radius: 4px; background: var(--card-bg-transparent); color: var(--text-secondary);">#{tag}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>

    {allNovels.length === 0 && (
      <div style="text-align: center; padding: 60px 20px; color: var(--text-secondary);">
        <div style="font-size: 3rem; margin-bottom: 12px;">📖</div>
        <p>暂无小说记录</p>
      </div>
    )}
  </div>
</MainGridLayout>

<style is:global>
  .novel-page-root {
    --text-primary: rgba(0, 0, 0, 0.9);
    --text-secondary: rgba(0, 0, 0, 0.65);
    --text-muted: rgba(0, 0, 0, 0.45);
  }
  .dark .novel-page-root {
    --text-primary: rgba(255, 255, 255, 0.95);
    --text-secondary: rgba(255, 255, 255, 0.65);
    --text-muted: rgba(255, 255, 255, 0.45);
  }
  .novel-cat-btn {
    padding: 8px 16px; border-radius: 20px; border: 1px solid var(--line-divider);
    background: var(--card-bg); color: var(--text-secondary); cursor: pointer;
    font-size: 0.95rem; font-weight: 500; transition: all 0.2s;
  }
  .novel-cat-btn:hover { border-color: var(--primary); color: var(--primary); }
  .novel-cat-btn.active {
    background: var(--primary); color: white; border-color: var(--primary);
  }
  .novel-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 16px;
  }
  .novel-card { text-decoration: none; color: inherit; transition: transform 0.2s; }
  .novel-card:hover { transform: translateY(-4px); }

  @media (max-width: 640px) {
    .novel-grid { grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 10px; }
    .novel-title { font-size: 0.9rem !important; }
  }
</style>

<script>
  // 分类筛选
  document.querySelectorAll('.novel-cat-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.novel-cat-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      filterNovel();
    });
  });
  function filterNovel() {
    const category = document.querySelector('.novel-cat-btn.active')?.getAttribute('data-category') || '';
    document.querySelectorAll('.novel-card').forEach(card => {
      const itemCategory = card.getAttribute('data-category') || '';
      const matchCategory = category === 'all' || itemCategory === category;
      (card as HTMLElement).style.display = matchCategory ? '' : 'none';
    });
  }
</script>
