---
import { url } from "@/utils/url-utils";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import animeData from "@/data/anime.json";

const { anime: animeEntries, categories: presetCategories } = animeData;

// 按状态分组
const statusLabels: Record<string, string> = {
  completed: "看完",
  watching: "在看",
  planned: "想看",
};

const allAnime = animeEntries || [];

// 动态从番剧数据中提取实际使用过的标签(只有用户添加了标签才会出现)
const dynamicCategories = Array.from(
  new Set(allAnime.flatMap(a => a.tags || []))
).map(name => ({ name, value: name }));

// 合并预设分类和动态分类,去重
const seen = new Set<string>();
const categories = [
  { name: "全部", value: "all" },
  ...dynamicCategories.filter(c => {
    if (seen.has(c.value)) return false;
    seen.add(c.value);
    return true;
  }),
];

export async function getStaticPaths() {
  return [];
}
---
<MainGridLayout title="番剧 - 追番清单" description="我的追番清单和观后感">
  <div class="card-base anime-page-root z-10 px-6 py-6 relative w-full">
    <div class="anime-header" style="margin-bottom: 24px;">
      <h1 style="font-size: 2rem; font-weight: 700; margin-bottom: 4px; color: var(--text-primary);">番剧</h1>
      <p style="color: var(--text-secondary); font-size: 1.05rem;">我的追番清单 —— 正在看的、看完的、排队的</p>
    </div>

    <!-- 状态筛选 + 分类筛选 -->
    <div class="anime-filters" style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px;">
      <button class="anime-filter-btn active" data-status="all">全部 ({allAnime.length})</button>
      {Object.entries(statusLabels).map(([value, label]) => {
        const count = allAnime.filter(a => a.status === value).length;
        return <button class="anime-filter-btn" data-status={value}>{label} ({count})</button>;
      })}
    </div>

    {dynamicCategories.length > 0 && (
      <div class="anime-categories" style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px;">
        {categories.map(cat => (
          <button class="anime-cat-btn active" data-category={cat.value}>{cat.name}</button>
        ))}
      </div>
    )}

    <!-- 番剧卡片网格 -->
    <div class="anime-grid" id="animeGrid">
      {allAnime.map(item => (
        <a href={url(`/anime/${item.id}/`)} class="anime-card" data-status={item.status} data-tags={(item.tags || []).join(',')}>
          <div class="anime-cover" style="aspect-ratio: 3/4; border-radius: 12px; overflow: hidden; background: var(--card-bg-transparent); position: relative;">
            {item.cover ? (
              <img src={item.cover} alt={item.title} loading="lazy" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
            ) : (
              <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 2rem;">🎬</div>
            )}
            <div class="anime-status-badge" data-status={item.status} style="position: absolute; top: 8px; right: 8px; padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 600;">
              {statusLabels[item.status] || item.status}
            </div>
          </div>
          <div class="anime-info" style="padding: 8px 4px;">
            <div class="anime-title" style="font-weight: 600; font-size: 1rem; line-height: 1.3; margin-bottom: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-primary);">{item.title}</div>
            <div class="anime-meta" style="display: flex; align-items: center; gap: 6px; font-size: 0.9rem; color: var(--text-secondary);">
              <span class="anime-stars" data-score={item.score}>
                {'★'.repeat(item.score || 0)}{'☆'.repeat(5 - (item.score || 0))}
              </span>
              {item.year && <span>· {item.year}</span>}
            </div>
            {item.tags && item.tags.length > 0 && (
              <div class="anime-tags" style="margin-top: 4px; display: flex; flex-wrap: wrap; gap: 4px;">
                {item.tags.slice(0, 3).map(tag => (
                  <span style="font-size: 0.8rem; padding: 2px 8px; border-radius: 4px; background: var(--card-bg-transparent); color: var(--text-secondary);">#{tag}</span>
                ))}
              </div>
            )}
          </div>
        </a>
      ))}
    </div>

    {allAnime.length === 0 && (
      <div style="text-align: center; padding: 60px 20px; color: var(--text-secondary);">
        <div style="font-size: 3rem; margin-bottom: 12px;">📺</div>
        <p>暂无番剧记录</p>
      </div>
    )}
  </div>
</MainGridLayout>

<style is:global>
  .anime-page { max-width: 1200px; margin: 0 auto; padding: 20px; }
  /* 番剧页面文字颜色变量,根据暗色/亮色模式自动切换,只作用于番剧页面 */
  .anime-page-root {
    --text-primary: rgba(0, 0, 0, 0.9);
    --text-secondary: rgba(0, 0, 0, 0.65);
    --text-muted: rgba(0, 0, 0, 0.45);
  }
  .dark .anime-page-root {
    --text-primary: rgba(255, 255, 255, 0.95);
    --text-secondary: rgba(255, 255, 255, 0.65);
    --text-muted: rgba(255, 255, 255, 0.45);
  }
  .anime-filter-btn, .anime-cat-btn {
    padding: 8px 16px; border-radius: 20px; border: 1px solid var(--line-divider);
    background: var(--card-bg); color: var(--text-secondary); cursor: pointer;
    font-size: 0.95rem; font-weight: 500; transition: all 0.2s;
  }
  .anime-filter-btn:hover, .anime-cat-btn:hover { border-color: var(--primary); color: var(--primary); }
  .anime-filter-btn.active, .anime-cat-btn.active {
    background: var(--primary); color: white; border-color: var(--primary);
  }
  .anime-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 16px;
  }
  .anime-card { text-decoration: none; color: inherit; transition: transform 0.2s; }
  .anime-card:hover { transform: translateY(-4px); }
  .anime-status-badge[data-status="completed"] { background: rgba(82, 196, 26, 0.85); color: white; }
  .anime-status-badge[data-status="watching"] { background: rgba(59, 170, 255, 0.85); color: white; }
  .anime-status-badge[data-status="planned"] { background: rgba(255, 170, 74, 0.85); color: white; }
  .anime-stars { color: #ffc53d; font-size: 0.95rem; }

  @media (max-width: 640px) {
    .anime-grid { grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 10px; }
    .anime-title { font-size: 0.9rem !important; }
  }
</style>

<script>
  // 状态筛选
  document.querySelectorAll('.anime-filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.anime-filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      filterAnime();
    });
  });
  // 分类筛选
  document.querySelectorAll('.anime-cat-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.anime-cat-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      filterAnime();
    });
  });
  function filterAnime() {
    const status = document.querySelector('.anime-filter-btn.active')?.getAttribute('data-status');
    const category = document.querySelector('.anime-cat-btn.active')?.getAttribute('data-category');
    document.querySelectorAll('.anime-card').forEach(card => {
      const matchStatus = status === 'all' || card.getAttribute('data-status') === status;
      const tags = card.getAttribute('data-tags') || '';
      const matchCategory = category === 'all' || tags.split(',').includes(category);
      card.style.display = (matchStatus && matchCategory) ? '' : 'none';
    });
  }
</script>
