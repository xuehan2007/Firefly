---
import { url } from "@/utils/url-utils";
import Layout from "@/layouts/Layout.astro";
import animeData from "@/data/anime.json";

export async function getStaticPaths() {
  const { anime: entries } = animeData;
  return (entries || []).map(item => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { anime: animeEntries } = animeData;

const statusLabels: Record<string, string> = {
  completed: "看完",
  watching: "在看",
  planned: "想看",
};

// 获取相关番剧（同标签的其他番剧）
const relatedAnime = (animeEntries || [])
  .filter(a => a.id !== item.id && a.tags && a.tags.some(t => item.tags?.includes(t)))
  .slice(0, 6);
---
<Layout title={`${item.title} - 番剧`} description={item.synopsis || item.title}>
  <div class="anime-detail" style="max-width: 900px; margin: 0 auto; padding: 20px;">
    
    <!-- 返回按钮 -->
    <a href={url("/anime/")} style="display: inline-flex; align-items: center; gap: 6px; color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 16px; text-decoration: none;">
      <span>←</span> 返回番剧列表
    </a>

    <!-- 头部信息 -->
    <div class="anime-detail-header" style="display: flex; gap: 20px; margin-bottom: 28px;">
      <div class="anime-detail-cover" style="width: 160px; flex-shrink: 0; aspect-ratio: 3/4; border-radius: 12px; overflow: hidden; background: var(--card-bg-transparent);">
        {item.cover ? (
          <img src={item.cover} alt={item.title} style="width: 100%; height: 100%; object-fit: cover;" />
        ) : (
          <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 3rem;">🎬</div>
        )}
      </div>
      <div class="anime-detail-info" style="flex: 1;">
        <h1 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 4px;">{item.title}</h1>
        {item.titleJp && <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 12px;">{item.titleJp}</p>}
        
        <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 12px; font-size: 0.85rem;">
          <span style="color: var(--text-secondary);">
            <span style="color: #ffc53d; font-size: 1.1rem;">{'★'.repeat(item.score || 0)}</span>
            <span style="color: var(--text-muted);">{'☆'.repeat(5 - (item.score || 0))}</span>
            <span style="margin-left: 4px;">{item.score}.0</span>
          </span>
          {item.year && <span style="color: var(--text-secondary);">· {item.year}</span>}
          {item.studio && <span style="color: var(--text-secondary);">· {item.studio}</span>}
          {item.totalEpisodes && <span style="color: var(--text-secondary);">· {item.totalEpisodes}集</span>}
        </div>

        <div style="margin-bottom: 8px;">
          <span class="anime-status-badge" data-status={item.status} style="display: inline-block; padding: 3px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 600;">
            {statusLabels[item.status] || item.status}
          </span>
          {item.progress && item.totalEpisodes && (
            <span style="margin-left: 8px; color: var(--text-secondary); font-size: 0.8rem;">进度: {item.progress}/{item.totalEpisodes}</span>
          )}
        </div>

        {item.tags && item.tags.length > 0 && (
          <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px;">
            {item.tags.map(tag => (
              <span style="font-size: 0.7rem; padding: 2px 8px; border-radius: 4px; background: var(--card-bg-transparent); color: var(--text-secondary);">#{tag}</span>
            ))}
          </div>
        )}
      </div>
    </div>

    <!-- 简介 -->
    {item.synopsis && (
      <div style="margin-bottom: 28px;">
        <h2 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 8px;">简介</h2>
        <p style="color: var(--text-secondary); line-height: 1.7; font-size: 0.9rem;">{item.synopsis}</p>
      </div>
    )}

    <!-- 观后感 -->
    {item.review && (
      <div style="margin-bottom: 28px;">
        <h2 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 8px;">观后感</h2>
        <div class="anime-review-content" style="line-height: 1.8; color: var(--text-primary); font-size: 0.9rem; white-space: pre-wrap;">{item.review}</div>
        {item.reviewDate && (
          <p style="color: var(--text-muted); font-size: 0.75rem; margin-top: 12px;">写于 {new Date(item.reviewDate).toLocaleDateString('zh-CN')}</p>
        )}
      </div>
    )}

    <!-- 相关推荐 -->
    {relatedAnime.length > 0 && (
      <div>
        <h2 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 12px;">相关番剧</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 12px;">
          {relatedAnime.map(rel => (
            <a href={url(`/anime/${rel.id}/`)} style="text-decoration: none; color: inherit;">
              <div style="aspect-ratio: 3/4; border-radius: 8px; overflow: hidden; background: var(--card-bg-transparent); margin-bottom: 4px;">
                {rel.cover ? (
                  <img src={rel.cover} alt={rel.title} loading="lazy" style="width: 100%; height: 100%; object-fit: cover;" />
                ) : (
                  <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">🎬</div>
                )}
              </div>
              <div style="font-size: 0.75rem; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{rel.title}</div>
              <div style="font-size: 0.7rem; color: #ffc53d;">{'★'.repeat(rel.score || 0)}</div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</Layout>

<style is:global>
  .anime-status-badge[data-status="completed"] { background: rgba(82, 196, 26, 0.15); color: #73d13d; border: 1px solid rgba(82, 196, 26, 0.3); }
  .anime-status-badge[data-status="watching"] { background: rgba(59, 170, 255, 0.15); color: var(--primary); border: 1px solid rgba(59, 170, 255, 0.3); }
  .anime-status-badge[data-status="planned"] { background: rgba(255, 170, 74, 0.15); color: #ffaa4a; border: 1px solid rgba(255, 170, 74, 0.3); }
  @media (max-width: 640px) {
    .anime-detail-header { flex-direction: column; }
    .anime-detail-cover { width: 120px; margin: 0 auto; }
    .anime-detail-info { text-align: center; }
  }
</style>
