          // 上传图片文件到 GitHub 并在光标处插入 img 标签
          // 编辑器走 JSON + base64，请求体上限约 4.5MB，base64 还会膨胀约 1/3，
          // 所以动图超过 3MB 先在浏览器里重编码压小，避免请求被平台直接拒绝
          var EDITOR_GIF_LIMIT = 3 * 1024 * 1024;
          function uploadImageFile(file, ta, type) {
            if (!file) return;
            showToast('正在处理图片...', 'info');
            // 动图不能走 compressImage（会被转成静态图），超限时用 gifenc 重编码
            var prepared = isGifFile(file) && file.size > EDITOR_GIF_LIMIT
              ? compressGif(file, {
                  maxBytes: EDITOR_GIF_LIMIT,
                  onProgress: (function () {
                    var last = -25;
                    return function (r) {
                      var pct = Math.round(r * 100);
                      if (pct >= last + 25) { last = pct; showToast('正在压缩动图 ' + pct + '%...', 'info'); }
                    };
                  })(),
                }).then(function (r) { return r.file; })
              : compressImage(file);
            prepared.then(function (f) {
              var reader = new FileReader();
              reader.onload = function (ev) {
                var base64 = ev.target.result;
                var b64 = base64.substring(base64.indexOf(',') + 1);
                var ext = (f.type && f.type.split('/')[1]) || f.name.split('.').pop() || 'png';
                var ts = new Date();
                var pad = function (n) { return n < 10 ? '0' + n : '' + n; };
                var rand = Math.random().toString(36).slice(2, 8);
                var filename = ts.getFullYear() + pad(ts.getMonth()+1) + pad(ts.getDate()) + '-' + pad(ts.getHours()) + pad(ts.getMinutes()) + pad(ts.getSeconds()) + '-' + rand + '.' + ext;
                api('/api/admin/upload', {
                  method: 'POST',
                  body: JSON.stringify({ type: type, filename: filename, content: b64 })
                }).then(function (res) {
                  var md = '<img src="' + res.path + '" alt="图片" width="600">\n';
                  insertAtCursor(ta, md);
                  showToast(f !== file ? '图片已压缩并上传成功' : '图片上传成功，可修改 width 调整大小', 'success');
                }).catch(function (err) {
                  showToast('图片上传失败: ' + err.message, 'error');
                });
              };
              reader.readAsDataURL(f);
            });
          }

          // 封面图粘贴：支持截图粘贴和图片链接粘贴
          function handleCoverPaste(e, formKey) {
            var file = pickClipboardImage(e.clipboardData);
            if (!file) return; // 没有图片则走默认文本粘贴（图片链接）
            e.preventDefault();
            var target = formKey === 'fm' ? fm : pfm;
            compressImage(ensureImageMime(file)).then(function (f) {
                var reader = new FileReader();
                reader.onload = function (ev) {
                  var b64 = ev.target.result.substring(ev.target.result.indexOf(',') + 1);
                  var ext = (f.type && f.type.split('/')[1]) || 'png';
                  var ts = new Date();
                  var pad = function (n) { return n < 10 ? '0' + n : '' + n; };
                  var rand = Math.random().toString(36).slice(2, 8);
                  var filename = 'cover-' + ts.getFullYear() + pad(ts.getMonth()+1) + pad(ts.getDate()) + '-' + pad(ts.getHours()) + pad(ts.getMinutes()) + pad(ts.getSeconds()) + '-' + rand + '.' + ext;
                  api('/api/admin/upload', { method: 'POST', body: JSON.stringify({ type: 'post', filename: filename, content: b64 }) })
                    .then(function (res) { target.image = res.path; showToast('封面图已上传', 'success'); })
                    .catch(function (err) { showToast('上传失败: ' + err.message, 'error'); });
                };
                reader.readAsDataURL(f);
              });
          }

          // 从剪贴板挑图片：Win+Shift+S 放标准 image/png 条目；截图吧等工具和资源
          // 管理器复制的图片文件常是 type 为空、只出现在 files 列表或仅靠扩展名可辨，逐层兜底
          var CLIP_IMG_EXT = /\.(png|jpe?g|jpe|jfif|gif|webp|bmp|svg|avif|tiff?|heic|heif|ico)$/i;
          function pickClipboardImage(cd) {
            var items = cd && cd.items ? cd.items : [];
            for (var i = 0; i < items.length; i++) {
              if (items[i].type && items[i].type.indexOf('image/') === 0) {
                var f = items[i].getAsFile();
                if (f) return f;
              }
            }
            var files = cd && cd.files ? cd.files : [];
            for (var j = 0; j < files.length; j++) {
              if (files[j].type && files[j].type.indexOf('image/') === 0) return files[j];
            }
            for (var k = 0; k < files.length; k++) {
              if (CLIP_IMG_EXT.test(files[k].name || '')) return files[k];
            }
            for (var m = 0; m < items.length; m++) {
              if (items[m].kind === 'file') {
                var f2 = items[m].getAsFile();
                if (f2 && CLIP_IMG_EXT.test(f2.name || '')) return f2;
              }
            }
            return null;
          }

          // 文件复制常拿不到 MIME，按扩展名补齐，保证 GIF 不被当成静态图压扁
          function ensureImageMime(file) {
            if (!file || file.type) return file;
            var m = CLIP_IMG_EXT.exec(file.name || '');
            if (!m) return file;
            var map = { png: 'image/png', jpg: 'image/jpeg', jpeg: 'image/jpeg', jpe: 'image/jpeg', jfif: 'image/jpeg', gif: 'image/gif', webp: 'image/webp', bmp: 'image/bmp', svg: 'image/svg+xml', avif: 'image/avif', tif: 'image/png', tiff: 'image/png', heic: 'image/png', heif: 'image/png', ico: 'image/png' };
            return new File([file], file.name || 'image.png', { type: map[m[1].toLowerCase()] });
          }

          function handlePaste(e, type) {
            var cd = e.clipboardData;
            var file = pickClipboardImage(cd);
            if (!file) {
              // 剪贴板有内容但认不出图片：提示实际数据形态，便于反馈排查
              if (cd && ((cd.items && cd.items.length) || (cd.files && cd.files.length))) {
                var desc = [];
                for (var di = 0; di < cd.items.length && desc.length < 4; di++) desc.push(cd.items[di].kind + ':' + (cd.items[di].type || '空'));
                if (cd.files && cd.files.length) desc.push('文件:' + (cd.files[0].name || '无名') + '|' + (cd.files[0].type || '空类型'));
                showToast('未识别到图片（' + desc.join('，') + '）请把本提示截图反馈', 'error');
              }
              return;
            }
            e.preventDefault();
            uploadImageFile(ensureImageMime(file), e.target, type);
          }

          // 处理拖拽上传图片
          function handleDragOver(e) {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'copy';
          }
          function handleDrop(e, type) {
            e.preventDefault();
            var files = e.dataTransfer?.files;
            if (!files || files.length === 0) return;
            // 只处理图片文件
            for (var i = 0; i < files.length; i++) {
              var f = files[i];
              if (f.type.indexOf('image') !== -1) {
                uploadImageFile(f, e.target, type);
              }
            }
          }

          // 将图片路径解析为可访问的 URL（用于预览）
          function resolveImageUrl(imgPath, type) {
            if (!imgPath) return imgPath;
            // 完整 URL 或 /uploads/ 绝对路径直接返回
            if (imgPath.startsWith('http://') || imgPath.startsWith('https://') || imgPath.startsWith('//') || imgPath.startsWith('/uploads/')) {
              return imgPath;
            }
            // ./images/xxx.png → images/xxx.png
            var clean = imgPath.replace(/^\.\//, '');
            var typeDir = { post: 'posts', project: 'projects', dynamic: 'dynamic', spec: 'spec' }[type] || 'posts';
            return 'https://raw.githubusercontent.com/xuehan2007/Firefly/master/src/content/' + typeDir + '/' + clean;
          }

          // 将视频 URL 转换为响应式播放器 HTML，不支持则返回 null
          // 支持：YouTube（watch/youtu.be/embed）、Bilibili（BV/b23.tv）、
          //       直链视频文件（mp4/webm/ogv/mov）
          function buildVideoEmbed(rawUrl) {
            var url = (rawUrl || '').trim();
            var m;
            m = url.match(/^https?:\/\/(?:www\.|m\.)?youtube\.com\/watch\?(?:[^#]*?[?&])?v=([A-Za-z0-9_-]{11})(?:[&#].*)?$/i)
              || url.match(/^https?:\/\/youtu\.be\/([A-Za-z0-9_-]{11})(?:[?#].*)?$/i)
              || url.match(/^https?:\/\/(?:www\.)?youtube\.com\/embed\/([A-Za-z0-9_-]{11})(?:[?#].*)?$/i);
            if (m) {
              return '<div class="video-embed"><iframe loading="lazy" src="https://www.youtube.com/embed/' + m[1]
                + '" title="YouTube video player" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>';
            }
            m = url.match(/^https?:\/\/(?:www\.|m\.)?bilibili\.com\/video\/(BV[A-Za-z0-9]+)\/?(?:\?([^#]*))?(?:#.*)?$/i);
            if (m) {
              var page = '1';
              if (m[2]) {
                var pm = m[2].match(/(?:^|&)p=(\d+)/);
                if (pm) page = pm[1];
              }
              return '<div class="video-embed"><iframe loading="lazy" src="https://player.bilibili.com/player.html?bvid='
                + m[1] + '&page=' + page + '&autoplay=0" title="Bilibili video player" scrolling="no" allowfullscreen></iframe></div>';
            }
            m = url.match(/^https?:\/\/b23\.tv\/(BV[A-Za-z0-9]+)(?:[?#].*)?$/i);
            if (m) {
              return '<div class="video-embed"><iframe loading="lazy" src="https://player.bilibili.com/player.html?bvid='
                + m[1] + '&autoplay=0" title="Bilibili video player" scrolling="no" allowfullscreen></iframe></div>';
            }
            if (/\.(mp4|webm|ogv|mov)(?:[?#].*)?$/i.test(url)) {
              return '<div class="video-embed"><video controls preload="metadata" src="' + url + '"></video></div>';
            }
            return null;
          }

          // 将单独成段的视频链接替换为播放器（marked 会把裸 URL 自动包成 <a>）
          function embedVideoLinks(html) {
            // <p><a href="url">url</a></p>，链接文字必须与地址一致
            html = html.replace(/<p>\s*<a href="([^"]+)">([^<]+)<\/a>\s*<\/p>/g, function (whole, href, text) {
              var url = href.replace(/&amp;/g, '&');
              if (text.replace(/&amp;/g, '&').trim() !== url) return whole;
              return buildVideoEmbed(url) || whole;
            });
            // 兜底：<p>https://裸链接</p>
            html = html.replace(/<p>\s*(https?:\/\/[^\s<]+?)\s*<\/p>/g, function (whole, url) {
              return buildVideoEmbed(url.replace(/&amp;/g, '&')) || whole;
            });
            return html;
          }

          // 将提醒框语法 > [!NOTE] 转为带样式的 div
          function renderCallouts(html) {
            var typeMap = {
              NOTE: { cls: 'callout-note', icon: 'ℹ️', label: '笔记' },
              TIP: { cls: 'callout-tip', icon: '💡', label: '技巧' },
              IMPORTANT: { cls: 'callout-important', icon: '⚠️', label: '重要' },
              WARNING: { cls: 'callout-warning', icon: '⚠️', label: '警告' },
              CAUTION: { cls: 'callout-caution', icon: '🔴', label: '谨慎' },
              ABSTRACT: { cls: 'callout-note', icon: '📋', label: '摘要' },
              INFO: { cls: 'callout-note', icon: 'ℹ️', label: '信息' },
              TODO: { cls: 'callout-note', icon: '☑️', label: '待办' },
              SUCCESS: { cls: 'callout-tip', icon: '✅', label: '成功' },
              QUESTION: { cls: 'callout-note', icon: '❓', label: '问题' },
              FAILURE: { cls: 'callout-warning', icon: '❌', label: '失败' },
              DANGER: { cls: 'callout-caution', icon: '🔴', label: '危险' },
              EXAMPLE: { cls: 'callout-note', icon: '📝', label: '示例' },
              QUOTE: { cls: 'callout-note', icon: '💬', label: '引用' }
            };
            // marked 输出: <blockquote><p>[!TYPE] 标题\n内容</p></blockquote>
            html = html.replace(/<blockquote>\s*<p>\[!(\w+)\]([^\n]*)\n?([\s\S]*?)<\/p>\s*<\/blockquote>/g, function (m, type, title, body) {
              var t = type.toUpperCase();
              var info = typeMap[t] || typeMap.NOTE;
              var titleText = title.trim();
              if (!titleText) titleText = info.label;
              var content = body.trim();
              return '<div class="callout ' + info.cls + '">' +
                '<div style="font-weight:600;margin-bottom:4px">' + info.icon + ' ' + titleText + '</div>' +
                '<div>' + content + '</div></div>';
            });
            return html;
          }

          // 将 GitHub 卡片语法 ::github{repo="user/repo"} 转为链接
          function renderGithubCards(html) {
            return html.replace(/::github\{repo=(?:"|&quot;)([^"&]+)(?:"|&quot;)\}/g, function (m, repo) {
              return '<a href="https://github.com/' + repo + '" target="_blank" style="display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:8px;background:rgba(0,0,0,0.2);border:1px solid rgba(255,255,255,0.1);text-decoration:none;color:var(--accent)">' +
                '<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>' +
                '<b>' + repo + '</b></a>';
            });
          }

          // 将剧透语法 :spoiler[内容] 转为可点击的剧透文本
          function renderSpoilers(html) {
            return html.replace(/:spoiler\[([^\]]+)\]/g, function (m, content) {
              return '<span style="background:currentColor;color:transparent;border-radius:3px;padding:1px 6px;cursor:pointer" onclick="this.style.background=\'transparent\';this.style.color=\'inherit\'" title="点击显示">' + content + '</span>';
            });
          }

          // 将 Wiki 链接 [[slug]] 或 [[slug|text]] 转为文章链接
          function renderWikiLinks(html) {
            return html.replace(/\[\[([^\]|]+)(?:\|([^\]]+))?\]\]/g, function (m, slug, text) {
              var label = text || slug;
              return '<a href="/posts/' + slug + '/" style="color:var(--accent)">' + label + '</a>';
            });
          }

          // 将图片网格 [grid]...[/grid] 转为网格布局
          function renderGrid(html) {
            return html.replace(/\[grid\]([\s\S]*?)\[\/grid\]/g, function (m, content) {
              var imgs = content.match(/<img[^>]+>/g) || [];
              var gridHtml = '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px;margin:12px 0">';
              imgs.forEach(function (img) {
                gridHtml += '<div style="overflow:hidden;border-radius:8px">' + img + '</div>';
              });
              gridHtml += '</div>';
              return gridHtml;
            });
          }

          // 渲染 markdown 为 HTML（用于预览）
          function renderMarkdown(md, type) {
            if (!md) return '';
            var html = marked.parse(md);
            // 将相对图片路径替换为可访问的 URL
            html = html.replace(/<img\s+src="([^"]+)"/g, function (m, src) {
              return '<img src="' + resolveImageUrl(src, type) + '"';
            });
            // 图片网格
            html = renderGrid(html);
            // 提醒框
            html = renderCallouts(html);
            // GitHub 卡片
            html = renderGithubCards(html);
            // 剧透
            html = renderSpoilers(html);
            // Wiki 链接
            html = renderWikiLinks(html);
            // 单独成行的视频链接自动转为播放器
            html = embedVideoLinks(html);
            return html;
          }

          // 从 markdown 中提取所有本地图片路径（用于同步删除检测）
          function extractLocalImages(md) {
            var urls = new Set();
            // 匹配 markdown 图片语法 ![alt](url)
            var re = /!\[[^\]]*\]\(([^)]+)\)/g;
            var m;
            while ((m = re.exec(md)) !== null) {
              var url = m[1].trim();
              if (url.startsWith('./') || url.startsWith('images/') || url.startsWith('/uploads/')) {
                urls.add(url.replace(/^\.\//, ''));
              }
            }
            // 匹配 HTML img 标签 <img src="url">
            var imgRe = /<img\s+[^>]*src=["']([^"']+)["']/gi;
            var im;
            while ((im = imgRe.exec(md)) !== null) {
              var iurl = im[1].trim();
              if (iurl.startsWith('./') || iurl.startsWith('images/') || iurl.startsWith('/uploads/')) {
                urls.add(iurl.replace(/^\.\//, ''));
              }
            }
            return urls;
          }

          // 同步删除不再引用的图片
          function syncDeletedImages(oldMd, newMd, type) {
            var oldImgs = extractLocalImages(oldMd);
            var newImgs = extractLocalImages(newMd);
            var deleted = [];
            oldImgs.forEach(function (img) {
              if (!newImgs.has(img)) deleted.push(img);
            });
            if (deleted.length === 0) return Promise.resolve();
            var typeDir = { post: 'posts', project: 'projects', dynamic: 'dynamic', spec: 'spec' }[type] || 'posts';
            return Promise.all(deleted.map(function (img) {
              // /uploads/xxx → public/uploads/xxx；images/xxx → src/content/{type}/images/xxx
              var imgPath;
              if (img.startsWith('/uploads/')) {
                imgPath = 'public' + img;
              } else {
                imgPath = 'src/content/' + typeDir + '/' + img;
              }
              return api('/api/admin/upload', {
                method: 'DELETE',
                body: JSON.stringify({ path: imgPath })
              }).catch(function () {}); // 忽略删除失败
            })).then(function () {
              if (deleted.length > 0) {
                showToast('已清理 ' + deleted.length + ' 张废弃图片', 'success');
              }
            });
          }

          function loadStats() {
            return api('/api/admin/stats').then(function (d) { stats.value = d; }).catch(function () {});
          }

          function loadPosts() {
            page.value = 'posts';
            loadingPosts.value = true;
            api('/api/admin/posts').then(function (list) {
              posts.value = list;
              stats.value = {
                totalPosts: list.length,
                published: list.filter(function (p) { return !p.draft; }).length,
                drafts: list.filter(function (p) { return p.draft; }).length,
                pinned: list.filter(function (p) { return p.pinned; }).length
              };
            }).catch(function (e) { showToast(e.message, 'error'); })
              .finally(function () { loadingPosts.value = false; });
          }

          // 分类/标签下拉选择：从文章列表汇总已有分类与标签，按使用次数降序
          var taxMenu = ref(''); // '' | 'category' | 'tags'
          function ensurePostsLoaded() {
            if (posts.value.length > 0) return;
            api('/api/admin/posts').then(function (list) { posts.value = list; }).catch(function () {});
          }
          function toggleTaxMenu(name) {
            taxMenu.value = taxMenu.value === name ? '' : name;
            if (taxMenu.value) ensurePostsLoaded();
          }
          var existingCategories = computed(function () {
            var counts = {};
            posts.value.forEach(function (p) {
              if (p.category) counts[p.category] = (counts[p.category] || 0) + 1;
            });
            return Object.keys(counts)
              .map(function (name) { return { name: name, count: counts[name] }; })
              .sort(function (a, b) { return b.count - a.count; });
          });
          var existingTags = computed(function () {
            var counts = {};
            posts.value.forEach(function (p) {
              (p.tags || []).forEach(function (t) { if (t) counts[t] = (counts[t] || 0) + 1; });
            });
            return Object.keys(counts)
              .map(function (name) { return { name: name, count: counts[name] }; })
              .sort(function (a, b) { return b.count - a.count; });
          });
          function pickCategory(c) { fm.category = c; taxMenu.value = ''; }
          function pickTag(t) {
            var parts = fm.tagsStr ? fm.tagsStr.split(',').map(function (s) { return s.trim(); }).filter(Boolean) : [];
            if (parts.indexOf(t) === -1) parts.push(t);
            fm.tagsStr = parts.join(', ');
            taxMenu.value = '';
          }

          function newPost() {
            editingFilename.value = '';
            editingSha.value = '';
            editingOriginalContent.value = '';
            ensurePostsLoaded();
            Object.assign(fm, { title: '', published: new Date().toISOString().slice(0, 10), description: '', category: '随笔', image: '', slug: '', password: '', draft: false, pinned: false, tagsStr: '' });
            body.value = '';
            originalBody.value = '';
            restoreDraft('post', function (d) { if (d.fm) Object.assign(fm, d.fm); body.value = d.body || ''; });
            page.value = 'editor';
          }

          function editPost(row) {
            ensurePostsLoaded();
            api('/api/admin/post/' + encodeURIComponent(row.filename)).then(function (data) {
              editingFilename.value = data.filename;
              editingSha.value = data.sha;
              editingOriginalContent.value = data.content;
              var match = data.content.match(/^---\s*\n([\s\S]*?)\n---\s*\n?([\s\S]*)$/);
              var fmData = {};
              if (match) {
                match[1].split('\n').forEach(function (line) {
                  var m = line.match(/^(\w+):\s*(.*)$/);
                  if (m) {
                    var v = m[2].trim();
                    if (v.charAt(0) === '[' && v.charAt(v.length - 1) === ']') v = v.slice(1, -1).split(',').map(function (s) { return parseYamlScalar(s); });
                    else if (v !== '') v = parseYamlScalar(v);
                    if (v === 'true') v = true;
                    if (v === 'false') v = false;
                    fmData[m[1]] = v;
