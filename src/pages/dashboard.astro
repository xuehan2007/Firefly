          // ===== 编辑器快捷键 =====
          // 在 textarea 指定位置插入文本，并触发 input 事件让 Vue v-model 同步
          function insertAtTextarea(ta, text) {
            var type = mdTypeOf(ta);
            if (type) { mdSeal(type); mdProgrammatic = true; }
            var start = ta.selectionStart;
            var end = ta.selectionEnd;
            ta.value = ta.value.slice(0, start) + text + ta.value.slice(end);
            ta.dispatchEvent(new Event('input', { bubbles: true }));
            if (type) mdProgrammatic = false;
            ta.focus();
            var pos = start + text.length;
            ta.setSelectionRange(pos, pos);
          }
          // 用前后缀包裹选中内容（无选中时使用占位文字并选中它）
          function wrapTextarea(ta, before, after, placeholder) {
            var type = mdTypeOf(ta);
            if (type) { mdSeal(type); mdProgrammatic = true; }
            var start = ta.selectionStart;
            var end = ta.selectionEnd;
            var sel = ta.value.slice(start, end) || placeholder;
            var mid = before + sel + after;
            ta.value = ta.value.slice(0, start) + mid + ta.value.slice(end);
            ta.dispatchEvent(new Event('input', { bubbles: true }));
            if (type) mdProgrammatic = false;
            ta.focus();
            ta.setSelectionRange(start + before.length, start + before.length + sel.length);
          }

          window.addEventListener('keydown', function (e) {
            var ta = (e.target && e.target.classList && e.target.classList.contains('md-editor')) ? e.target : null;
            var mod = e.ctrlKey || e.metaKey;
            var key = e.key.toLowerCase();

            // Tab：缩进两个空格（不跳出输入框）
            if (ta && e.key === 'Tab' && !mod && !e.altKey) {
              e.preventDefault();
              insertAtTextarea(ta, '  ');
              return;
            }
            if (!mod || e.altKey) return;

            // Ctrl/Cmd+Z 撤销、Ctrl/Cmd+Shift+Z 或 Ctrl/Cmd+Y 重做（编辑器自建历史栈）
            if (ta && (key === 'z' || key === 'y')) {
              var mdType = mdTypeOf(ta);
              if (mdType && ((key === 'y' || e.shiftKey) ? mdRedo(mdType) : mdUndo(mdType))) {
                e.preventDefault();
                return;
              }
            }

            // Ctrl/Cmd+B/I/K：只在编辑器内生效
            if (ta && (key === 'b' || key === 'i' || key === 'k')) {
              e.preventDefault();
              if (key === 'b') wrapTextarea(ta, '**', '**', '粗体文字');
              if (key === 'i') wrapTextarea(ta, '*', '*', '斜体文字');
              if (key === 'k') {
                var linkUrl = prompt('输入链接地址：', 'https://');
                if (linkUrl) wrapTextarea(ta, '[', '](' + linkUrl + ')', '链接文字');
              }
              return;
            }

            // Ctrl/Cmd+S：按当前编辑器页面保存
            if (key === 's') {
              var p = page.value;
              if (p === 'editor') { e.preventDefault(); savePost(); }
              else if (p === 'project-editor') { e.preventDefault(); saveProject(); }
