---
const appHtml = '<div id="app">' +
    '<div v-if="!token" class="login-wrap">' +
      '<div class="login-card">' +
        '<div class="login-logo">🐝</div>' +
        '<div class="login-title">博客管理后台</div>' +
        '<div class="login-sub">鹅鹅鹅123的博客 · 内容管理中心</div>' +
        '<input v-model="password" type="password" placeholder="请输入管理员密码" class="login-input" @keyup.enter="login" />' +
        '<button class="login-btn" @click="login" :disabled="logging" v-text="logging ? \'登录中...\' : \'登 录\'"></button>' +
      '</div>' +
    '</div>' +
    '<div v-else class="layout">' +
      '<div class="sidebar">' +
        '<div class="sidebar-logo">🐝 管理后台</div>' +
        '<div class="sidebar-menu">' +
          '<div class="menu-item" :class="{active: page===\'dashboard\'}" @click="page=\'dashboard\'; loadStats()">' +
            '<el-icon><Monitor /></el-icon> 仪表盘' +
          '</div>' +
          '<div class="menu-item" :class="{active: page===\'posts\'}" @click="loadPosts">' +
            '<el-icon><Document /></el-icon> 博客文章' +
          '</div>' +
          '<div class="menu-item" @click="goBlog">' +
            '<el-icon><Link /></el-icon> 查看博客' +
          '</div>' +
        '</div>' +
        '<div class="sidebar-footer">' +
          '<el-button size="small" text @click="logout" style="color:var(--sidebar-text-dim)">退出登录</el-button>' +
        '</div>' +
      '</div>' +
      '<div class="main">' +
        '<div class="header">' +
          '<div class="header-title" v-text="pageTitle"></div>' +
          '<div><el-button type="primary" @click="newPost" v-if="page===\'posts\'">+ 新建文章</el-button></div>' +
        '</div>' +
        '<div class="content">' +
          '<div v-if="page===\'dashboard\'">' +
            '<el-alert title="欢迎回来，这里是你的博客管理中心。" type="info" :closable="false" style="margin-bottom:24px; border-radius:8px"></el-alert>' +
            '<div class="stat-grid">' +
              '<div class="mica-card stat-card"><div class="stat-icon">📄</div><div class="stat-info"><div class="label">博客文章</div><div class="value" v-text="stats.totalPosts || 0"></div></div></div>' +
              '<div class="mica-card stat-card"><div class="stat-icon">✅</div><div class="stat-info"><div class="label">已发布</div><div class="value" v-text="stats.published || 0"></div></div></div>' +
              '<div class="mica-card stat-card"><div class="stat-icon">✏️</div><div class="stat-info"><div class="label">草稿</div><div class="value" v-text="stats.drafts || 0"></div></div></div>' +
              '<div class="mica-card stat-card"><div class="stat-icon">📌</div><div class="stat-info"><div class="label">置顶</div><div class="value" v-text="stats.pinned || 0"></div></div></div>' +
            '</div>' +
            '<h3 style="margin-bottom:16px; font-weight:600">快捷操作</h3>' +
            '<div class="quick-grid">' +
              '<div class="mica-card quick-card" @click="newPost"><h4>✏️ 写新文章</h4><p>创建一篇新的博客文章</p></div>' +
              '<div class="mica-card quick-card" @click="loadPosts"><h4>📚 文章管理</h4><p>查看、编辑、删除所有文章</p></div>' +
              '<div class="mica-card quick-card" @click="goBlog"><h4>🌐 查看博客</h4><p>打开博客前台页面</p></div>' +
              '<div class="mica-card quick-card" @click="loadStats"><h4>📊 刷新数据</h4><p>重新加载统计数据</p></div>' +
            '</div>' +
          '</div>' +
          '<div v-if="page===\'posts\'">' +
            '<div class="mica-card" style="padding:4px">' +
              '<el-table :data="posts" v-loading="loadingPosts" stripe style="width:100%">' +
                '<el-table-column prop="title" label="标题" min-width="240"></el-table-column>' +
                '<el-table-column prop="category" label="分类" width="120"></el-table-column>' +
                '<el-table-column prop="published" label="发布日期" width="140"></el-table-column>' +
                '<el-table-column label="状态" width="100"><template #default="{row}"><el-tag v-if="row.draft" type="info" size="small" effect="plain">草稿</el-tag><el-tag v-else type="success" size="small" effect="plain">已发布</el-tag></template></el-table-column>' +
                '<el-table-column label="置顶" width="80"><template #default="{row}"><el-tag v-if="row.pinned" type="warning" size="small" effect="plain">置顶</el-tag></template></el-table-column>' +
                '<el-table-column label="操作" width="180" fixed="right"><template #default="{row}"><el-button size="small" @click="editPost(row)">编辑</el-button><el-button size="small" type="danger" @click="deletePost(row)">删除</el-button></template></el-table-column>' +
              '</el-table>' +
            '</div>' +
          '</div>' +
          '<div v-if="page===\'editor\'">' +
            '<div class="editor-toolbar">' +
              '<el-button @click="page=\'posts\'">← 返回列表</el-button>' +
              '<el-button type="primary" @click="savePost" :loading="saving">保存文章</el-button>' +
              '<span style="color:var(--text-secondary); font-size:13px; margin-left:auto">保存后将自动写入 GitHub 并触发博客重新部署</span>' +
            '</div>' +
            '<el-card style="margin-bottom:20px"><template #header><strong>📋 文章信息</strong></template>' +
              '<div class="fm-grid">' +
                '<div class="fm-item"><label>标题</label><el-input v-model="fm.title" placeholder="文章标题"></el-input></div>' +
                '<div class="fm-item"><label>分类</label><el-input v-model="fm.category" placeholder="如：随笔、技术"></el-input></div>' +
                '<div class="fm-item"><label>发布日期</label><el-date-picker v-model="fm.published" type="date" value-format="YYYY-MM-DD" style="width:100%"></el-date-picker></div>' +
                '<div class="fm-item"><label>标签（逗号分隔）</label><el-input v-model="fm.tagsStr" placeholder="如：Vue, JavaScript"></el-input></div>' +
                '<div class="fm-item" style="grid-column: span 2"><label>描述</label><el-input v-model="fm.description" type="textarea" :rows="2" placeholder="文章摘要"></el-input></div>' +
                '<div class="fm-item"><label>封面图</label><el-input v-model="fm.image" placeholder="图片路径或 URL"></el-input></div>' +
                '<div class="fm-item"><label>slug</label><el-input v-model="fm.slug" placeholder="URL 别名"></el-input></div>' +
                '<div class="fm-item"><label>选项</label><el-checkbox v-model="fm.draft">草稿</el-checkbox><el-checkbox v-model="fm.pinned">置顶</el-checkbox></div>' +
              '</div>' +
            '</el-card>' +
            '<el-card><template #header><strong>✍️ 正文内容（Markdown）</strong></template>' +
              '<textarea class="md-editor" v-model="body" placeholder="在这里写 Markdown 内容..."></textarea>' +
            '</el-card>' +
          '</div>' +
        '</div>' +
      '</div>' +
    '</div>' +
  '</div>';
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>博客管理后台</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/element-plus/dist/index.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@element-plus/icons-vue/dist/index.css" />
  <style>
    :root {
      --mica-border: rgba(0, 0, 0, 0.08);
      --mica-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
      --mica-shadow-hover: 0 12px 40px rgba(0, 0, 0, 0.15);
      --accent: #0067c0;
      --accent-light: #e8f0fe;
      --text-primary: #1f1f1f;
      --text-secondary: #616161;
      --sidebar-bg: rgba(32, 32, 32, 0.92);
      --sidebar-text: #ffffff;
      --sidebar-text-dim: rgba(255, 255, 255, 0.6);
      --mica-surface: rgba(255, 255, 255, 0.7);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { height: 100%; width: 100%; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei', Roboto, sans-serif !important;
      background: linear-gradient(135deg, #e3f2fd 0%, #f3e5f5 50%, #e8f5e9 100%) !important;
      background-attachment: fixed !important;
      color: var(--text-primary) !important;
    }
    #app { min-height: 100vh; }
    .login-wrap { min-height: 100vh; display: flex; align-items: center; justify-content: center; background-image: url('https://t.alcy.cc/pc'); background-size: cover; background-position: center; position: relative; }
    .login-wrap::before { content: ''; position: absolute; inset: 0; background: rgba(0, 0, 0, 0.35); }
    .login-card { width: 420px; padding: 48px 40px; background: rgba(30, 30, 30, 0.55); backdrop-filter: blur(30px) saturate(180%); -webkit-backdrop-filter: blur(30px) saturate(180%); border-radius: 16px; border: 1px solid rgba(255, 255, 255, 0.15); box-shadow: 0 24px 64px rgba(0, 0, 0, 0.4); position: relative; z-index: 1; }
    .login-logo { text-align: center; font-size: 48px; margin-bottom: 16px; }
    .login-title { text-align: center; font-size: 24px; font-weight: 600; margin-bottom: 8px; color: #fff; }
    .login-sub { text-align: center; color: rgba(255, 255, 255, 0.7); font-size: 14px; margin-bottom: 32px; }
    .login-input { width: 100%; height: 48px; padding: 0 16px; font-size: 15px; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.2); background: rgba(255, 255, 255, 0.95); color: #333; margin-bottom: 16px; box-sizing: border-box; outline: none; transition: all 0.2s; }
    .login-input:focus { border-color: #0067c0; box-shadow: 0 0 0 3px rgba(0, 103, 192, 0.2); }
    .login-input::placeholder { color: #999; }
    .login-btn { width: 100%; height: 48px; font-size: 16px; font-weight: 600; color: #fff; background: #0067c0; border: none; border-radius: 8px; cursor: pointer; transition: all 0.2s; letter-spacing: 4px; }
    .login-btn:hover:not(:disabled) { background: #1a78d0; }
    .login-btn:disabled { opacity: 0.6; cursor: not-allowed; }
    .layout { display: flex; min-height: 100vh; }
    .sidebar { width: 240px; background: var(--sidebar-bg); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); color: var(--sidebar-text); display: flex; flex-direction: column; border-right: 1px solid rgba(255, 255, 255, 0.1); }
    .sidebar-logo { height: 64px; display: flex; align-items: center; gap: 12px; padding: 0 24px; font-size: 18px; font-weight: 600; border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
    .sidebar-menu { flex: 1; padding: 16px 12px; }
    .menu-item { padding: 12px 16px; margin-bottom: 4px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; gap: 12px; transition: all 0.2s ease; color: var(--sidebar-text-dim); font-size: 14px; }
    .menu-item:hover { background: rgba(255, 255, 255, 0.08); color: var(--sidebar-text); }
    .menu-item.active { background: var(--accent); color: #fff; }
    .sidebar-footer { padding: 16px; border-top: 1px solid rgba(255, 255, 255, 0.08); }
    .main { flex: 1; display: flex; flex-direction: column; min-width: 0; }
    .header { height: 64px; background: var(--mica-surface); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border-bottom: 1px solid var(--mica-border); display: flex; align-items: center; justify-content: space-between; padding: 0 28px; }
    .header-title { font-size: 18px; font-weight: 600; }
    .content { flex: 1; padding: 28px; overflow-y: auto; }
    .mica-card { background: var(--mica-surface); backdrop-filter: blur(20px) saturate(180%); -webkit-backdrop-filter: blur(20px) saturate(180%); border-radius: 12px; border: 1px solid var(--mica-border); box-shadow: var(--mica-shadow); transition: all 0.2s ease; }
    .mica-card:hover { box-shadow: var(--mica-shadow-hover); }
    .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 24px; }
    .stat-card { padding: 24px; display: flex; align-items: center; gap: 20px; }
    .stat-icon { width: 56px; height: 56px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 28px; background: var(--accent-light); color: var(--accent); }
    .stat-info .label { font-size: 13px; color: var(--text-secondary); margin-bottom: 4px; }
    .stat-info .value { font-size: 28px; font-weight: 700; }
    .quick-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; }
    .quick-card { padding: 24px; cursor: pointer; }
    .quick-card:hover { transform: translateY(-2px); }
    .quick-card h4 { font-size: 16px; margin-bottom: 8px; display: flex; align-items: center; gap: 8px; }
    .quick-card p { color: var(--text-secondary); font-size: 13px; }
    .editor-toolbar { display: flex; gap: 12px; margin-bottom: 20px; align-items: center; flex-wrap: wrap; }
    .md-editor { width: 100%; min-height: 500px; padding: 20px; font-family: 'Cascadia Code', 'Consolas', 'Monaco', monospace; font-size: 14px; background: rgba(255, 255, 255, 0.6); border: 1px solid var(--mica-border); border-radius: 8px; resize: vertical; line-height: 1.7; color: var(--text-primary); }
    .md-editor:focus { outline: none; border-color: var(--accent); background: rgba(255, 255, 255, 0.8); }
    .fm-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 20px; }
    .fm-item label { display: block; font-size: 13px; color: var(--text-secondary); margin-bottom: 6px; font-weight: 500; }
    .el-card { background: var(--mica-surface) !important; backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border-radius: 12px !important; border: 1px solid var(--mica-border) !important; }
    .el-table { background: transparent !important; border-radius: 12px; overflow: hidden; }
    .el-table tr { background: transparent !important; }
    .el-table th.el-table__cell { background: rgba(0, 0, 0, 0.03) !important; color: var(--text-secondary) !important; font-weight: 600; }
    .el-table td.el-table__cell { border-bottom: 1px solid var(--mica-border) !important; }
    .el-table--enable-row-hover .el-table__body tr:hover > td { background: var(--accent-light) !important; }
    .el-button--primary { background: var(--accent) !important; border-color: var(--accent) !important; }
    .el-input__wrapper, .el-textarea__inner { background: rgba(255, 255, 255, 0.6) !important; box-shadow: 0 0 0 1px var(--mica-border) inset !important; }
    .el-input__wrapper:hover, .el-textarea__inner:hover { box-shadow: 0 0 0 1px var(--accent) inset !important; }
    .el-message-box { border-radius: 12px !important; }
  </style>
</head>
<body>
  <Fragment set:html={appHtml} />
  <script src="https://cdn.jsdelivr.net/npm/vue@3/dist/vue.global.prod.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/element-plus"></script>
  <script src="https://cdn.jsdelivr.net/npm/@element-plus/icons-vue"></script>
  <script is:inline>
    (function() {
      var Vue = window.Vue;
      var ElementPlus = window.ElementPlus;
      var ElementPlusIconsVue = window.ElementPlusIconsVue;
      if (!Vue) { console.error('Vue not loaded'); return; }
      var createApp = Vue.createApp, ref = Vue.ref, reactive = Vue.reactive, computed = Vue.computed, onMounted = Vue.onMounted;
      var app = createApp({
        setup: function() {
          var token = ref(localStorage.getItem('admin_token') || '');
          var password = ref('');
          var logging = ref(false);
          var page = ref('dashboard');
          var posts = ref([]);
          var loadingPosts = ref(false);
          var saving = ref(false);
          var stats = ref({});
          var editingFilename = ref('');
          var editingSha = ref('');
          var fm = reactive({ title: '', published: '', description: '', category: '', image: '', slug: '', draft: false, pinned: false, tagsStr: '' });
          var body = ref('');
          var pageTitle = computed(function() { return { dashboard: '仪表盘', posts: '文章管理', editor: '编辑文章' }[page.value] || '管理后台'; });
          function login() {
            logging.value = true;
            fetch('/api/admin/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ password: password.value }) })
              .then(function(res) { return res.json().then(function(data) { return { res: res, data: data }; }); })
              .then(function(result) {
                if (result.res.ok) { token.value = result.data.token; localStorage.setItem('admin_token', result.data.token); password.value = ''; loadStats(); }
                else { ElementPlus.ElMessage.error(result.data.error || '登录失败'); }
              })
              .catch(function() { ElementPlus.ElMessage.error('网络错误'); })
              .finally(function() { logging.value = false; });
          }
          function logout() { token.value = ''; localStorage.removeItem('admin_token'); }
          function api(url, options) {
            options = options || {};
            var headers = { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token.value };
            if (options.headers) { for (var k in options.headers) headers[k] = options.headers[k]; }
            return fetch(url, Object.assign({}, options, { headers: headers }))
              .then(function(res) { return res.json().catch(function() { return {}; }).then(function(data) {
                if (res.status === 401) { logout(); ElementPlus.ElMessage.error('登录已过期，请重新登录'); }
                if (!res.ok) throw new Error(data.error || '请求失败 (' + res.status + ')');
                return data;
              }); });
          }
          function loadStats() { return api('/api/admin/stats').then(function(d) { stats.value = d; }).catch(function() {}); }
          function loadPosts() {
            page.value = 'posts'; loadingPosts.value = true;
            api('/api/admin/posts').then(function(list) {
              posts.value = list;
              stats.value = { totalPosts: list.length, published: list.filter(function(p) { return !p.draft; }).length, drafts: list.filter(function(p) { return p.draft; }).length, pinned: list.filter(function(p) { return p.pinned; }).length };
            }).catch(function(e) { ElementPlus.ElMessage.error(e.message); })
              .finally(function() { loadingPosts.value = false; });
          }
          function newPost() {
            editingFilename.value = ''; editingSha.value = '';
            Object.assign(fm, { title: '', published: new Date().toISOString().slice(0,10), description: '', category: '随笔', image: '', slug: '', draft: false, pinned: false, tagsStr: '' });
            body.value = ''; page.value = 'editor';
          }
          function editPost(row) {
            api('/api/admin/post/' + encodeURIComponent(row.filename)).then(function(data) {
              editingFilename.value = data.filename; editingSha.value = data.sha;
              var match = data.content.match(/^---\s*\n([\s\S]*?)\n---\s*\n?([\s\S]*)$/);
              var fmData = {};
              if (match) {
                match[1].split('\n').forEach(function(line) {
                  var m = line.match(/^(\w+):\s*(.*)$/);
                  if (m) {
                    var v = m[2].trim();
                    if (v.charAt(0) === '[' && v.charAt(v.length-1) === ']') v = v.slice(1,-1).split(',').map(function(s) { return s.trim().replace(/^["']|["']$/g,''); });
                    if (v === 'true') v = true; if (v === 'false') v = false;
                    fmData[m[1]] = v;
                  }
                });
                body.value = match[2];
              } else { body.value = data.content; }
              Object.assign(fm, { title: fmData.title || '', published: fmData.published || '', description: fmData.description || '', category: fmData.category || '', image: fmData.image || '', slug: fmData.slug || '', draft: fmData.draft === true, pinned: fmData.pinned === true, tagsStr: Array.isArray(fmData.tags) ? fmData.tags.join(', ') : '' });
              page.value = 'editor';
            }).catch(function(e) { ElementPlus.ElMessage.error(e.message); });
          }
          function deletePost(row) {
            ElementPlus.ElMessageBox.confirm('确定删除文章「' + row.title + '」吗？', '确认删除', { type: 'warning', confirmButtonText: '删除', cancelButtonText: '取消' })
              .then(function() { return api('/api/admin/post/' + encodeURIComponent(row.filename), { method: 'DELETE', body: JSON.stringify({ sha: row.sha }) }); })
              .then(function() { ElementPlus.ElMessage.success('删除成功'); loadPosts(); })
              .catch(function(e) { if (e !== 'cancel') ElementPlus.ElMessage.error(e.message); });
          }
          function savePost() {
            if (!fm.title) { ElementPlus.ElMessage.warning('请填写标题'); return; }
            saving.value = true;
            var tags = fm.tagsStr ? fm.tagsStr.split(',').map(function(s) { return s.trim(); }).filter(Boolean) : [];
            var fmStr = '---\n';
            fmStr += 'title: ' + fm.title + '\n';
            fmStr += 'published: ' + fm.published + '\n';
            if (fm.description) fmStr += 'description: ' + fm.description + '\n';
            if (tags.length) fmStr += 'tags: [' + tags.map(function(t) { return '"' + t + '"'; }).join(', ') + ']\n';
            if (fm.category) fmStr += 'category: ' + fm.category + '\n';
            if (fm.image) fmStr += 'image: ' + fm.image + '\n';
            if (fm.slug) fmStr += 'slug: ' + fm.slug + '\n';
            if (fm.draft) fmStr += 'draft: true\n';
            if (fm.pinned) fmStr += 'pinned: true\n';
            fmStr += '---\n';
            var content = fmStr + body.value;
            var filename = editingFilename.value;
            if (!filename) {
              var slug = fm.slug || fm.title.toLowerCase().replace(/\s+/g, '-').replace(/[^\w\u4e00-\u9fa5-]/g, '');
              filename = (fm.published || new Date().toISOString().slice(0,10)) + '-' + slug + '.md';
            }
            var p;
            if (editingSha.value) { p = api('/api/admin/post/' + encodeURIComponent(filename), { method: 'PUT', body: JSON.stringify({ content: content, sha: editingSha.value }) }); }
            else { p = api('/api/admin/posts', { method: 'POST', body: JSON.stringify({ filename: filename, content: content }) }); }
            p.then(function() { ElementPlus.ElMessage.success('保存成功！Vercel 将自动重新部署博客。'); setTimeout(function() { loadPosts(); }, 1200); })
              .catch(function(e) { ElementPlus.ElMessage.error(e.message); })
              .finally(function() { saving.value = false; });
          }
          function goBlog() { window.open('/', '_blank'); }
          onMounted(function() { if (token.value) loadStats(); });
          return { token: token, password: password, logging: logging, login: login, logout: logout, page: page, pageTitle: pageTitle, posts: posts, loadingPosts: loadingPosts, stats: stats, loadStats: loadStats, loadPosts: loadPosts, fm: fm, body: body, saving: saving, newPost: newPost, editPost: editPost, deletePost: deletePost, savePost: savePost, goBlog: goBlog };
        }
      });
      app.use(ElementPlus);
      for (var key in ElementPlusIconsVue) { app.component(key, ElementPlusIconsVue[key]); }
      app.mount('#app');
    })();
  </script>
</body>
