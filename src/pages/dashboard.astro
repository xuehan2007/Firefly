    try {
      var app = createApp({
        template: template,
        setup: function () {
          var token = ref(localStorage.getItem('admin_token') || '');
          var password = ref('');
          var logging = ref(false);
          var page = ref('dashboard');
          var posts = ref([]);
          var loadingPosts = ref(false);
          var saving = ref(false);
          var stats = ref({});
          var editingFilename = ref('');
          var editingSha = ref('');
          var fm = reactive({ title: '', published: '', description: '', category: '', image: '', slug: '', draft: false, pinned: false, tagsStr: '' });
          var body = ref('');
          // 项目管理
          var projects = ref([]);
          var loadingProjects = ref(false);
          var pfm = reactive({ title: '', slug: '', published: '', status: 'planning', order: '', description: '', image: '', draft: false, tagsStr: '', linksStr: '' });
          var pbody = ref('');
          var editingProjectFilename = ref('');
          var editingProjectSha = ref('');
          // 动态管理
          var dynamics = ref([]);
          var loadingDynamics = ref(false);
          var dfm = reactive({ published: '' });
          var dbody = ref('');
          var editingDynamicFilename = ref('');
          var editingDynamicSha = ref('');
          // 音乐管理
          var musicList = ref([]);
