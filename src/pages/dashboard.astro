            try { parsed = JSON.parse(pioRaw.value); }
            catch { showToast('JSON 格式错误，请检查', 'error'); return; }
            pioSaving.value = true;
            api('/api/admin/data/pio', { method: 'PUT', body: JSON.stringify({ data: parsed, sha: pioSha.value }) })
              .then(function () { showToast('保存成功！', 'success'); })
              .catch(function (e) { showToast(e.message, 'error'); })
              .finally(function () { pioSaving.value = false; });
          }

          // ===== 音乐播放器配置（JSON 编辑） =====
          function loadMp() {
            page.value = 'musicplayer';
            api('/api/admin/data/musicPlayer').then(function (d) {
              mpSha.value = d.sha;
              mpRaw.value = JSON.stringify(d.data, null, 2);
            }).catch(function (e) { showToast(e.message, 'error'); });
          }
          function saveMp() {
            var parsed;
            try { parsed = JSON.parse(mpRaw.value); }
            catch { showToast('JSON 格式错误，请检查', 'error'); return; }
            mpSaving.value = true;
            api('/api/admin/data/musicPlayer', { method: 'PUT', body: JSON.stringify({ data: parsed, sha: mpSha.value }) })
              .then(function () { showToast('保存成功！', 'success'); })
              .catch(function (e) { showToast(e.message, 'error'); })
              .finally(function () { mpSaving.value = false; });
          }

          onMounted(function () { if (token.value) { loadStats(); } });

          return {
            token: token, password: password, logging: logging, login: login, logout: logout,
            page: page, sidebarOpen: sidebarOpen, pageTitle: pageTitle, posts: posts, loadingPosts: loadingPosts,
            stats: stats, loadStats: loadStats, loadPosts: loadPosts, fm: fm, body: body,
            saving: saving, newPost: newPost, editPost: editPost, deletePost: deletePost,
            savePost: savePost, goBlog: goBlog, toasts: toasts, handlePaste: handlePaste, handleCoverPaste: handleCoverPaste, selectedPosts: selectedPosts, toggleAllPosts: toggleAllPosts, batchDeletePosts: batchDeletePosts,
            handleDragOver: handleDragOver, handleDrop: handleDrop,
            previewMode: previewMode, renderMarkdown: renderMarkdown,
            projects: projects, loadingProjects: loadingProjects, pfm: pfm, pbody: pbody,
            loadProjects: loadProjects, newProject: newProject, editProject: editProject,
            saveProject: saveProject, deleteProject: deleteProject, statusLabel: statusLabel, statusTagClass: statusTagClass, selectedProjects: selectedProjects, toggleAllProjects: toggleAllProjects, batchDeleteProjects: batchDeleteProjects,
            dynamics: dynamics, loadingDynamics: loadingDynamics, dfm: dfm, dbody: dbody,
            loadDynamics: loadDynamics, newDynamic: newDynamic, editDynamic: editDynamic,
            saveDynamic: saveDynamic, deleteDynamic: deleteDynamic, selectedDynamics: selectedDynamics, toggleAllDynamics: toggleAllDynamics, batchDeleteDynamics: batchDeleteDynamics,
            musicList: musicList, musicSaving: musicSaving, loadMusic: loadMusic,
            neteasePlaylistId: neteasePlaylistId, neteaseSaving: neteaseSaving, saveNeteasePlaylist: saveNeteasePlaylist,
            booknavRaw: booknavRaw, booknavSaving: booknavSaving, loadBooknav: loadBooknav, saveBooknav: saveBooknav,
            galleryList: galleryList, gallerySaving: gallerySaving, loadGallery: loadGallery, addGallery: addGallery, removeGallery: removeGallery, saveGallery: saveGallery,
            animeList: animeList, animeCategories: animeCategories, animeSha: animeSha, animeSaving: animeSaving, loadAnime: loadAnime, addAnime: addAnime, removeAnime: removeAnime, saveAnime: saveAnime, animeSearchQuery: animeSearchQuery, animeSearchResults: animeSearchResults, animeSearching: animeSearching, searchBangumi: searchBangumi, importAnime: importAnime,
            specPage: specPage, specContent: specContent, specSaving: specSaving, loadSpec: loadSpec, switchSpec: switchSpec, saveSpec: saveSpec,
            profileData: profileData, profileSaving: profileSaving, loadProfile: loadProfile, addProfileLink: addProfileLink, removeProfileLink: removeProfileLink, saveProfile: saveProfile,
            announcementData: announcementData, announcementSaving: announcementSaving, loadAnnouncement: loadAnnouncement, saveAnnouncement: saveAnnouncement,
            effectsData: effectsData, effectsSaving: effectsSaving, loadEffects: loadEffects, saveEffects: saveEffects,
            friendsData: friendsData, friendsSaving: friendsSaving, loadFriends: loadFriends, addFriend: addFriend, removeFriend: removeFriend, saveFriends: saveFriends,
            bgRaw: bgRaw, bgSaving: bgSaving, loadBg: loadBg, saveBg: saveBg,
            sidebarRaw: sidebarRaw, sidebarSaving: sidebarSaving, loadSidebar: loadSidebar, saveSidebar: saveSidebar,
            navbarRaw: navbarRaw, navbarSaving: navbarSaving, loadNavbar: loadNavbar, saveNavbar: saveNavbar,
            siteData: siteData, siteSaving: siteSaving, loadSite: loadSite, saveSite: saveSite,
            footerContent: footerContent, footerSaving: footerSaving, loadFooter: loadFooter, saveFooter: saveFooter,
            searchData: searchData, searchSaving: searchSaving, loadSearch: loadSearch, saveSearch: saveSearch,
            fontData: fontData, fontSaving: fontSaving, loadFont: loadFont, saveFont: saveFont,
            coverData: coverData, coverSaving: coverSaving, loadCover: loadCover, saveCover: saveCover,
            licenseData: licenseData, licenseSaving: licenseSaving, loadLicense: loadLicense, saveLicense: saveLicense,
            pioRaw: pioRaw, pioSaving: pioSaving, loadPio: loadPio, savePio: savePio,
            mpRaw: mpRaw, mpSaving: mpSaving, loadMp: loadMp, saveMp: saveMp
          };
        }
      });

      app.mount('#app');
    } catch (e) {
      document.getElementById('app').innerHTML = '<div style="padding:40px; text-align:center; color:#ff4d4f"><h2>后台加载失败</h2><p>' + (e.message || e) + '</p><p>请刷新页面重试</p></div>';
      console.error('Dashboard init error:', e);
    }
  </script>
</body>
</html>
