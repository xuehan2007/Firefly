          // 将历史版本载入编辑器（不直接覆盖线上文件，用户检查后点保存才真正生效）
          function restoreVersion(versionId) {
            if (!confirm('将把该版本载入文章编辑器，未保存的当前修改会被替换。载入后请检查并点击“保存文章”完成恢复。')) return;
            getVersionContent(versionId)
              .then(function (d) {
                var content = d.content;
                var match = content.match(/^---\s*\n([\s\S]*?)\n---\s*\n?([\s\S]*)$/);
                var fmData = {};
                editingFilename.value = versionPanel.filename;
                editingOriginalContent.value = content;
                if (match) {
                  match[1].split('\n').forEach(function (line) {
                    var m = line.match(/^(\w+):\s*(.*)$/);
                    if (m) {
                      var v = m[2].trim();
                      if (v.charAt(0) === '[' && v.charAt(v.length - 1) === ']') {
                        v = v.slice(1, -1).split(',').map(function (s) {
                          return parseYamlScalar(s);
                        });
                      } else if (v !== '') {
                        v = parseYamlScalar(v);
                      }
                      if (v === 'true') v = true;
                      if (v === 'false') v = false;
                      fmData[m[1]] = v;
                    }
                  });
                  body.value = match[2];
                } else {
                  body.value = content;
                }
                originalBody.value = body.value;
                Object.assign(fm, {
                  title: fmData.title || '',
                  published: fmData.published || '',
                  description: fmData.description || '',
                  category: fmData.category || '',
                  image: fmData.image || '',
                  slug: fmData.slug || '',
                  draft: fmData.draft === true,
                  pinned: fmData.pinned === true,
                  tagsStr: Array.isArray(fmData.tags) ? fmData.tags.join(', ') : ''
                });
                // 取当前线上 sha，保证保存时是更新而不是新建
                api('/api/admin/post/' + encodeURIComponent(versionPanel.filename))
                  .then(function (cur) { editingSha.value = cur.sha; })
                  .catch(function () { editingSha.value = ''; });
                versionPanel.show = false;
                page.value = 'editor';
                showToast('已载入历史版本，确认无误后点击“保存文章”', 'info');
              })
              .catch(function (e) { showToast(e.message, 'error'); });
