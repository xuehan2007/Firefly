          var specSaving = ref(false);
          var pageTitle = computed(function () { return { dashboard: '仪表盘', posts: '文章管理', editor: '编辑文章', projects: '项目管理', 'project-editor': '编辑项目', dynamics: '动态说说', 'dynamic-editor': '编辑动态', music: '音乐播放', booknav: '书签导航', gallery: '相册管理', sponsor: '打赏管理', spec: '页面编辑' }[page.value] || '管理后台'; });

          function login() {
            logging.value = true;
            fetch('/api/admin/login/', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ password: password.value }) })
              .then(function (res) { return res.json().then(function (data) { return { res: res, data: data }; }); })
              .then(function (result) {
                if (result.res.ok) {
                  token.value = result.data.token;
                  localStorage.setItem('admin_token', result.data.token);
                  password.value = '';
                  loadStats();
                  showToast('登录成功', 'success');
                } else {
                  showToast(result.data.error || '登录失败', 'error');
                }
              })
              .catch(function () { showToast('网络错误', 'error'); })
              .finally(function () { logging.value = false; });
          }

          function logout() {
            token.value = '';
            localStorage.removeItem('admin_token');
          }

          function api(url, options) {
            options = options || {};
            // Astro trailingSlash: "always" 要求 URL 带尾斜杠
            if (url.indexOf('?') === -1) {
              if (url.charAt(url.length - 1) !== '/') url += '/';
            } else {
              var parts = url.split('?');
              if (parts[0].charAt(parts[0].length - 1) !== '/') parts[0] += '/';
              url = parts.join('?');
            }
            var headers = { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token.value };
            if (options.headers) { for (var k in options.headers) headers[k] = options.headers[k]; }
            return fetch(url, Object.assign({}, options, { headers: headers }))
              .then(function (res) {
                return res.json().catch(function () { return {}; }).then(function (data) {
                  if (res.status === 401) { logout(); showToast('登录已过期，请重新登录', 'error'); }
                  if (!res.ok) throw new Error(data.error || '请求失败 (' + res.status + ')');
                  return data;
                });
              });
          }

          function loadStats() {
            return api('/api/admin/stats').then(function (d) { stats.value = d; }).catch(function () {});
          }

          function loadPosts() {
            page.value = 'posts';
            loadingPosts.value = true;
            api('/api/admin/posts').then(function (list) {
              posts.value = list;
              stats.value = {
                totalPosts: list.length,
                published: list.filter(function (p) { return !p.draft; }).length,
                drafts: list.filter(function (p) { return p.draft; }).length,
                pinned: list.filter(function (p) { return p.pinned; }).length
              };
            }).catch(function (e) { showToast(e.message, 'error'); })
              .finally(function () { loadingPosts.value = false; });
          }

          function newPost() {
            editingFilename.value = '';
            editingSha.value = '';
            Object.assign(fm, { title: '', published: new Date().toISOString().slice(0, 10), description: '', category: '随笔', image: '', slug: '', draft: false, pinned: false, tagsStr: '' });
            body.value = '';
            page.value = 'editor';
          }

          function editPost(row) {
            api('/api/admin/post/' + encodeURIComponent(row.filename)).then(function (data) {
              editingFilename.value = data.filename;
              editingSha.value = data.sha;
              var match = data.content.match(/^---\s*\n([\s\S]*?)\n---\s*\n?([\s\S]*)$/);
              var fmData = {};
              if (match) {
                match[1].split('\n').forEach(function (line) {
                  var m = line.match(/^(\w+):\s*(.*)$/);
                  if (m) {
                    var v = m[2].trim();
                    if (v.charAt(0) === '[' && v.charAt(v.length - 1) === ']') v = v.slice(1, -1).split(',').map(function (s) { return s.trim().replace(/^["']|["']$/g, ''); });
                    if (v === 'true') v = true;
                    if (v === 'false') v = false;
                    fmData[m[1]] = v;
                  }
                });
                body.value = match[2];
              } else {
                body.value = data.content;
              }
              Object.assign(fm, {
                title: fmData.title || '',
                published: fmData.published || '',
                description: fmData.description || '',
                category: fmData.category || '',
                image: fmData.image || '',
                slug: fmData.slug || '',
                draft: fmData.draft === true,
                pinned: fmData.pinned === true,
                tagsStr: Array.isArray(fmData.tags) ? fmData.tags.join(', ') : ''
              });
              page.value = 'editor';
            }).catch(function (e) { showToast(e.message, 'error'); });
          }

          function deletePost(row) {
            if (confirm('确定删除文章「' + row.title + '」吗？')) {
              api('/api/admin/post/' + encodeURIComponent(row.filename), { method: 'DELETE', body: JSON.stringify({ sha: row.sha }) })
                .then(function () { showToast('删除成功', 'success'); loadPosts(); })
                .catch(function (e) { showToast(e.message, 'error'); });
            }
          }

          function savePost() {
            if (!fm.title) { showToast('请填写标题', 'warning'); return; }
            saving.value = true;
            var tags = fm.tagsStr ? fm.tagsStr.split(',').map(function (s) { return s.trim(); }).filter(Boolean) : [];
            var fmStr = '---\n';
            fmStr += 'title: ' + JSON.stringify(fm.title) + '\n';
            fmStr += 'published: ' + fm.published + '\n';
            if (fm.description) fmStr += 'description: ' + JSON.stringify(fm.description) + '\n';
            if (tags.length) fmStr += 'tags: [' + tags.map(function (t) { return JSON.stringify(t); }).join(', ') + ']\n';
            if (fm.category) fmStr += 'category: ' + JSON.stringify(fm.category) + '\n';
            if (fm.image) fmStr += 'image: ' + JSON.stringify(fm.image) + '\n';
            if (fm.slug) fmStr += 'slug: ' + JSON.stringify(fm.slug) + '\n';
            if (fm.draft) fmStr += 'draft: true\n';
            if (fm.pinned) fmStr += 'pinned: true\n';
            fmStr += '---\n';
            var content = fmStr + body.value;
            var filename = editingFilename.value;
            if (!filename) {
              var slug = fm.slug || fm.title.toLowerCase().replace(/\s+/g, '-').replace(/[^\w\u4e00-\u9fa5-]/g, '');
              filename = (fm.published || new Date().toISOString().slice(0, 10)) + '-' + slug + '.md';
            }
            var p;
            if (editingSha.value) {
              p = api('/api/admin/post/' + encodeURIComponent(filename), { method: 'PUT', body: JSON.stringify({ content: content, sha: editingSha.value }) });
            } else {
              p = api('/api/admin/posts', { method: 'POST', body: JSON.stringify({ filename: filename, content: content }) });
            }
            p.then(function () {
              showToast('保存成功！Vercel 将自动重新部署博客。', 'success');
              setTimeout(function () { loadPosts(); }, 1200);
            }).catch(function (e) { showToast(e.message, 'error'); })
              .finally(function () { saving.value = false; });
          }

          function goBlog() { window.open('/', '_blank'); }

          // ===== 项目管理 =====
          function statusLabel(s) { return { planning: '计划中', developing: '开发中', published: '已发布', archived: '已归档' }[s] || s || '未设置'; }
          function statusTagClass(s) { return s === 'published' ? 'tag-published' : (s === 'archived' ? 'tag-draft' : 'tag-pinned'); }

          function loadProjects() {
            page.value = 'projects';
            loadingProjects.value = true;
            api('/api/admin/projects').then(function (list) { projects.value = list; })
              .catch(function (e) { showToast(e.message, 'error'); })
              .finally(function () { loadingProjects.value = false; });
          }
          function newProject() {
            editingProjectFilename.value = '';
            editingProjectSha.value = '';
            Object.assign(pfm, { title: '', slug: '', published: new Date().toISOString().slice(0, 10), status: 'planning', order: '', description: '', image: '', draft: false, tagsStr: '', linksStr: '' });
            pbody.value = '';
            page.value = 'project-editor';
          }
          function editProject(row) {
            api('/api/admin/project/' + encodeURIComponent(row.filename)).then(function (data) {
              editingProjectFilename.value = data.filename;
              editingProjectSha.value = data.sha;
              var match = data.content.match(/^---\s*\n([\s\S]*?)\n---\s*\n?([\s\S]*)$/);
              var fmData = {};
              if (match) {
                match[1].split('\n').forEach(function (line) {
                  var m = line.match(/^(\w+):\s*(.*)$/);
                  if (m) { var v = m[2].trim(); if (v.charAt(0) === '"' && v.charAt(v.length - 1) === '"') v = v.slice(1, -1); fmData[m[1]] = v; }
                });
                pbody.value = match[2];
              } else { pbody.value = data.content; }
              Object.assign(pfm, {
                title: fmData.title || '', slug: fmData.slug || '', published: fmData.published || '',
                status: fmData.status || 'planning', order: fmData.order || '', description: fmData.description || '',
                image: fmData.image || '', draft: fmData.draft === 'true', tagsStr: '', linksStr: ''
              });
              page.value = 'project-editor';
            }).catch(function (e) { showToast(e.message, 'error'); });
          }
          function saveProject() {
            if (!pfm.title) { showToast('请填写项目名称', 'warning'); return; }
            saving.value = true;
            var tags = pfm.tagsStr ? pfm.tagsStr.split(',').map(function (s) { return s.trim(); }).filter(Boolean) : [];
            var links = pfm.linksStr ? pfm.linksStr.split('\n').map(function (s) { return s.trim(); }).filter(Boolean) : [];
            var fmStr = '---\n';
            fmStr += 'title: ' + JSON.stringify(pfm.title) + '\n';
            if (pfm.slug) fmStr += 'slug: ' + JSON.stringify(pfm.slug) + '\n';
            fmStr += 'published: ' + pfm.published + '\n';
            fmStr += 'draft: ' + (pfm.draft ? 'true' : 'false') + '\n';
            if (pfm.order) fmStr += 'order: ' + pfm.order + '\n';
            if (pfm.description) fmStr += 'description: ' + JSON.stringify(pfm.description) + '\n';
            if (pfm.image) fmStr += 'image: ' + JSON.stringify(pfm.image) + '\n';
            fmStr += 'status: ' + JSON.stringify(pfm.status) + '\n';
            if (tags.length) fmStr += 'tags:\n' + tags.map(function (t) { return '  - ' + JSON.stringify(t); }).join('\n') + '\n';
            if (links.length) {
              fmStr += 'link:\n';
              links.forEach(function (l) {
                var parts = l.split('|');
                fmStr += '  - label: ' + JSON.stringify(parts[0] || '') + '\n';
                if (parts[1]) fmStr += '    icon: ' + JSON.stringify(parts[1]) + '\n';
                if (parts[2]) fmStr += '    value: ' + JSON.stringify(parts[2]) + '\n';
              });
            }
            fmStr += '---\n';
            var content = fmStr + pbody.value;
            var filename = editingProjectFilename.value;
            if (!filename) {
              var slug = pfm.slug || pfm.title.toLowerCase().replace(/\s+/g, '-').replace(/[^\w\u4e00-\u9fa5-]/g, '');
              filename = slug + '.md';
            }
            var p;
            if (editingProjectSha.value) {
              p = api('/api/admin/project/' + encodeURIComponent(filename), { method: 'PUT', body: JSON.stringify({ content: content, sha: editingProjectSha.value }) });
            } else {
              p = api('/api/admin/projects', { method: 'POST', body: JSON.stringify({ filename: filename, content: content }) });
            }
            p.then(function () { showToast('保存成功！', 'success'); setTimeout(function () { loadProjects(); }, 1200); })
              .catch(function (e) { showToast(e.message, 'error'); })
              .finally(function () { saving.value = false; });
          }
          function deleteProject(row) {
            if (confirm('确定删除项目「' + row.title + '」吗？')) {
              api('/api/admin/project/' + encodeURIComponent(row.filename), { method: 'DELETE', body: JSON.stringify({ sha: row.sha }) })
                .then(function () { showToast('删除成功', 'success'); loadProjects(); })
                .catch(function (e) { showToast(e.message, 'error'); });
            }
          }

          // ===== 动态管理 =====
          function loadDynamics() {
            page.value = 'dynamics';
            loadingDynamics.value = true;
            api('/api/admin/dynamics').then(function (list) { dynamics.value = list; })
              .catch(function (e) { showToast(e.message, 'error'); })
              .finally(function () { loadingDynamics.value = false; });
          }
          function newDynamic() {
            editingDynamicFilename.value = '';
            editingDynamicSha.value = '';
            var now = new Date();
            var pad = function (n) { return n < 10 ? '0' + n : '' + n; };
            dfm.published = now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate()) + 'T' + pad(now.getHours()) + ':' + pad(now.getMinutes());
            dbody.value = '';
            page.value = 'dynamic-editor';
          }
          function editDynamic(row) {
            api('/api/admin/dynamic/' + encodeURIComponent(row.filename)).then(function (data) {
              editingDynamicFilename.value = data.filename;
              editingDynamicSha.value = data.sha;
              var match = data.content.match(/^---\s*\n([\s\S]*?)\n---\s*\n?([\s\S]*)$/);
              if (match) {
                var m = match[1].match(/^published:\s*(.+)$/m);
                var pub = m ? m[1].trim() : '';
                if (pub.charAt(0) === '"') pub = pub.slice(1, -1);
                dfm.published = pub.replace(' ', 'T');
                dbody.value = match[2];
              } else {
                dfm.published = '';
                dbody.value = data.content;
              }
              page.value = 'dynamic-editor';
            }).catch(function (e) { showToast(e.message, 'error'); });
          }
          function saveDynamic() {
            if (!dbody.value.trim()) { showToast('请输入动态内容', 'warning'); return; }
            saving.value = true;
            var pub = dfm.published ? dfm.published.replace('T', ' ') : new Date().toISOString().replace('T', ' ').slice(0, 16);
            var fmStr = '---\npublished: ' + pub + '\n---\n';
            var content = fmStr + dbody.value;
            var filename = editingDynamicFilename.value;
            if (!filename) {
              var d = new Date();
              var pad = function (n) { return n < 10 ? '0' + n : '' + n; };
              filename = d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + '-' + pad(d.getHours()) + pad(d.getMinutes()) + pad(d.getSeconds()) + '.md';
            }
            var p;
            if (editingDynamicSha.value) {
              p = api('/api/admin/dynamic/' + encodeURIComponent(filename), { method: 'PUT', body: JSON.stringify({ content: content, sha: editingDynamicSha.value }) });
            } else {
              p = api('/api/admin/dynamics', { method: 'POST', body: JSON.stringify({ filename: filename, content: content }) });
            }
            p.then(function () { showToast('保存成功！', 'success'); setTimeout(function () { loadDynamics(); }, 1200); })
              .catch(function (e) { showToast(e.message, 'error'); })
              .finally(function () { saving.value = false; });
          }
          function deleteDynamic(row) {
            if (confirm('确定删除这条动态吗？')) {
              api('/api/admin/dynamic/' + encodeURIComponent(row.filename), { method: 'DELETE', body: JSON.stringify({ sha: row.sha }) })
                .then(function () { showToast('删除成功', 'success'); loadDynamics(); })
                .catch(function (e) { showToast(e.message, 'error'); });
            }
          }

          // ===== 音乐管理 =====
          function loadMusic() {
            page.value = 'music';
            api('/api/admin/data/music.json').then(function (d) {
              musicSha.value = d.sha;
              musicList.value = d.data || [];
            }).catch(function (e) { showToast(e.message, 'error'); });
          }
          function addMusic() { musicList.value.push({ name: '', artist: '', url: '', cover: '', lrc: '' }); }
          function removeMusic(i) { musicList.value.splice(i, 1); }
          function saveMusic() {
            musicSaving.value = true;
            api('/api/admin/data/music.json', { method: 'PUT', body: JSON.stringify({ data: musicList.value, sha: musicSha.value }) })
              .then(function (d) { musicSha.value = d.sha || musicSha.value; showToast('保存成功！', 'success'); })
              .catch(function (e) { showToast(e.message, 'error'); })
              .finally(function () { musicSaving.value = false; });
          }

          // ===== 书签导航（JSON 编辑） =====
          function loadBooknav() {
            page.value = 'booknav';
            api('/api/admin/data/booknav.json').then(function (d) {
              booknavSha.value = d.sha;
              booknavRaw.value = JSON.stringify(d.data, null, 2);
            }).catch(function (e) { showToast(e.message, 'error'); });
          }
          function saveBooknav() {
            var parsed;
            try { parsed = JSON.parse(booknavRaw.value); }
            catch { showToast('JSON 格式错误，请检查', 'error'); return; }
            booknavSaving.value = true;
            api('/api/admin/data/booknav.json', { method: 'PUT', body: JSON.stringify({ data: parsed, sha: booknavSha.value }) })
              .then(function () { showToast('保存成功！', 'success'); })
              .catch(function (e) { showToast(e.message, 'error'); })
              .finally(function () { booknavSaving.value = false; });
          }

          // ===== 相册管理 =====
          function loadGallery() {
            page.value = 'gallery';
            api('/api/admin/data/gallery.json').then(function (d) {
              gallerySha.value = d.sha;
              galleryList.value = d.data || [];
            }).catch(function (e) { showToast(e.message, 'error'); });
          }
          function addGallery() { galleryList.value.push({ id: '', name: '', description: '', location: '', date: '', tags: [] }); }
          function removeGallery(i) { galleryList.value.splice(i, 1); }
          function saveGallery() {
            gallerySaving.value = true;
            var data = galleryList.value.map(function (alb) {
              var o = Object.assign({}, alb);
              if (typeof o.tags === 'string') o.tags = o.tags.split(',').map(function (t) { return t.trim(); }).filter(Boolean);
              if (!o.tags) o.tags = [];
              return o;
            });
            api('/api/admin/data/gallery.json', { method: 'PUT', body: JSON.stringify({ data: data, sha: gallerySha.value }) })
              .then(function () { showToast('保存成功！', 'success'); })
              .catch(function (e) { showToast(e.message, 'error'); })
              .finally(function () { gallerySaving.value = false; });
          }

          // ===== 打赏管理 =====
          function loadSponsor() {
            page.value = 'sponsor';
            api('/api/admin/data/sponsor.json').then(function (d) {
              sponsorSha.value = d.sha;
              sponsorMethods.value = (d.data && d.data.methods) || [];
              sponsorList.value = (d.data && d.data.sponsors) || [];
            }).catch(function (e) { showToast(e.message, 'error'); });
          }
          function addMethod() { sponsorMethods.value.push({ name: '', icon: '', qrCode: '', link: '', description: '', enabled: true }); }
          function removeMethod(i) { sponsorMethods.value.splice(i, 1); }
          function addSponsor() { sponsorList.value.push({ name: '', avatar: '', amount: '', date: '' }); }
          function removeSponsor(i) { sponsorList.value.splice(i, 1); }
          function saveSponsor() {
            sponsorSaving.value = true;
            var data = { methods: sponsorMethods.value, sponsors: sponsorList.value };
            api('/api/admin/data/sponsor.json', { method: 'PUT', body: JSON.stringify({ data: data, sha: sponsorSha.value }) })
              .then(function () { showToast('保存成功！', 'success'); })
              .catch(function (e) { showToast(e.message, 'error'); })
              .finally(function () { sponsorSaving.value = false; });
          }

          // ===== 页面编辑（关于/留言板） =====
          function loadSpec() {
            page.value = 'spec';
            api('/api/admin/spec/' + encodeURIComponent(specPage.value)).then(function (d) {
              specSha.value = d.sha;
              specContent.value = d.content;
            }).catch(function (e) { showToast(e.message, 'error'); });
          }
          function switchSpec(name) {
            specPage.value = name;
            loadSpec();
          }
          function saveSpec() {
            specSaving.value = true;
            api('/api/admin/spec/' + encodeURIComponent(specPage.value), { method: 'PUT', body: JSON.stringify({ content: specContent.value, sha: specSha.value }) })
              .then(function () { showToast('保存成功！', 'success'); })
              .catch(function (e) { showToast(e.message, 'error'); })
              .finally(function () { specSaving.value = false; });
          }

          onMounted(function () { if (token.value) { loadStats(); } });

          return {
            token: token, password: password, logging: logging, login: login, logout: logout,
            page: page, pageTitle: pageTitle, posts: posts, loadingPosts: loadingPosts,
            stats: stats, loadStats: loadStats, loadPosts: loadPosts, fm: fm, body: body,
            saving: saving, newPost: newPost, editPost: editPost, deletePost: deletePost,
            savePost: savePost, goBlog: goBlog, toasts: toasts,
            projects: projects, loadingProjects: loadingProjects, pfm: pfm, pbody: pbody,
            loadProjects: loadProjects, newProject: newProject, editProject: editProject,
            saveProject: saveProject, deleteProject: deleteProject, statusLabel: statusLabel, statusTagClass: statusTagClass,
            dynamics: dynamics, loadingDynamics: loadingDynamics, dfm: dfm, dbody: dbody,
            loadDynamics: loadDynamics, newDynamic: newDynamic, editDynamic: editDynamic,
            saveDynamic: saveDynamic, deleteDynamic: deleteDynamic,
            musicList: musicList, musicSaving: musicSaving, loadMusic: loadMusic, addMusic: addMusic, removeMusic: removeMusic, saveMusic: saveMusic,
            booknavRaw: booknavRaw, booknavSaving: booknavSaving, loadBooknav: loadBooknav, saveBooknav: saveBooknav,
            galleryList: galleryList, gallerySaving: gallerySaving, loadGallery: loadGallery, addGallery: addGallery, removeGallery: removeGallery, saveGallery: saveGallery,
            sponsorMethods: sponsorMethods, sponsorList: sponsorList, sponsorSaving: sponsorSaving, loadSponsor: loadSponsor, addMethod: addMethod, removeMethod: removeMethod, addSponsor: addSponsor, removeSponsor: removeSponsor, saveSponsor: saveSponsor,
            specPage: specPage, specContent: specContent, specSaving: specSaving, loadSpec: loadSpec, switchSpec: switchSpec, saveSpec: saveSpec
          };
        }
      });

      app.mount('#app');
    } catch (e) {
      document.getElementById('app').innerHTML = '<div style="padding:40px; text-align:center; color:#ff4d4f"><h2>后台加载失败</h2><p>' + (e.message || e) + '</p><p>请刷新页面重试</p></div>';
      console.error('Dashboard init error:', e);
    }
  </script>
</body>
</html>
