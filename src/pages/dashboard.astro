          // 取某一档位的壁纸数组（兼容 src 为字符串/数组/对象三种形态）
          function bgSourceList(kind) {
            var d = bgData.value;
            if (!d || d.src == null) return [];
            if (Array.isArray(d.src)) return d.src;
            if (typeof d.src === 'string') return [d.src];
            var list = d.src[kind];
            if (Array.isArray(list)) return list;
            return list ? [list] : [];
          }
          function bgIsDisabled(kind, p) {
            var dis = bgData.value && bgData.value.disabled && bgData.value.disabled[kind];
            return !!(dis && dis.indexOf(p) !== -1);
          }
          function bgActiveCount(kind) {
            var d = bgData.value;
            var dis = (d && d.disabled && d.disabled[kind]) || [];
            return bgSourceList(kind).filter(function (p) { return dis.indexOf(p) === -1; }).length;
          }
          function toggleBg(kind, p) {
            var d = bgData.value;
            if (!d) return;
            if (!d.disabled) d.disabled = {};
            if (!d.disabled[kind]) d.disabled[kind] = [];
            var arr = d.disabled[kind];
            var idx = arr.indexOf(p);
            if (idx === -1) arr.push(p); else arr.splice(idx, 1);
          }
