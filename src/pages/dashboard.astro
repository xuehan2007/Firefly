          // Canvas 压缩缩放：宽超过 maxWidth 才缩，输出 JPEG dataURL
          function resizeWallpaper(file, maxWidth, quality) {
            return new Promise(function (resolve, reject) {
              var objUrl = URL.createObjectURL(file);
              var img = new Image();
              img.onload = function () {
                URL.revokeObjectURL(objUrl);
                var w = img.naturalWidth, h = img.naturalHeight;
                if (!w || !h) { reject(new Error('图片读取失败：' + file.name)); return; }
                if (w > maxWidth) { h = Math.round(h * maxWidth / w); w = maxWidth; }
                var canvas = document.createElement('canvas');
                canvas.width = w; canvas.height = h;
                canvas.getContext('2d').drawImage(img, 0, 0, w, h);
                resolve(canvas.toDataURL('image/jpeg', quality));
              };
              img.onerror = function () {
                URL.revokeObjectURL(objUrl);
                reject(new Error('无法解析图片：' + file.name));
              };
              img.src = objUrl;
            });
          }

          function uploadWallpapers(kind, event) {
            var files = Array.prototype.slice.call(event.target.files || []);
            event.target.value = ''; // 允许再次选择同一文件
            if (!files.length || wpUploading.value) return;
            var maxW = kind === 'mobile' ? 1600 : 3840;
            var quality = kind === 'mobile' ? 0.82 : 0.85;
            wpUploading.value = true;
            // 串行处理：每次上传服务端都会改 backgroundWallpaper.json，并行会 sha 冲突
            var chain = Promise.resolve();
            var totalOrig = 0, totalNew = 0, doneCount = 0;
            var fmtSize = function (bytes) {
              return bytes >= 1048576 ? (bytes / 1048576).toFixed(1) + 'MB' : Math.round(bytes / 1024) + 'KB';
            };
            files.forEach(function (f, i) {
              chain = chain.then(function () {
                wpUploadStatus.value = '⏳ 处理中 ' + (i + 1) + '/' + files.length + '：' + f.name;
                return resizeWallpaper(f, maxW, quality).then(function (dataUrl) {
                  var b64 = dataUrl.split(',')[1];
                  var newSize = Math.round(b64.length * 3 / 4);
                  totalOrig += f.size; totalNew += newSize;
                  wpUploadStatus.value = '⏳ 上传中 ' + (i + 1) + '/' + files.length + '：' + f.name + '（' + fmtSize(f.size) + ' → ' + fmtSize(newSize) + '）';
                  return api('/api/admin/wallpaper', {
                    method: 'POST',
                    body: JSON.stringify({ kind: kind, content: b64 }),
                  }).then(function (r) {
                    doneCount++;
                    // 新壁纸的构建期缩略图要等重新部署才有，先用本地 dataURL 顶上
                    if (r && r.path) wallpaperThumbs[r.path] = dataUrl;
                  });
                });
              });
            });
            chain
              .then(function () {
                showToast('上传完成 ' + doneCount + ' 张，共 ' + fmtSize(totalOrig) + ' → ' + fmtSize(totalNew) + '，等重新部署后线上生效', 'success');
                return refreshBg();
              })
              .catch(function (e) { showToast(e.message, 'error'); })
              .finally(function () { wpUploading.value = false; wpUploadStatus.value = ''; });
          }

          function deleteWallpaper(kind, p) {
            if (!confirm('确定删除该壁纸？\n' + p + '\n文件将从 GitHub 仓库中移除，重新部署后线上生效。')) return;
            api('/api/admin/wallpaper', {
              method: 'DELETE',
              body: JSON.stringify({ kind: kind, path: p }),
            })
              .then(function () {
                delete wallpaperThumbs[p];
                showToast('已删除，等重新部署后线上生效', 'success');
                return refreshBg();
