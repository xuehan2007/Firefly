          }

          // ===== 壁纸拖拽排序（HTML5 DnD，桌面端；移动端用下方 JSON 调整） =====
          var dropTarget = ref('');
          var dragWp = { kind: '', index: -1 };

          function onWpDragStart(kind, i, ev) {
            dragWp.kind = kind;
            dragWp.index = i;
            if (ev.dataTransfer) {
              ev.dataTransfer.effectAllowed = 'move';
              try { ev.dataTransfer.setData('text/plain', ''); } catch (e) {}
            }
          }
          function onWpDragOver(kind, i) {
            if (dragWp.kind === kind && dragWp.index !== -1 && dragWp.index !== i) {
              dropTarget.value = kind + ':' + i;
            }
          }
          function onWpDragLeave(kind, i) {
            if (dropTarget.value === kind + ':' + i) dropTarget.value = '';
          }
          function onWpDrop(kind, i, ev) {
            ev.preventDefault();
            dropTarget.value = '';
            var from = dragWp.index;
            dragWp.index = -1;
            if (dragWp.kind !== kind || from === -1 || from === i) return;
            var arr = bgSourceList(kind); // 活数组引用，splice 触发响应式
            var moved = arr.splice(from, 1)[0];
            arr.splice(i, 0, moved);
            showToast('顺序已调整，点「保存设置」提交后生效', 'success');
          }
          function onWpDragEnd() {
            dropTarget.value = '';
            dragWp.index = -1;
          }

          // 移动端友好的排序方式：‹ › 按钮逐位移动（触屏不支持 HTML5 拖拽）
          function moveWallpaper(kind, i, delta) {
            var arr = bgSourceList(kind);
            var j = i + delta;
            if (i < 0 || i >= arr.length || j < 0 || j >= arr.length) return;
            var tmp = arr[i];
            arr[i] = arr[j];
            arr[j] = tmp;
            // 触发数组引用不变的响应式：splice 一次确保 Vue 侦测
            arr.splice(arr.length - 1, 1, arr[arr.length - 1]);
            showToast('顺序已调整，点「保存设置」提交后生效', 'success');
          }

