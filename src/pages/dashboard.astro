---
export const prerender = false;

import { Font } from "astro:assets";
import wallpaperThumbsManifest from "../constants/wallpaper-thumbs.json";

// 本页是 SSR（prerender = false），getImage 只能生成 /_image 运行时端点 URL，
// 而部署平台不提供该端点（404），所以壁纸图一律改用构建期脚本
// （scripts/generate-wallpaper-thumbs.ts）预生成的静态 webp 文件。
// 后台随机背景：宽屏（>=1024px）用 1920px 桌面壁纸，窄屏用 1080px 移动端壁纸
// （断点与前台壁纸一致，见 WallpaperSection.astro）
const baWallpapersDesktop: string[] = wallpaperThumbsManifest.desktopLarge;
const baWallpapersMobile: string[] = wallpaperThumbsManifest.mobileLarge;
// 壁纸管理页缩略图：320px webp，映射 key 与 backgroundWallpaper.json 路径一致
const wallpaperThumbs: Record<string, string> = wallpaperThumbsManifest.thumbs;
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>博客管理后台</title>
  <Font cssVariable="--font-lxgw-wenkai" preload={true} />
  <style is:global>
    :root {
      --mica-blur: blur(12px) saturate(1.4);
      --mica-border: rgba(255, 255, 255, 0.18);
      --mica-border-dark: rgba(255, 255, 255, 0.12);
      --mica-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
      --mica-shadow-hover: 0 16px 48px rgba(0, 0, 0, 0.2);
      --accent: #3BAAFF;
      --accent-glow: rgba(59, 170, 255, 0.35);
      --accent-light: rgba(59, 170, 255, 0.15);
      --text-primary: rgba(255, 255, 255, 0.95);
      --text-secondary: rgba(255, 255, 255, 0.65);
      --text-muted: rgba(255, 255, 255, 0.45);
      --card-bg: rgba(23, 23, 23, 0.6);
      --card-bg-hover: rgba(23, 23, 23, 0.7);
      --sidebar-bg: rgba(23, 23, 23, 0.65);
      --input-bg: rgba(255, 255, 255, 0.08);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { height: 100%; width: 100%; }
    body {
      font-family: var(--font-lxgw-wenkai, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei', Roboto, sans-serif);
      background: #0a0a14 url('https://t.alcy.cc/pc') center/cover fixed;
      color: var(--text-primary);
      overflow: hidden;
    }
    body::after {
      content: '';
      position: fixed;
      inset: 0;
      background: linear-gradient(135deg, rgba(10, 10, 20, 0.55) 0%, rgba(20, 15, 35, 0.45) 50%, rgba(10, 10, 20, 0.55) 100%);
      backdrop-filter: blur(2px);
      z-index: -1;
    }
    #app { min-height: 100vh; }
    .app-loading {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-secondary);
      font-size: 16px;
      backdrop-filter: blur(8px);
    }

    /* ===== 登录页 ===== */
    .login-wrap {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }
    .login-card {
      width: 420px;
      padding: 48px 40px;
      background: var(--card-bg);
      backdrop-filter: var(--mica-blur);
      -webkit-backdrop-filter: var(--mica-blur);
      border-radius: 20px;
      border: 1px solid var(--mica-border);
      box-shadow: 0 24px 64px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.15);
      position: relative;
      z-index: 1;
      animation: card-in 0.5s ease;
    }
    @keyframes card-in { from { opacity: 0; transform: translateY(20px) scale(0.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
    .login-logo { text-align: center; font-size: 56px; margin-bottom: 16px; filter: drop-shadow(0 4px 12px rgba(59, 170, 255, 0.5)); }
    .login-title { text-align: center; font-size: 26px; font-weight: 700; margin-bottom: 8px; color: #fff; letter-spacing: 1px; }
    .login-sub { text-align: center; color: var(--text-secondary); font-size: 14px; margin-bottom: 36px; }
    .login-input {
      width: 100%; height: 50px; padding: 0 18px; font-size: 15px;
      border-radius: 12px; border: 1px solid var(--mica-border-dark);
      background: var(--input-bg); color: #fff; margin-bottom: 18px;
      box-sizing: border-box; outline: none; transition: all 0.25s ease;
    }
    .login-input::placeholder { color: var(--text-muted); }
    .login-input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow), inset 0 1px 0 rgba(255, 255, 255, 0.1); background: rgba(255, 255, 255, 0.15); }
    .login-btn {
      width: 100%; height: 50px; font-size: 16px; font-weight: 600;
      color: #fff; background: linear-gradient(135deg, #3BAAFF 0%, #7DD3FC 100%);
      border: none; border-radius: 12px; cursor: pointer;
      transition: all 0.25s ease; letter-spacing: 4px;
      box-shadow: 0 4px 16px var(--accent-glow);
    }
    .login-btn:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 8px 24px var(--accent-glow); }
    .login-btn:active:not(:disabled) { transform: translateY(0); }
    .login-btn:disabled { opacity: 0.6; cursor: not-allowed; }

    /* ===== 主布局 ===== */
    .layout { display: flex; height: 100vh; overflow: hidden; }
    .sidebar {
      width: 168px; background: var(--sidebar-bg);
      backdrop-filter: var(--mica-blur); -webkit-backdrop-filter: var(--mica-blur);
      color: var(--text-primary); display: flex; flex-direction: column;
      border-right: 1px solid var(--mica-border-dark);
      min-height: 0;
    }
    .sidebar-logo {
      height: 68px; display: flex; align-items: center; gap: 8px; padding: 0 14px;
      font-size: 15px; font-weight: 700; border-bottom: 1px solid var(--mica-border-dark);
      letter-spacing: 0.5px;
    }
    .sidebar-menu { flex: 1; min-height: 0; overflow-y: auto; padding: 16px 8px; scrollbar-width: thin; scrollbar-color: rgba(59, 170, 255, 0.5) transparent; }
    .sidebar-menu::-webkit-scrollbar { width: 6px; }
    .sidebar-menu::-webkit-scrollbar-track { background: transparent; }
    .sidebar-menu::-webkit-scrollbar-thumb { background: rgba(59, 170, 255, 0.4); border-radius: 3px; }
    .sidebar-menu::-webkit-scrollbar-thumb:hover { background: rgba(59, 170, 255, 0.65); }
    .menu-item {
      padding: 11px 12px; margin-bottom: 6px; border-radius: 12px; cursor: pointer;
      display: flex; align-items: center; gap: 9px; transition: all 0.2s ease;
      color: var(--text-secondary); font-size: 13px; font-weight: 500;
    }
    .menu-item:hover { background: rgba(255, 255, 255, 0.08); color: #fff; }
    .menu-item.active {
      background: linear-gradient(135deg, rgba(59, 170, 255, 0.35), rgba(167, 139, 250, 0.25));
      color: #fff; box-shadow: 0 2px 12px var(--accent-glow);
      border: 1px solid rgba(59, 170, 255, 0.4);
    }
    .sidebar-footer { padding: 12px; border-top: 1px solid var(--mica-border-dark); }
    .logout-btn {
      width: 100%; padding: 11px 12px; border: none; background: none;
      color: var(--text-secondary); cursor: pointer; border-radius: 12px;
      font-size: 13px; text-align: left; display: flex; align-items: center; gap: 9px;
      transition: all 0.2s ease; font-weight: 500;
    }
    .logout-btn:hover { background: rgba(255, 77, 79, 0.12); color: #ff7875; }

    /* ===== 桌面端：图标折叠侧栏（悬停展开，浮在内容上方不挤压正文） ===== */
    @media (min-width: 769px) {
      .sidebar {
        position: fixed; top: 0; left: 0; bottom: 0; width: 64px;
        z-index: 900; overflow: hidden;
        transition: width 0.24s ease, box-shadow 0.24s ease;
      }
      .sidebar:hover { width: 135px; box-shadow: 8px 0 26px rgba(0, 0, 0, 0.45); }
      /* 折叠轨道固定占位 64px，展开时覆盖而非推挤 .main */
      .main { margin-left: 64px; }
      .sidebar-logo { padding: 0 20px; }
      .menu-item { padding: 11px 14px; }
      .sidebar-menu { overflow-x: hidden; }
      .sidebar-logo, .menu-item, .logout-btn { gap: 0; }
      .menu-label {
        display: inline-block; max-width: 0; padding-left: 0; opacity: 0; overflow: hidden;
        white-space: nowrap;
        transition: max-width 0.24s ease, padding-left 0.24s ease, opacity 0.16s ease;
      }
      .sidebar:hover .menu-label { max-width: 90px; padding-left: 7px; opacity: 1; }
    }

    .menu-toggle {
      display: none;
      background: none; border: 1px solid var(--mica-border-dark);
      color: #fff; font-size: 20px; cursor: pointer;
      width: 40px; height: 40px; border-radius: 10px;
      align-items: center; justify-content: center;
    }
    .menu-toggle:hover { border-color: var(--accent); background: var(--accent-light); }
    .sidebar-backdrop {
      display: none;
      position: fixed; inset: 0; background: rgba(0, 0, 0, 0.5);
      z-index: 998; backdrop-filter: blur(2px);
    }

    .main { flex: 1; display: flex; flex-direction: column; min-width: 0; min-height: 0; }
    .header {
      height: 68px; background: var(--sidebar-bg);
      backdrop-filter: var(--mica-blur); -webkit-backdrop-filter: var(--mica-blur);
      border-bottom: 1px solid var(--mica-border-dark);
      display: flex; align-items: center; justify-content: space-between; padding: 0 32px;
    }
    .header-title { font-size: 20px; font-weight: 700; letter-spacing: 0.5px; }
    .content { flex: 1; padding: 32px; overflow-y: auto; }

    /* ===== Mica 卡片 ===== */
    .mica-card {
      background: var(--card-bg);
      backdrop-filter: var(--mica-blur); -webkit-backdrop-filter: var(--mica-blur);
      border-radius: 16px; border: 1px solid var(--mica-border);
      box-shadow: var(--mica-shadow), inset 0 1px 0 rgba(255, 255, 255, 0.1);
      transition: all 0.25s ease;
    }
    .mica-card:hover { background: var(--card-bg-hover); box-shadow: var(--mica-shadow-hover); }

    .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 28px; }
    .stat-card { padding: 24px; display: flex; align-items: center; gap: 18px; }
    .stat-icon {
      width: 56px; height: 56px; border-radius: 14px;
      display: flex; align-items: center; justify-content: center; font-size: 28px;
      background: var(--accent-light); border: 1px solid rgba(59, 170, 255, 0.3);
    }
    .stat-info .label { font-size: 13px; color: var(--text-secondary); margin-bottom: 4px; }
    .stat-info .value { font-size: 30px; font-weight: 700; color: #fff; }

    .quick-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; }
    .quick-card { padding: 24px; cursor: pointer; }
    .quick-card:hover { transform: translateY(-3px); border-color: var(--accent); }
    .quick-card h4 { font-size: 16px; margin-bottom: 8px; display: flex; align-items: center; gap: 8px; color: #fff; }
    .quick-card p { color: var(--text-secondary); font-size: 13px; line-height: 1.6; }

    /* ===== 编辑器 ===== */
    .editor-toolbar { display: flex; gap: 12px; margin-bottom: 20px; align-items: center; flex-wrap: wrap; }

    /* ===== 壁纸可视化管理网格 ===== */
    .wp-manager { margin-top: 4px; }
    .wp-section-title {
      font-size: 14px; font-weight: 600; color: var(--text-primary);
      margin: 16px 0 10px; display: flex; align-items: center; gap: 6px;
    }
    .wp-section-title:first-child { margin-top: 0; }
    .wp-grid {
      display: grid; gap: 10px;
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    }
    .wp-grid-mobile {
      grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    }
    .wp-item {
      position: relative; border-radius: 10px; overflow: hidden; cursor: pointer;
      background: rgba(255,255,255,0.06);
      border: 2px solid transparent;
      transition: border-color 0.18s ease, transform 0.18s ease, opacity 0.18s ease;
    }
    .wp-grid-desktop .wp-item { aspect-ratio: 16 / 10; }
    .wp-grid-mobile .wp-item { aspect-ratio: 3 / 4; }
    .wp-item:hover { border-color: var(--accent); transform: translateY(-2px); }
    .wp-item img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .wp-item.off { opacity: 0.35; filter: grayscale(0.7); }
    .wp-item.off:hover { opacity: 0.6; }
    .wp-no {
      position: absolute; top: 6px; left: 6px;
      padding: 2px 7px; border-radius: 999px;
      font-size: 11px; line-height: 1.4;
      color: #fff; background: rgba(0,0,0,0.55);
      -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px);
      pointer-events: none;
    }
    .wp-badge {
      position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
      padding: 4px 10px; border-radius: 999px;
      font-size: 12px; font-weight: 600; white-space: nowrap;
      color: #fff; background: rgba(0,0,0,0.65);
      opacity: 0; pointer-events: none; transition: opacity 0.15s ease;
    }
    .wp-item.off .wp-badge { opacity: 1; }
    .wp-del {
      position: absolute; top: 6px; right: 6px; z-index: 2;
      width: 22px; height: 22px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 14px; line-height: 1; font-weight: 700;
      color: #fff; background: rgba(220, 60, 60, 0.85);
      -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px);
      opacity: 0; transition: opacity 0.15s ease, transform 0.15s ease;
      cursor: pointer;
    }
    .wp-item:hover .wp-del { opacity: 1; }
    .wp-del:hover { transform: scale(1.15); background: rgba(220, 60, 60, 1); }
    @media (hover: none) { .wp-del { opacity: 1; } }
    .wp-item[draggable="true"] { cursor: grab; }
    .wp-item.drop-target { outline: 2px dashed var(--accent, #3b82f6); outline-offset: 2px; }
    .wp-move {
      position: absolute; bottom: 6px; z-index: 2;
      width: 22px; height: 22px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 14px; line-height: 1; font-weight: 700;
      color: #fff; background: rgba(0, 0, 0, 0.55);
      -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px);
      opacity: 0; transition: opacity 0.15s ease, background 0.15s ease;
      cursor: pointer;
    }
    .wp-move-prev { left: 6px; }
    .wp-move-next { right: 6px; }
    .wp-item:hover .wp-move { opacity: 1; }
    .wp-move:hover { background: rgba(0, 0, 0, 0.85); }
    .wp-move.disabled { opacity: 0.25 !important; pointer-events: none; }
    @media (hover: none) { .wp-move { opacity: 0.85; } }
    .form-row { margin-bottom: 14px; }
    .form-row label { display: block; font-size: 13px; color: var(--text-secondary); margin-bottom: 6px; font-weight: 500; }
    .form-row input, .form-row textarea {
      width: 100%; padding: 10px 14px; border: 1px solid var(--mica-border-dark);
      border-radius: 10px; background: var(--input-bg); color: #fff; font-size: 14px;
      transition: all 0.2s ease;
    }
    .form-row input:focus, .form-row textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); }
    .md-editor {
      width: 100%; min-height: clamp(520px, 70vh, 1100px); padding: 20px;
      font-family: 'Cascadia Code', 'Consolas', 'Monaco', monospace; font-size: 14px;
      background: var(--input-bg); border: 1px solid var(--mica-border-dark);
      border-radius: 12px; resize: vertical; line-height: 1.7; color: #fff;
      transition: all 0.2s ease;
      /* 细窄主题色滚动条，替掉深色背景上生硬的系统默认滚动条 */
      scrollbar-width: thin; scrollbar-color: rgba(59, 170, 255, 0.45) transparent;
    }
    .md-editor::-webkit-scrollbar { width: 10px; height: 10px; }
    .md-editor::-webkit-scrollbar-track { background: transparent; }
    .md-editor::-webkit-scrollbar-thumb {
      background-color: rgba(59, 170, 255, 0.35);
      border: 2px solid transparent; border-radius: 999px; background-clip: padding-box;
    }
    .md-editor::-webkit-scrollbar-thumb:hover {
      background-color: rgba(59, 170, 255, 0.65); background-clip: padding-box;
    }
    .md-editor:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); background: rgba(255, 255, 255, 0.15); }
    .md-preview {
      min-height: clamp(520px, 70vh, 1100px); padding: 20px; border: 1px solid var(--mica-border-dark);
      border-radius: 12px; background: var(--input-bg); line-height: 1.8; color: #fff;
      overflow-wrap: break-word;
    }
    .md-preview img { max-width: 100%; border-radius: 8px; margin: 8px 0; }
    .md-preview .video-embed { position: relative; width: 100%; height: 0; padding-top: 56.25%; margin: 12px 0; border-radius: 10px; overflow: hidden; background: rgba(0,0,0,0.3); }
    .md-preview .video-embed iframe, .md-preview .video-embed video { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
    /* 预览标题对齐前台 markdown.css 的主题色样式（后台用 --accent 作为主题色） */
    .md-preview h1, .md-preview h2, .md-preview h3 { margin: 16px 0 8px; font-weight: 700; }
    .md-preview h1 {
      background-image: linear-gradient(110deg, var(--accent) 15%, #fff 92%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .md-preview h2 { position: relative; padding-left: 0.85rem; }
    .md-preview h2::before {
      content: "";
      position: absolute;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 5px;
      height: 72%;
      border-radius: 999px;
      background: linear-gradient(to bottom, var(--accent), color-mix(in srgb, var(--accent) 45%, transparent));
    }
    .md-preview h3::before {
      content: "";
      display: inline-block;
      width: 0.5rem;
      height: 0.5rem;
      margin-right: 0.5rem;
      border-radius: 2px;
      background: var(--accent);
      vertical-align: 1px;
    }
    .md-preview p { margin: 8px 0; }
    .md-preview code { background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px; font-size: 13px; }
    .md-preview pre { background: rgba(0,0,0,0.3); padding: 12px; border-radius: 8px; overflow-x: auto; }
    .md-preview pre code { background: none; padding: 0; }
    .md-preview blockquote { border-left: 3px solid var(--accent); padding-left: 12px; color: var(--text-secondary); margin: 8px 0; }
    .md-preview .callout { border-left: 4px solid; padding: 12px 16px; margin: 12px 0; border-radius: 4px; }
    .md-preview .callout-note { border-color: #4a9eff; background: rgba(74,158,255,0.1); }
    .md-preview .callout-tip { border-color: #4aff88; background: rgba(74,255,136,0.08); }
    .md-preview .callout-important { border-color: #ffaa4a; background: rgba(255,170,74,0.1); }
    .md-preview .callout-warning { border-color: #ff4a4a; background: rgba(255,74,74,0.1); }
    .md-preview .callout-caution { border-color: #ff4a4a; background: rgba(255,74,74,0.15); }
    .md-preview a { color: var(--accent); text-decoration: underline; }
    .md-preview table { border-collapse: collapse; margin: 8px 0; }
    .md-preview th, .md-preview td { border: 1px solid var(--mica-border-dark); padding: 6px 12px; }

    /* ===== Markdown 插入工具栏 ===== */
    .md-toolbar {
      display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px;
      padding: 8px; border: 1px solid var(--mica-border-dark); border-radius: 10px;
      background: rgba(0, 0, 0, 0.15);
    }
    .md-toolbar button {
      min-width: 34px; height: 30px; padding: 0 10px;
      border: 1px solid var(--mica-border-dark); border-radius: 8px;
      background: var(--input-bg); color: var(--text-secondary);
      font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.15s ease;
    }
    .md-toolbar button:hover { border-color: var(--accent); color: #fff; background: var(--accent-light); }
    .md-toolbar button:active { transform: scale(0.94); }
    .md-toolbar .tb-sep { width: 1px; background: var(--mica-border-dark); margin: 2px 4px; }

    /* ===== 双栏实时预览 ===== */
    .editor-split { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; align-items: stretch; }
    .editor-split .md-editor { min-height: clamp(560px, 70vh, 1100px); height: clamp(560px, 70vh, 1100px); }
    .editor-split .md-preview {
      min-height: clamp(560px, 70vh, 1100px); height: clamp(560px, 70vh, 1100px); margin: 0;
      overflow-y: auto;
    }
    @media (max-width: 900px) { .editor-split { grid-template-columns: 1fr; } }

    /* ===== 字数统计 ===== */
    .editor-stats {
      display: flex; gap: 16px; margin-top: 10px; padding: 8px 12px;
      border-radius: 8px; background: rgba(0, 0, 0, 0.15);
      font-size: 12px; color: var(--text-secondary);
    }
    .editor-stats b { color: var(--accent); font-weight: 600; }
    .fm-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 20px; }
    .fm-item label { display: block; font-size: 13px; color: var(--text-secondary); margin-bottom: 6px; font-weight: 500; }
    .fm-item input, .fm-item textarea {
      width: 100%; padding: 10px 14px; border: 1px solid var(--mica-border-dark);
      border-radius: 10px; background: var(--input-bg); font-size: 14px;
      font-family: inherit; color: #fff; transition: all 0.2s ease;
    }
    .fm-item input::placeholder, .fm-item textarea::placeholder { color: var(--text-muted); }
    .fm-item input:focus, .fm-item textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); background: rgba(255, 255, 255, 0.15); }
    /* 分类/标签下拉选择：箭头钉在输入框左侧 */
    .tax-wrap { position: relative; }
    .tax-wrap input { padding-left: 34px; }
    .tax-arrow {
      position: absolute; left: 4px; top: 50%; transform: translateY(-50%);
      width: 26px; height: 26px; border: none; border-radius: 7px;
      background: transparent; color: var(--text-secondary); cursor: pointer;
      font-size: 13px; line-height: 1; display: flex; align-items: center; justify-content: center;
      transition: all 0.15s ease;
    }
    .tax-arrow:hover { background: rgba(255,255,255,0.12); color: #fff; }
    .tax-arrow.open { color: var(--accent); transform: translateY(-50%) rotate(180deg); }
    .tax-overlay { position: fixed; inset: 0; z-index: 40; }
    .tax-dropdown {
      position: absolute; top: calc(100% + 6px); left: 0; right: 0; z-index: 50;
      max-height: 220px; overflow-y: auto;
      background: rgba(30,30,36,0.97); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--mica-border-dark); border-radius: 10px;
      padding: 6px; box-shadow: 0 12px 32px rgba(0,0,0,0.45);
    }
    .tax-option { padding: 8px 10px; border-radius: 7px; font-size: 13px; color: var(--text-primary); cursor: pointer; transition: background 0.12s ease; }
    .tax-option:hover { background: var(--accent-glow); color: var(--accent); }
    .tax-option .tax-used { float: right; font-size: 11px; color: var(--text-muted); }
    .tax-empty { padding: 14px; text-align: center; font-size: 12px; color: var(--text-secondary); }
    .data-row { padding: 14px; margin-bottom: 12px; border-radius: 12px; background: rgba(255,255,255,0.04); border: 1px solid var(--mica-border); }

    /* ===== 番剧/书签管理响应式行 ===== */
    .anime-row-head { display: flex; gap: 10px; margin-bottom: 8px; }
    .anime-search-row { display: flex; gap: 10px; margin-bottom: 12px; }
    .anime-grid-5 { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr 1fr; gap: 8px; margin-bottom: 8px; }
    .anime-grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-bottom: 8px; }
    .bn-group-head { display: flex; gap: 8px; align-items: center; margin-bottom: 10px; }
    .bn-item-line { display: flex; gap: 8px; margin-bottom: 6px; }
    .bn-item-line:last-child { margin-bottom: 0; }
    .anime-row-head input, .anime-grid-5 input, .anime-grid-5 select,
    .anime-grid-3 input, .anime-search-row input,
    .bn-group-head input, .bn-item-line input {
      min-width: 0;
      padding: 8px 12px; border-radius: 8px;
      border: 1px solid var(--mica-border-dark); background: var(--input-bg);
      color: #fff; font-size: 12px; font-family: inherit;
    }
    .anime-row-head input:focus, .anime-grid-5 input:focus, .anime-grid-5 select:focus,
    .anime-grid-3 input:focus, .anime-search-row input:focus,
    .bn-group-head input:focus, .bn-item-line input:focus {
      outline: none; border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent-glow);
    }

    /* ===== 相册管理响应式行 ===== */
    .gallery-grid-4 { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 10px; margin-bottom: 8px; }
    .gallery-grid-3 { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 10px; margin-bottom: 8px; }
    .gallery-grid-4 input, .gallery-grid-3 input {
      min-width: 0;
      padding: 8px 12px; border-radius: 8px;
      border: 1px solid var(--mica-border-dark); background: var(--input-bg);
      color: #fff; font-size: 13px; font-family: inherit;
    }
    .gallery-grid-4 input:focus, .gallery-grid-3 input:focus {
      outline: none; border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent-glow);
    }

    /* ===== 相册列表：卡片网格（QQ 相册式）===== */
    .gal-album-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 14px; }
    .gal-album-card {
      min-width: 0; border-radius: 14px; overflow: hidden; cursor: pointer;
      background: rgba(255,255,255,0.06); border: 1px solid var(--mica-border-dark);
      transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }
    .gal-album-card:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: var(--mica-shadow); }
    .gal-album-cover { position: relative; aspect-ratio: 1 / 1; background: rgba(0,0,0,0.3); }
    .gal-album-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .gal-album-empty {
      position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
      font-size: 40px; font-weight: 700; color: var(--text-muted);
    }
    .gal-album-count {
      position: absolute; left: 8px; bottom: 8px; padding: 2px 8px; border-radius: 999px;
      font-size: 11px; color: #fff; background: rgba(0,0,0,0.6); pointer-events: none;
      -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px);
    }
    .gal-album-edit {
      position: absolute; right: 8px; top: 8px; z-index: 2;
      width: 26px; height: 26px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 13px; color: #fff; background: rgba(0,0,0,0.6); cursor: pointer;
      -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px);
    }
    .gal-album-edit:hover { background: var(--accent); }
    .gal-album-meta { padding: 10px 12px; min-width: 0; }
    .gal-album-name { font-size: 14px; font-weight: 600; color: #fff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .gal-album-id { font-size: 11px; color: var(--text-muted); margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    /* ===== 相册内照片网格 ===== */
    .gal-photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 10px; }
    .gal-photo {
      position: relative; min-width: 0; aspect-ratio: 1 / 1;
      border-radius: 10px; overflow: hidden; cursor: pointer; background: rgba(0,0,0,0.3);
    }
    .gal-photo img { width: 100%; height: 100%; object-fit: cover; display: block; opacity: 0; transition: opacity 0.4s ease-out; }
    .gal-photo img.loaded { opacity: 1; }
    .gal-photo.selected { outline: 2px solid var(--accent); outline-offset: -2px; }
    .gal-photo-load {
      position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
      color: var(--text-muted); font-size: 18px;
    }
    .gal-gif-badge {
      position: absolute; right: 6px; top: 6px; padding: 2px 7px; border-radius: 6px;
      font-size: 10px; font-weight: 700; letter-spacing: 0.5px; color: #fff;
      background: rgba(59,170,255,0.9); pointer-events: none;
    }
    .gal-cover-tag {
      position: absolute; left: 50%; top: 6px; transform: translateX(-50%);
      padding: 2px 7px; border-radius: 6px; font-size: 10px; font-weight: 700;
      color: #fff; background: rgba(255,159,64,0.92); pointer-events: none;
    }
    .gal-check {
      position: absolute; left: 6px; top: 6px; z-index: 3;
      width: 24px; height: 24px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 13px; font-weight: 700; color: #fff;
      border: 2px solid rgba(255,255,255,0.75); background: rgba(0,0,0,0.35);
      -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px);
    }
    .gal-check.on { background: var(--accent); border-color: #fff; }
    .gal-photo-actions {
      position: absolute; left: 0; right: 0; bottom: 0; display: flex; gap: 6px; padding: 6px;
      background: linear-gradient(to top, rgba(0,0,0,0.75), rgba(0,0,0,0));
      opacity: 0; transition: opacity 0.15s ease;
    }
    .gal-photo:hover .gal-photo-actions { opacity: 1; }
    @media (hover: none) { .gal-photo-actions { opacity: 1; } }
    .gal-act {
      flex: 1; padding: 5px 6px; border-radius: 7px; font-size: 11px; cursor: pointer;
      border: 1px solid rgba(255,255,255,0.25); background: rgba(0,0,0,0.45); color: #fff;
    }
    .gal-act:hover { background: var(--accent); border-color: var(--accent); }
    .gal-act-danger:hover { background: rgba(220,60,60,0.9); border-color: rgba(220,60,60,0.9); }

    /* ===== 照片大图预览浮层（动图在这里播放）===== */
    .gal-preview {
      position: fixed; inset: 0; z-index: 2000; padding: 20px; cursor: zoom-out;
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px;
      background: rgba(0,0,0,0.85);
    }
    .gal-preview img { max-width: 100%; max-height: 80vh; object-fit: contain; border-radius: 10px; }
    .gal-preview-bar { display: flex; align-items: center; gap: 14px; max-width: 100%; }
    .gal-preview-name {
      color: var(--text-secondary); font-size: 12px; max-width: 60vw;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }

    /* ===== 按钮 ===== */
    .btn {
      padding: 8px 18px; border: 1px solid var(--mica-border-dark);
      border-radius: 10px; background: var(--input-bg); color: var(--text-primary);
      cursor: pointer; font-size: 14px; transition: all 0.2s ease; font-weight: 500;
    }
    .btn:hover { border-color: var(--accent); color: #fff; background: var(--accent-light); }
    .btn-primary {
      background: linear-gradient(135deg, #3BAAFF 0%, #7DD3FC 100%);
      color: #fff; border-color: transparent; box-shadow: 0 4px 12px var(--accent-glow);
    }
    .btn-primary:hover { color: #fff; transform: translateY(-1px); box-shadow: 0 6px 18px var(--accent-glow); }
    .btn-danger { border-color: rgba(255, 77, 79, 0.4); color: #ff7875; }
    .btn-danger:hover { background: rgba(255, 77, 79, 0.15); color: #ff7875; border-color: #ff4d4f; }
    .btn-sm { padding: 5px 14px; font-size: 13px; }

    /* ===== 表格 ===== */
    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; padding: 14px 16px; border-bottom: 1px solid var(--mica-border-dark); color: var(--text-secondary); font-weight: 600; font-size: 13px; }
    td { padding: 14px 16px; border-bottom: 1px solid rgba(255, 255, 255, 0.06); color: var(--text-primary); }
    tr:hover td { background: rgba(255, 255, 255, 0.05); }
    .tag { display: inline-block; padding: 3px 10px; border-radius: 6px; font-size: 12px; font-weight: 500; white-space: nowrap; }
    .tag-draft { background: rgba(255, 255, 255, 0.1); color: var(--text-secondary); }
    .tag-published { background: rgba(82, 196, 26, 0.15); color: #73d13d; border: 1px solid rgba(82, 196, 26, 0.3); }
    .tag-pinned { background: rgba(250, 173, 20, 0.15); color: #ffc53d; border: 1px solid rgba(250, 173, 20, 0.3); }

    /* ===== 文章卡片（仅手机端显示，桌面端用表格） ===== */
    .post-cards { display: none; }

    /* ===== Toast ===== */
    .toast {
      position: fixed; top: 24px; left: 50%; transform: translateX(-50%);
      padding: 12px 24px; border-radius: 12px; color: #fff; font-size: 14px;
      z-index: 9999; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      animation: toast-in 0.3s ease; font-weight: 500;
    }
    .toast-success { background: rgba(82, 196, 26, 0.9); border: 1px solid rgba(82, 196, 26, 0.5); }
    .toast-error { background: rgba(255, 77, 79, 0.9); border: 1px solid rgba(255, 77, 79, 0.5); }
    .toast-warning { background: rgba(250, 173, 20, 0.9); border: 1px solid rgba(250, 173, 20, 0.5); }
    .toast-info { background: rgba(24, 144, 255, 0.9); border: 1px solid rgba(24, 144, 255, 0.5); }
    @keyframes toast-in { from { opacity: 0; transform: translate(-50%, -20px); } to { opacity: 1; transform: translate(-50%, 0); } }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

    /* ===== 图片库 ===== */
    .image-lib-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 14px; margin-top: 16px;
    }
    .image-lib-card {
      position: relative; border-radius: 12px; overflow: hidden;
      background: var(--card-bg, rgba(255,255,255,0.06));
      border: 1px solid var(--border-color, rgba(255,255,255,0.1));
      transition: transform 0.2s, border-color 0.2s;
    }
    .image-lib-card:hover { transform: translateY(-3px); border-color: var(--accent); }
    .image-lib-check {
      position: absolute; top: 8px; left: 8px; z-index: 2;
      width: 24px; height: 24px; border-radius: 6px;
      background: rgba(0,0,0,0.55); display: flex; align-items: center; justify-content: center;
    }
    .image-lib-check input { margin: 0; accent-color: var(--accent); cursor: pointer; }
    .image-lib-thumb {
      display: block; aspect-ratio: 16/9; overflow: hidden;
      background: rgba(0,0,0,0.25);
    }
    .image-lib-thumb img {
      width: 100%; height: 100%; object-fit: cover; display: block;
      transition: transform 0.3s;
    }
    .image-lib-card:hover .image-lib-thumb img { transform: scale(1.06); }
    .image-lib-name {
      font-size: 12px; font-weight: 600; color: var(--text-primary, #e6edf3);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }

    /* ===== 通用弹窗 ===== */
    .modal-mask {
      position: fixed; inset: 0; z-index: 1000;
      background: rgba(0,0,0,0.55); backdrop-filter: blur(4px);
      display: flex; align-items: center; justify-content: center; padding: 20px;
    }
    .modal-card {
      width: 100%; max-width: 720px; max-height: 85vh;
      display: flex; flex-direction: column;
      background: var(--card-bg-strong, #16161f);
      border: 1px solid var(--border-color, rgba(255,255,255,0.12));
      border-radius: 16px; overflow: hidden;
      box-shadow: 0 24px 60px rgba(0,0,0,0.45);
    }
    .modal-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 16px 20px; border-bottom: 1px solid var(--border-color, rgba(255,255,255,0.1));
    }
    .modal-body { padding: 16px 20px; overflow-y: auto; min-height: 0; }

    /* ===== 历史版本 ===== */
    .version-list { display: flex; flex-direction: column; gap: 8px; }
    .version-item {
      display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
      padding: 10px 12px; border-radius: 10px;
      background: rgba(255,255,255,0.05);
      border: 1px solid var(--border-color, rgba(255,255,255,0.08));
      color: var(--text-secondary); font-size: 14px;
    }
    .version-preview {
      margin: 14px 0 0; padding: 14px;
      max-height: 340px; overflow: auto;
      border-radius: 10px; background: rgba(0,0,0,0.3);
      border: 1px solid var(--border-color, rgba(255,255,255,0.08));
      font-size: 12.5px; line-height: 1.6; color: var(--text-primary, #e6edf3);
      white-space: pre-wrap; word-break: break-word;
    }

    .checkbox-group { display: flex; gap: 16px; align-items: center; height: 36px; }
    .checkbox-group label { display: flex; align-items: center; gap: 6px; margin: 0; font-size: 14px; color: var(--text-primary); cursor: pointer; }
    .checkbox-group input { width: 16px; height: 16px; cursor: pointer; accent-color: var(--accent); }

    /* 滚动条：全部隐藏，保留滚动功能 */
    html, body, .content, .sidebar-menu, .modal-body, .md-preview, .tax-dropdown {
      scrollbar-width: none; -ms-overflow-style: none;
    }
    html::-webkit-scrollbar, body::-webkit-scrollbar,
    .content::-webkit-scrollbar, .sidebar-menu::-webkit-scrollbar,
    .modal-body::-webkit-scrollbar, .md-preview::-webkit-scrollbar,
    .tax-dropdown::-webkit-scrollbar { width: 0; height: 0; display: none; }
    html, body { overflow-x: hidden; }
    .content { overflow-x: hidden; }
    .layout { max-width: 100vw; }

    /* ===== 移动端适配 ===== */
    @media (max-width: 768px) {
      .menu-toggle { display: flex; }
      .sidebar-backdrop { display: block; }
      .sidebar {
        position: fixed; top: 0; left: 0; bottom: 0; width: 260px;
        z-index: 999; transform: translateX(-100%);
        transition: transform 0.3s ease; box-shadow: 4px 0 24px rgba(0,0,0,0.4);
      }
      .sidebar.open { transform: translateX(0); }
      .header { padding: 0 16px; height: 56px; }
      .header-title { font-size: 16px; }
      .content { padding: 8px; }
      .stat-grid { grid-template-columns: 1fr; gap: 12px; margin-bottom: 16px; }
      .stat-card { padding: 16px; gap: 12px; }
      .stat-icon { width: 44px; height: 44px; font-size: 22px; }
      .stat-info .value { font-size: 24px; }
      .quick-grid { grid-template-columns: 1fr; gap: 12px; }
      .quick-card { padding: 16px; }
      .fm-grid { grid-template-columns: 1fr !important; gap: 12px; }
      /* 编辑框加高+随内容自动长高，无内部滚动条 */
      .editor-split .md-editor, .md-editor {
        min-height: 55vh; height: auto; padding: 12px; font-size: 14px;
        field-sizing: content; overflow-y: hidden;
      }
      /* 工具栏更紧凑 */
      .md-toolbar { gap: 4px; padding: 6px; }
      .md-toolbar button { min-width: 30px; height: 30px; font-size: 13px; padding: 0 6px; }
      .editor-toolbar { gap: 8px; }
      .btn { padding: 7px 14px; font-size: 13px; }
      table { font-size: 12px; }
      th, td { padding: 10px 8px; }
      .sidebar-logo { height: 56px; padding: 0 20px; font-size: 15px; }
      .sidebar-menu { padding: 12px 10px; }
      .menu-item { padding: 11px 14px; font-size: 13px; }
      .checkbox-group { flex-wrap: wrap; height: auto; gap: 10px; }
      .data-row { padding: 12px; }
      /* 番剧管理：手机端改单列/双列，防止飞出屏幕（!important 覆盖内联样式） */
      .anime-row-head { flex-wrap: wrap; }
      .anime-row-head input { flex: 1 1 100% !important; }
      .anime-row-head .btn { flex: 1 1 100% !important; }
      .anime-search-row { flex-wrap: wrap; }
      .anime-search-row input { flex: 1 1 100% !important; }
      .anime-search-row .btn { flex: 1 1 100% !important; }
      .anime-grid-5 { grid-template-columns: 1fr 1fr !important; }
      .anime-grid-3 { grid-template-columns: 1fr !important; }
      /* 封面 URL 占满整行，不再被挤在半列里；评分/状态/进度/总量保持 2×2 */
      .anime-grid-5 > :first-child { grid-column: 1 / -1; }
      /* 书签管理：手机端纵向堆叠 */
      .bn-group-head { flex-wrap: wrap; }
      .bn-group-head input { flex: 1 1 calc(50% - 4px) !important; width: auto !important; }
      .bn-group-head .btn { flex: 1 1 auto !important; }
      .bn-item-line { flex-wrap: wrap; }
      .bn-item-line input { flex: 1 1 100% !important; width: 100% !important; }
      .bn-item-line .btn { flex: 1 1 100% !important; }
      /* 相册管理：手机端改双列/单列，防止飞出屏幕 */
      .gallery-grid-4 { grid-template-columns: 1fr 1fr !important; }
      .gallery-grid-3 { grid-template-columns: 1fr !important; }
      /* 相册卡片与照片格子：手机端缩小格子，保证一屏能放两列以上 */
      .gal-album-grid { grid-template-columns: repeat(auto-fill, minmax(128px, 1fr)) !important; gap: 10px; }
      .gal-photo-grid { grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)) !important; gap: 8px; }
      .editor-toolbar span[style*="margin-left:auto"] { margin-left: 0 !important; flex-basis: 100%; }
      /* 文章列表：手机端表格换卡片，消灭横向滚动 */
      .posts-table-card table { display: none; }
      .post-cards { display: flex; flex-direction: column; gap: 10px; }
      .post-card { padding: 12px; border-radius: 10px; background: rgba(255,255,255,0.04); border: 1px solid var(--mica-border); }
      .post-card-head { display: flex; align-items: flex-start; gap: 8px; margin-bottom: 8px; }
      .post-card-head input[type="checkbox"] { margin-top: 3px; flex-shrink: 0; width: 16px; height: 16px; accent-color: var(--accent); }
      .post-card-title { font-size: 14px; font-weight: 600; color: #fff; word-break: break-all; line-height: 1.4; }
      .post-card-meta { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 6px; }
      .post-card-info { font-size: 12px; color: var(--text-secondary); margin-bottom: 10px; word-break: break-all; }
      .post-card-actions { display: flex; gap: 8px; }
      .post-card-actions .btn { flex: 1; text-align: center; }
      /* 编辑器/动态页防溢出兜底 */
      .editor-stats { flex-wrap: wrap; gap: 10px; }
      input, select, textarea { max-width: 100%; }
      .mica-card { padding: 12px !important; }
    }
    @media (max-width: 480px) {
      .header-title { font-size: 14px; }
      .content { padding: 6px; }
      .editor-split .md-editor, .md-editor { min-height: 50vh; }
      .btn-primary { padding: 7px 12px; font-size: 12px; }
      /* 番剧/漫画编辑行：缩略图与中文名同一行，封面缩略图不再独占一行留白 */
      .anime-row-head { gap: 8px; }
      .anime-row-head input:first-of-type { flex: 1 1 calc(100% - 48px) !important; }
      .anime-grid-5 { gap: 6px; }
      /* 保存/添加按钮挤不下时允许换行 */
      .editor-toolbar { flex-wrap: wrap; }
    }
  </style>
</head>
<body>
  <div id="app">
    <div class="app-loading">正在加载管理后台...</div>
  </div>

  <script type="application/json" id="ba-wallpapers-data" set:html={JSON.stringify(baWallpapersDesktop)}></script>
  <script type="application/json" id="ba-wallpapers-mobile-data" set:html={JSON.stringify(baWallpapersMobile)}></script>
