---
export const prerender = false;
import { Font } from "astro:assets";
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>博客管理后台</title>
  <Font cssVariable="--font-lxgw-wenkai" preload={true} />
  <style is:global>
    :root {
      --mica-blur: blur(12px) saturate(1.4);
      --mica-border: rgba(255, 255, 255, 0.18);
      --mica-border-dark: rgba(255, 255, 255, 0.12);
      --mica-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
      --mica-shadow-hover: 0 16px 48px rgba(0, 0, 0, 0.2);
      --accent: #3BAAFF;
      --accent-glow: rgba(59, 170, 255, 0.35);
      --accent-light: rgba(59, 170, 255, 0.15);
      --text-primary: rgba(255, 255, 255, 0.95);
      --text-secondary: rgba(255, 255, 255, 0.65);
      --text-muted: rgba(255, 255, 255, 0.45);
      --card-bg: rgba(23, 23, 23, 0.6);
      --card-bg-hover: rgba(23, 23, 23, 0.7);
      --sidebar-bg: rgba(23, 23, 23, 0.65);
      --input-bg: rgba(255, 255, 255, 0.08);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { height: 100%; width: 100%; }
    body {
      font-family: var(--font-lxgw-wenkai, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei', Roboto, sans-serif);
      background: #0a0a14 url('https://t.alcy.cc/pc') center/cover fixed;
      color: var(--text-primary);
      overflow: hidden;
    }
    body::after {
      content: '';
      position: fixed;
      inset: 0;
      background: linear-gradient(135deg, rgba(10, 10, 20, 0.55) 0%, rgba(20, 15, 35, 0.45) 50%, rgba(10, 10, 20, 0.55) 100%);
      backdrop-filter: blur(2px);
      z-index: -1;
    }
    #app { min-height: 100vh; }
    .app-loading {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-secondary);
      font-size: 16px;
      backdrop-filter: blur(8px);
    }

    /* ===== 登录页 ===== */
    .login-wrap {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }
    .login-card {
      width: 420px;
      padding: 48px 40px;
      background: var(--card-bg);
      backdrop-filter: var(--mica-blur);
      -webkit-backdrop-filter: var(--mica-blur);
      border-radius: 20px;
      border: 1px solid var(--mica-border);
      box-shadow: 0 24px 64px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.15);
      position: relative;
      z-index: 1;
      animation: card-in 0.5s ease;
    }
    @keyframes card-in { from { opacity: 0; transform: translateY(20px) scale(0.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
    .login-logo { text-align: center; font-size: 56px; margin-bottom: 16px; filter: drop-shadow(0 4px 12px rgba(59, 170, 255, 0.5)); }
    .login-title { text-align: center; font-size: 26px; font-weight: 700; margin-bottom: 8px; color: #fff; letter-spacing: 1px; }
    .login-sub { text-align: center; color: var(--text-secondary); font-size: 14px; margin-bottom: 36px; }
    .login-input {
      width: 100%; height: 50px; padding: 0 18px; font-size: 15px;
      border-radius: 12px; border: 1px solid var(--mica-border-dark);
      background: var(--input-bg); color: #fff; margin-bottom: 18px;
      box-sizing: border-box; outline: none; transition: all 0.25s ease;
    }
    .login-input::placeholder { color: var(--text-muted); }
    .login-input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow), inset 0 1px 0 rgba(255, 255, 255, 0.1); background: rgba(255, 255, 255, 0.15); }
    .login-btn {
      width: 100%; height: 50px; font-size: 16px; font-weight: 600;
      color: #fff; background: linear-gradient(135deg, #3BAAFF 0%, #7DD3FC 100%);
      border: none; border-radius: 12px; cursor: pointer;
      transition: all 0.25s ease; letter-spacing: 4px;
      box-shadow: 0 4px 16px var(--accent-glow);
    }
    .login-btn:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 8px 24px var(--accent-glow); }
    .login-btn:active:not(:disabled) { transform: translateY(0); }
    .login-btn:disabled { opacity: 0.6; cursor: not-allowed; }

    /* ===== 主布局 ===== */
    .layout { display: flex; height: 100vh; overflow: hidden; }
    .sidebar {
      width: 240px; background: var(--sidebar-bg);
      backdrop-filter: var(--mica-blur); -webkit-backdrop-filter: var(--mica-blur);
      color: var(--text-primary); display: flex; flex-direction: column;
      border-right: 1px solid var(--mica-border-dark);
      min-height: 0;
    }
    .sidebar-logo {
      height: 68px; display: flex; align-items: center; gap: 12px; padding: 0 24px;
      font-size: 17px; font-weight: 700; border-bottom: 1px solid var(--mica-border-dark);
      letter-spacing: 0.5px;
    }
    .sidebar-menu { flex: 1; min-height: 0; overflow-y: auto; padding: 20px 14px; scrollbar-width: thin; scrollbar-color: rgba(59, 170, 255, 0.5) transparent; }
    .sidebar-menu::-webkit-scrollbar { width: 6px; }
    .sidebar-menu::-webkit-scrollbar-track { background: transparent; }
    .sidebar-menu::-webkit-scrollbar-thumb { background: rgba(59, 170, 255, 0.4); border-radius: 3px; }
    .sidebar-menu::-webkit-scrollbar-thumb:hover { background: rgba(59, 170, 255, 0.65); }
    .menu-item {
      padding: 13px 18px; margin-bottom: 6px; border-radius: 12px; cursor: pointer;
      display: flex; align-items: center; gap: 12px; transition: all 0.2s ease;
      color: var(--text-secondary); font-size: 14px; font-weight: 500;
    }
    .menu-item:hover { background: rgba(255, 255, 255, 0.08); color: #fff; }
    .menu-item.active {
      background: linear-gradient(135deg, rgba(59, 170, 255, 0.35), rgba(167, 139, 250, 0.25));
      color: #fff; box-shadow: 0 2px 12px var(--accent-glow);
      border: 1px solid rgba(59, 170, 255, 0.4);
    }
    .sidebar-footer { padding: 16px; border-top: 1px solid var(--mica-border-dark); }
    .logout-btn {
      width: 100%; padding: 13px 18px; border: none; background: none;
      color: var(--text-secondary); cursor: pointer; border-radius: 12px;
      font-size: 14px; text-align: left; display: flex; align-items: center; gap: 12px;
      transition: all 0.2s ease; font-weight: 500;
    }
    .logout-btn:hover { background: rgba(255, 77, 79, 0.12); color: #ff7875; }

    .menu-toggle {
      display: none;
      background: none; border: 1px solid var(--mica-border-dark);
      color: #fff; font-size: 20px; cursor: pointer;
      width: 40px; height: 40px; border-radius: 10px;
      align-items: center; justify-content: center;
    }
    .menu-toggle:hover { border-color: var(--accent); background: var(--accent-light); }
    .sidebar-backdrop {
      display: none;
      position: fixed; inset: 0; background: rgba(0, 0, 0, 0.5);
      z-index: 998; backdrop-filter: blur(2px);
    }

    .main { flex: 1; display: flex; flex-direction: column; min-width: 0; min-height: 0; }
    .header {
      height: 68px; background: var(--sidebar-bg);
      backdrop-filter: var(--mica-blur); -webkit-backdrop-filter: var(--mica-blur);
      border-bottom: 1px solid var(--mica-border-dark);
      display: flex; align-items: center; justify-content: space-between; padding: 0 32px;
    }
    .header-title { font-size: 20px; font-weight: 700; letter-spacing: 0.5px; }
    .content { flex: 1; padding: 32px; overflow-y: auto; }

    /* ===== Mica 卡片 ===== */
    .mica-card {
      background: var(--card-bg);
      backdrop-filter: var(--mica-blur); -webkit-backdrop-filter: var(--mica-blur);
      border-radius: 16px; border: 1px solid var(--mica-border);
      box-shadow: var(--mica-shadow), inset 0 1px 0 rgba(255, 255, 255, 0.1);
      transition: all 0.25s ease;
    }
    .mica-card:hover { background: var(--card-bg-hover); box-shadow: var(--mica-shadow-hover); }

    .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 28px; }
    .stat-card { padding: 24px; display: flex; align-items: center; gap: 18px; }
    .stat-icon {
      width: 56px; height: 56px; border-radius: 14px;
      display: flex; align-items: center; justify-content: center; font-size: 28px;
      background: var(--accent-light); border: 1px solid rgba(59, 170, 255, 0.3);
    }
    .stat-info .label { font-size: 13px; color: var(--text-secondary); margin-bottom: 4px; }
    .stat-info .value { font-size: 30px; font-weight: 700; color: #fff; }

    .quick-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; }
    .quick-card { padding: 24px; cursor: pointer; }
    .quick-card:hover { transform: translateY(-3px); border-color: var(--accent); }
    .quick-card h4 { font-size: 16px; margin-bottom: 8px; display: flex; align-items: center; gap: 8px; color: #fff; }
    .quick-card p { color: var(--text-secondary); font-size: 13px; line-height: 1.6; }

    /* ===== 编辑器 ===== */
    .editor-toolbar { display: flex; gap: 12px; margin-bottom: 20px; align-items: center; flex-wrap: wrap; }
    .form-row { margin-bottom: 14px; }
    .form-row label { display: block; font-size: 13px; color: var(--text-secondary); margin-bottom: 6px; font-weight: 500; }
    .form-row input, .form-row textarea {
      width: 100%; padding: 10px 14px; border: 1px solid var(--mica-border-dark);
      border-radius: 10px; background: var(--input-bg); color: #fff; font-size: 14px;
      transition: all 0.2s ease;
    }
    .form-row input:focus, .form-row textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); }
    .md-editor {
      width: 100%; min-height: 500px; padding: 20px;
      font-family: 'Cascadia Code', 'Consolas', 'Monaco', monospace; font-size: 14px;
      background: var(--input-bg); border: 1px solid var(--mica-border-dark);
      border-radius: 12px; resize: vertical; line-height: 1.7; color: #fff;
      transition: all 0.2s ease;
    }
    .md-editor:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); background: rgba(255, 255, 255, 0.15); }
    .md-preview {
      min-height: 500px; padding: 20px; border: 1px solid var(--mica-border-dark);
      border-radius: 12px; background: var(--input-bg); line-height: 1.8; color: #fff;
      overflow-wrap: break-word;
    }
    .md-preview img { max-width: 100%; border-radius: 8px; margin: 8px 0; }
    .md-preview .video-embed { position: relative; width: 100%; height: 0; padding-top: 56.25%; margin: 12px 0; border-radius: 10px; overflow: hidden; background: rgba(0,0,0,0.3); }
    .md-preview .video-embed iframe, .md-preview .video-embed video { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
    .md-preview h1, .md-preview h2, .md-preview h3 { margin: 16px 0 8px; }
    .md-preview p { margin: 8px 0; }
    .md-preview code { background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px; font-size: 13px; }
    .md-preview pre { background: rgba(0,0,0,0.3); padding: 12px; border-radius: 8px; overflow-x: auto; }
    .md-preview pre code { background: none; padding: 0; }
    .md-preview blockquote { border-left: 3px solid var(--accent); padding-left: 12px; color: var(--text-secondary); margin: 8px 0; }
    .md-preview .callout { border-left: 4px solid; padding: 12px 16px; margin: 12px 0; border-radius: 4px; }
    .md-preview .callout-note { border-color: #4a9eff; background: rgba(74,158,255,0.1); }
    .md-preview .callout-tip { border-color: #4aff88; background: rgba(74,255,136,0.08); }
    .md-preview .callout-important { border-color: #ffaa4a; background: rgba(255,170,74,0.1); }
    .md-preview .callout-warning { border-color: #ff4a4a; background: rgba(255,74,74,0.1); }
    .md-preview .callout-caution { border-color: #ff4a4a; background: rgba(255,74,74,0.15); }
    .md-preview a { color: var(--accent); text-decoration: underline; }
    .md-preview table { border-collapse: collapse; margin: 8px 0; }
    .md-preview th, .md-preview td { border: 1px solid var(--mica-border-dark); padding: 6px 12px; }
    .fm-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 20px; }
    .fm-item label { display: block; font-size: 13px; color: var(--text-secondary); margin-bottom: 6px; font-weight: 500; }
    .fm-item input, .fm-item textarea {
      width: 100%; padding: 10px 14px; border: 1px solid var(--mica-border-dark);
      border-radius: 10px; background: var(--input-bg); font-size: 14px;
      font-family: inherit; color: #fff; transition: all 0.2s ease;
    }
    .fm-item input::placeholder, .fm-item textarea::placeholder { color: var(--text-muted); }
    .fm-item input:focus, .fm-item textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); background: rgba(255, 255, 255, 0.15); }
    .data-row { padding: 14px; margin-bottom: 12px; border-radius: 12px; background: rgba(255,255,255,0.04); border: 1px solid var(--mica-border); }

    /* ===== 按钮 ===== */
    .btn {
      padding: 8px 18px; border: 1px solid var(--mica-border-dark);
      border-radius: 10px; background: var(--input-bg); color: var(--text-primary);
      cursor: pointer; font-size: 14px; transition: all 0.2s ease; font-weight: 500;
    }
    .btn:hover { border-color: var(--accent); color: #fff; background: var(--accent-light); }
    .btn-primary {
      background: linear-gradient(135deg, #3BAAFF 0%, #7DD3FC 100%);
      color: #fff; border-color: transparent; box-shadow: 0 4px 12px var(--accent-glow);
    }
    .btn-primary:hover { color: #fff; transform: translateY(-1px); box-shadow: 0 6px 18px var(--accent-glow); }
    .btn-danger { border-color: rgba(255, 77, 79, 0.4); color: #ff7875; }
    .btn-danger:hover { background: rgba(255, 77, 79, 0.15); color: #ff7875; border-color: #ff4d4f; }
    .btn-sm { padding: 5px 14px; font-size: 13px; }

    /* ===== 表格 ===== */
    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; padding: 14px 16px; border-bottom: 1px solid var(--mica-border-dark); color: var(--text-secondary); font-weight: 600; font-size: 13px; }
    td { padding: 14px 16px; border-bottom: 1px solid rgba(255, 255, 255, 0.06); color: var(--text-primary); }
    tr:hover td { background: rgba(255, 255, 255, 0.05); }
    .tag { display: inline-block; padding: 3px 10px; border-radius: 6px; font-size: 12px; font-weight: 500; }
    .tag-draft { background: rgba(255, 255, 255, 0.1); color: var(--text-secondary); }
    .tag-published { background: rgba(82, 196, 26, 0.15); color: #73d13d; border: 1px solid rgba(82, 196, 26, 0.3); }
    .tag-pinned { background: rgba(250, 173, 20, 0.15); color: #ffc53d; border: 1px solid rgba(250, 173, 20, 0.3); }

    /* ===== Toast ===== */
    .toast {
      position: fixed; top: 24px; left: 50%; transform: translateX(-50%);
      padding: 12px 24px; border-radius: 12px; color: #fff; font-size: 14px;
      z-index: 9999; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      animation: toast-in 0.3s ease; font-weight: 500;
    }
    .toast-success { background: rgba(82, 196, 26, 0.9); border: 1px solid rgba(82, 196, 26, 0.5); }
    .toast-error { background: rgba(255, 77, 79, 0.9); border: 1px solid rgba(255, 77, 79, 0.5); }
    .toast-warning { background: rgba(250, 173, 20, 0.9); border: 1px solid rgba(250, 173, 20, 0.5); }
    .toast-info { background: rgba(24, 144, 255, 0.9); border: 1px solid rgba(24, 144, 255, 0.5); }
    @keyframes toast-in { from { opacity: 0; transform: translate(-50%, -20px); } to { opacity: 1; transform: translate(-50%, 0); } }

    .checkbox-group { display: flex; gap: 16px; align-items: center; height: 36px; }
    .checkbox-group label { display: flex; align-items: center; gap: 6px; margin: 0; font-size: 14px; color: var(--text-primary); cursor: pointer; }
    .checkbox-group input { width: 16px; height: 16px; cursor: pointer; accent-color: var(--accent); }

    /* 滚动条 */
    .content { scrollbar-width: thin; scrollbar-color: rgba(59, 170, 255, 0.45) transparent; }
    .content::-webkit-scrollbar { width: 8px; }
    .content::-webkit-scrollbar-track { background: transparent; }
    .content::-webkit-scrollbar-thumb { background: rgba(59, 170, 255, 0.35); border-radius: 4px; }
    .content::-webkit-scrollbar-thumb:hover { background: rgba(59, 170, 255, 0.6); }

    /* ===== 移动端适配 ===== */
    @media (max-width: 768px) {
      .menu-toggle { display: flex; }
      .sidebar-backdrop { display: block; }
      .sidebar {
        position: fixed; top: 0; left: 0; bottom: 0; width: 260px;
        z-index: 999; transform: translateX(-100%);
        transition: transform 0.3s ease; box-shadow: 4px 0 24px rgba(0,0,0,0.4);
      }
      .sidebar.open { transform: translateX(0); }
      .header { padding: 0 16px; height: 56px; }
      .header-title { font-size: 16px; }
      .content { padding: 16px; }
      .stat-grid { grid-template-columns: 1fr; gap: 12px; margin-bottom: 16px; }
      .stat-card { padding: 16px; gap: 12px; }
      .stat-icon { width: 44px; height: 44px; font-size: 22px; }
      .stat-info .value { font-size: 24px; }
      .quick-grid { grid-template-columns: 1fr; gap: 12px; }
      .quick-card { padding: 16px; }
      .fm-grid { grid-template-columns: 1fr; gap: 12px; }
      .md-editor { min-height: 300px; padding: 14px; font-size: 13px; }
      .editor-toolbar { gap: 8px; }
      .btn { padding: 7px 14px; font-size: 13px; }
      table { font-size: 12px; }
      th, td { padding: 10px 8px; }
      .sidebar-logo { height: 56px; padding: 0 20px; font-size: 15px; }
      .sidebar-menu { padding: 12px 10px; }
      .menu-item { padding: 11px 14px; font-size: 13px; }
      .checkbox-group { flex-wrap: wrap; height: auto; gap: 10px; }
      .data-row { padding: 12px; }
    }
    @media (max-width: 480px) {
      .header-title { font-size: 14px; }
      .content { padding: 12px; }
      .md-editor { min-height: 240px; }
      .btn-primary { padding: 7px 12px; font-size: 12px; }
    }
  </style>
</head>
<body>
  <div id="app">
    <div class="app-loading">正在加载管理后台...</div>
  </div>

  <script>
    import { createApp, ref, reactive, computed, onMounted, h } from 'vue/dist/vue.esm-bundler.js';
    import { marked } from 'marked';

    // 随机蔚蓝档案壁纸（和前台一致）
    var baWallpapers = [];
    for (var i = 1; i <= 20; i++) {
      var ext = (i === 1 || i === 2 || i === 15) ? 'png' : 'jpg';
      baWallpapers.push('/assets/ba-wallpaper-' + i + '.' + ext);
    }
    var bgUrl = baWallpapers[Math.floor(Math.random() * baWallpapers.length)] + '?_t=' + Date.now();
    document.body.style.backgroundImage = "url('" + bgUrl + "')";

    // 简单的 Toast 通知
    const toasts = ref([]);
    let toastId = 0;
    function showToast(message, type) {
      const id = ++toastId;
      toasts.value.push({ id, message, type: type || 'info' });
      setTimeout(() => {
        toasts.value = toasts.value.filter(t => t.id !== id);
      }, 3000);
    }

    // ===== Markdown 语法速查（详细版，三个编辑器共用）=====
    var mdHelpHtml =
      '<div style="font-size:12px;line-height:1.9;color:var(--text-secondary);background:rgba(0,0,0,0.15);padding:14px 18px;border-radius:8px;margin-top:8px">' +

      '<div style="color:var(--accent);font-weight:600;margin:6px 0 2px">▎基础语法</div>' +
      '<div><b>标题：</b><code># 一级</code> <code>## 二级</code> <code>### 三级</code></div>' +
      '<div><b>加粗：</b><code>**文字**</code> <b>斜体：</b><code>*文字*</code> <b>删除线：</b><code>~~文字~~</code> <b>行内代码：</b><code>`代码`</code></div>' +
      '<div><b>链接：</b><code>[文字](https://url)</code> <b>图片：</b><code>![描述](图片URL)</code></div>' +
      '<div><b>引用：</b><code>&gt; 引用文字</code> <b>分割线：</b><code>---</code></div>' +
      '<div><b>无序列表：</b><code>- 项目</code> <b>有序列表：</b><code>1. 项目</code></div>' +
      '<div><b>表格：</b><code>| 列1 | 列2 |</code> 换行 <code>| --- | --- |</code> 换行 <code>| a | b |</code></div>' +

      '<div style="color:var(--accent);font-weight:600;margin:10px 0 2px">▎代码块（```语言 … ```）</div>' +
      '<div>默认带行号和复制按钮；超 15 行自动折叠；连续多个代码块自动变 Tab 切换组</div>' +
      '<div><b>关闭行号：</b><code>```js showLineNumbers=false</code> <b>无边框：</b><code>```sh frame="none"</code></div>' +
      '<div><b>diff 对比：</b><code>```diff</code> 里 <code>- 删除行</code> / <code>+ 新增行</code>；bash/sh/powershell 自动用终端风格</div>' +
      '<div><b>支持语言：</b>js, ts, html, css, python, bash, json, yaml, java, go, rust, sql, mermaid, plantuml, diff 等</div>' +

      '<div style="color:var(--accent);font-weight:600;margin:10px 0 2px">▎提醒框（5 种类型）</div>' +
      '<div><code>&gt; [!NOTE] 标题（可省略）</code> 换行 <code>&gt; 内容</code></div>' +
