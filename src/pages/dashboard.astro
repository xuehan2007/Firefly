              .catch(function (e) { showToast(e.message, 'error'); })
              .finally(function () { loadingDynamics.value = false; });
          }
          function newDynamic() {
            editingDynamicFilename.value = '';
            editingDynamicSha.value = '';
            var now = new Date();
            var pad = function (n) { return n < 10 ? '0' + n : '' + n; };
            dfm.published = now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate()) + 'T' + pad(now.getHours()) + ':' + pad(now.getMinutes());
            dbody.value = '';
            originalDbody.value = '';
            page.value = 'dynamic-editor';
          }
          function editDynamic(row) {
            api('/api/admin/dynamic/' + encodeURIComponent(row.filename)).then(function (data) {
              editingDynamicFilename.value = data.filename;
              editingDynamicSha.value = data.sha;
              var match = data.content.match(/^---\s*\n([\s\S]*?)\n---\s*\n?([\s\S]*)$/);
              if (match) {
                var m = match[1].match(/^published:\s*(.+)$/m);
                var pub = m ? m[1].trim() : '';
                if (pub.charAt(0) === '"') pub = pub.slice(1, -1);
                dfm.published = pub.replace(' ', 'T').slice(0, 16);
                dbody.value = match[2];
              } else {
                dfm.published = '';
                dbody.value = data.content;
              }
              originalDbody.value = dbody.value;
              page.value = 'dynamic-editor';
            }).catch(function (e) { showToast(e.message, 'error'); });
          }
          function saveDynamic() {
            if (!dbody.value.trim()) { showToast('请输入动态内容', 'warning'); return; }
            saving.value = true;
            var pub = dfm.published ? dfm.published + ':00' : new Date().toISOString();
            var fmStr = '---\npublished: ' + pub + '\n---\n';
            var content = fmStr + dbody.value;
            var filename = editingDynamicFilename.value;
            if (!filename) {
              var d = new Date();
              var pad = function (n) { return n < 10 ? '0' + n : '' + n; };
              filename = d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + '-' + pad(d.getHours()) + pad(d.getMinutes()) + pad(d.getSeconds()) + '.md';
            }
            var p;
            if (editingDynamicSha.value) {
              p = api('/api/admin/dynamic/' + encodeURIComponent(filename), { method: 'PUT', body: JSON.stringify({ content: content, sha: editingDynamicSha.value }) });
            } else {
              p = api('/api/admin/dynamics', { method: 'POST', body: JSON.stringify({ filename: filename, content: content }) });
            }
            p.then(function () {
              showToast('保存成功！', 'success');
              syncDeletedImages(originalDbody.value, dbody.value, 'dynamic').finally(function () { originalDbody.value = dbody.value; });
              setTimeout(function () { loadDynamics(); }, 1200);
            })
              .catch(function (e) { showToast(e.message, 'error'); })
              .finally(function () { saving.value = false; });
          }
          function deleteDynamic(row) {
            if (confirm('确定删除这条动态吗？')) {
              api('/api/admin/dynamic/' + encodeURIComponent(row.filename), { method: 'DELETE', body: JSON.stringify({ sha: row.sha }) })
                .then(function () { showToast('删除成功', 'success'); loadDynamics(); })
                .catch(function (e) { showToast(e.message, 'error'); });
            }
          }

          function toggleAllDynamics(e) {
            var checked = e.target.checked;
            dynamics.value.forEach(function (d) { selectedDynamics[d.filename] = checked; });
          }

          function batchDeleteDynamics() {
            var toDelete = dynamics.value.filter(function (d) { return selectedDynamics[d.filename]; });
            if (!toDelete.length) return;
            if (!confirm('确定删除选中的 ' + toDelete.length + ' 条动态吗？此操作不可撤销。')) return;
            var done = 0, failed = 0;
            toDelete.forEach(function (d) {
              api('/api/admin/dynamic/' + encodeURIComponent(d.filename), { method: 'DELETE', body: JSON.stringify({ sha: d.sha }) })
                .then(function () { done++; })
                .catch(function () { failed++; })
                .finally(function () {
                  if (done + failed === toDelete.length) {
                    if (failed) { showToast('删除完成：' + done + ' 成功，' + failed + ' 失败', 'warning'); }
                    else { showToast('已删除 ' + done + ' 条动态', 'success'); }
                    Object.keys(selectedDynamics).forEach(function (k) { selectedDynamics[k] = false; });
                    loadDynamics();
                  }
                });
            });
          }

