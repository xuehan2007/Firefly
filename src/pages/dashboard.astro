          // 根据网站 URL 自动生成 favicon URL
          function getFaviconUrl(url) {
            if (!url) return '';
            try {
              var domain = new URL(url).hostname;
              return 'https://a.favicon.im/' + encodeURIComponent(domain);
            } catch {
              return '';
            }
          }
          // 输入 URL 失焦时：自动获取网站名称和图标
          function autoFavicon(item, gi, ii) {
            if (!item.url) return;
            var url = item.url.trim();
            if (!/^https?:\/\//i.test(url)) url = 'https://' + url;
            var needTitle = !item.title;
            var needIcon = !item.icon;
            if (!needTitle && !needIcon) return; // 都已有值,不覆盖
            item._fetching = true;
            booknavList.value[gi].items[ii] = Object.assign({}, item);
            api('/api/admin/site-info?url=' + encodeURIComponent(url))
              .then(function (info) {
                if (needTitle && info.title) item.title = info.title;
                if (needIcon) item.icon = info.icon || getFaviconUrl(url);
                item._fetching = false;
                booknavList.value[gi].items[ii] = Object.assign({}, item);
                if (info.title || info.icon) showToast('已自动获取网站信息', 'success');
              })
              .catch(function () {
                // 接口失败时用 favicon 服务兜底
                if (needIcon) item.icon = getFaviconUrl(url);
                item._fetching = false;
                booknavList.value[gi].items[ii] = Object.assign({}, item);
              });
          }


