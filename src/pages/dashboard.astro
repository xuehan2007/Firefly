          }

          function batchDeletePosts() {
            var toDelete = posts.value.filter(function (p) { return selectedPosts[p.filename]; });
            if (!toDelete.length) return;
            if (!confirm('确定删除选中的 ' + toDelete.length + ' 篇文章吗？此操作不可撤销。')) return;
            var done = 0, failed = 0;
            toDelete.forEach(function (p) {
              api('/api/admin/post/' + encodeURIComponent(p.filename), { method: 'DELETE', body: JSON.stringify({ sha: p.sha }) })
                .then(function () { done++; })
                .catch(function () { failed++; })
                .finally(function () {
