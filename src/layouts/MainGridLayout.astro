---
import Live2DWidget from "@components/features/Live2DWidget.astro";

import SpineModel from "@components/features/SpineModel.astro";
import Footer from "@components/layout/Footer.astro";
import HeaderTopRow from "@components/layout/HeaderTopRow.astro";
import NavMenuPanel from "@components/layout/NavMenuPanel.astro";
import SideBar from "@components/layout/SideBar.astro";
import type { MarkdownHeading } from "astro";
import FloatingControls from "@/components/controls/FloatingControls.astro";
import CategoryBar from "@/components/layout/CategoryBar.astro";
import SidebarColumn from "@/components/layout/SidebarColumn.astro";
import WallpaperSection from "@/components/layout/WallpaperSection.astro";
import {
	live2dWidgetConfig,
	navbarMode,
	sidebarLayoutConfig,
	siteConfig,
} from "@/config";
import { getBannerVisibilityState } from "@/utils/banner-visibility-utils";
import { getBackgroundImages, isHomePage } from "@/utils/layout-utils";
import { resolveNavMenuLinks } from "@/utils/nav-menu-utils";
import { getEffectiveSidebarState } from "@/utils/sidebar-effective-utils";
import Layout from "./Layout.astro";

import "@/styles/expressive-code.css";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	postCoverImage?: string;
	ogImageWidth?: number;
	ogImageHeight?: number;
	ogImageAlt?: string;
	postCategory?: string;
	headings?: MarkdownHeading[];
	encrypted?: boolean;
	bannerPostMeta?: {
		title: string;
		description?: string;
		published: Date;
		updated?: Date;
		words?: number;
		minutes?: number;
	};
	heading?: string;
}

const backgroundImages = getBackgroundImages();

// 首屏壁纸随机起点：head 内联脚本在解析期随机选一张，轮播脚本读 window.__wpStart 从同一张开始。
// 不再在这里注入 <link rel=preload> —— 它只能预加载固定 webp，而 <picture> 实际选择的是 avif，
// 两个 URL 不同会多下载一整张壁纸（100~230KB）。首图改由 WallpaperSection 实例化时
// 带 fetchpriority="high" 直接请求，只下载真正会显示的那一张。
const wallpaperStartCounts = JSON.stringify({
	d: backgroundImages.desktop.length,
	m: backgroundImages.mobile.length,
});

const {
	title,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	postCoverImage,
	ogImageWidth,
	ogImageHeight,
	ogImageAlt,
	postCategory,
	headings = [],
	encrypted = false,
	bannerPostMeta,
	heading,
} = Astro.props;

const isHomePageCheck = isHomePage(Astro.url.pathname);
const isPostPage = !!postSlug;
const shouldRenderCategoryBar = !!siteConfig.categoryBar;
const navbarWidthFull = siteConfig.navbar.widthFull ?? false;

const banner = getBannerVisibilityState({
	isHomePage: isHomePageCheck,
	isPostPage,
	title,
	bannerPostMeta,
});
const sidebar = getEffectiveSidebarState({ isPostPage });

const { hasWallpaper } = banner;
const {
	hideSidebarOnPostPage,
	hasLeftComponents,
	hasRightComponents,
	sidebarClass,
	staticBarClass,
	gridColumnStyle,
	gridDataAttrs,
} = sidebar;
---

<Layout title={title} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} postSlug={postSlug} postCoverImage={postCoverImage} ogImageWidth={ogImageWidth} ogImageHeight={ogImageHeight} ogImageAlt={ogImageAlt} hasWallpaper={hasWallpaper}>

<slot slot="head" name="head" />
{/* 首屏壁纸随机起点：只生成随机 index，不预加载图片（见上方说明），
     window.__wpStart 供轮播脚本从同一张开始 */}
{hasWallpaper && (
  <script
    slot="head"
    is:inline
    data-swup-ignore-script
    set:html={`(function(){
      var P = ${wallpaperStartCounts};
      window.__wpStart = {
        desktop: Math.floor(Math.random() * P.d),
        mobile: Math.floor(Math.random() * P.m)
      };
    })();`}
  />
)}
<HeaderTopRow navbarMode={navbarMode} navbarWidthFull={navbarWidthFull} />

<WallpaperSection state={banner} backgroundImages={backgroundImages} title={title} bannerPostMeta={bannerPostMeta} />

<!-- Main content -->
<div id="content-panel" class="content-panel absolute w-full z-30 pointer-events-none">
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div id="content-panel-inner" class="relative w-full xl:w-[92vw] max-w-(--page-width) mx-auto pointer-events-auto" style={gridColumnStyle}>
        {/* 列几何唯一真源 = computeGridColumns()，SSR 写在父级 #content-panel-inner 上
            （页脚作为兄弟节点也要拿到 --content-ratio-*）。子元素无需定位类：
            侧栏包裹层是 display:contents，真正的 grid item 是内层元素 */}
        <div id="main-grid"
          class="transition duration-700 w-full left-0 right-0 grid mx-auto gap-4 px-2 md:px-4 mobile-no-sidebar"
          {...gridDataAttrs}
        >

            <SidebarColumn
                side="left"
                position={sidebarLayoutConfig.position}
                enable={sidebarLayoutConfig.enable}
                hideSidebarOnPostPage={hideSidebarOnPostPage}
                hasLeftComponents={hasLeftComponents}
                hasRightComponents={hasRightComponents}
                sidebarClass={sidebarClass}
                headings={headings}
                encrypted={encrypted}
            />
                    
            {/* 主内容区包装器 - 包含静态栏位和swup容器，作为单个grid item */}
            <div id="content-column" class={staticBarClass}>
                {/* 分类导航栏 - 全站渲染并显示 */}
                {shouldRenderCategoryBar && <div id="category-bar-wrapper"><CategoryBar currentPostCategory={postCategory} /></div>}
                {/* 主内容区 - 始终渲染，确保 Swup 容器存在 */}
                <main
                    id="swup-container"
                    class="transition-main"
                    data-current-post-category={postCategory || ""}
                >
                {/* 为每个页面提供一个隐藏的h1标题，用于SEO和可访问性 */}
                <h1 class="sr-only">{heading || title}</h1>
                <div id="content-wrapper" class="onload-animation transition-leaving">
                    <slot></slot>
                </div>
            </main>

                {/* 移动端底部组件：<768px 时 #main-grid 是 display:block，必须排在页脚之前 */}
                {sidebarLayoutConfig.mobileBottomComponents && sidebarLayoutConfig.mobileBottomComponents.length > 0 && (
                    <div id="mobile-bottom-sidebar" class="block md:hidden mt-4">
                        <SideBar side="bottom" headings={headings} encrypted={encrypted}></SideBar>
                    </div>
                )}
            </div>

            <SidebarColumn
                side="right"
                position={sidebarLayoutConfig.position}
                enable={sidebarLayoutConfig.enable}
                hideSidebarOnPostPage={hideSidebarOnPostPage}
                hasLeftComponents={hasLeftComponents}
                hasRightComponents={hasRightComponents}
                sidebarClass={sidebarClass}
                headings={headings}
                encrypted={encrypted}
            />

        </div>

        <SpineModel></SpineModel>
        {live2dWidgetConfig.enable && <Live2DWidget config={live2dWidgetConfig} />}

        {/* 页脚宽度跨「侧栏 + 内容栏」，故在 #content-column 之外；又在 Swup 容器之外，
            切页不重渲染 */}
        <Footer />
    </div>
</div>

<FloatingControls headings={headings} encrypted={encrypted} />

<!-- 移动端导航抽屉：渲染为 <body> 直系子元素，脱离导航栏的 transform 包含块才能铺满视口 -->
<NavMenuPanel links={resolveNavMenuLinks()} />

<!-- 卡片 3D 倾斜（仅 PC 悬停设备）+ 文章段落滚动淡入；均尊重系统 reduced-motion -->
<script is:inline>
(function () {
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    // ===== 卡片 3D 倾斜：跟随鼠标轻微旋转，离开复位 =====
    function initCardTilt() {
        if (!canHover || reduceMotion) return;
        document.querySelectorAll('.post-card-item').forEach(function (card) {
            if (card.__tiltBound) return;
            card.__tiltBound = true;
            var raf = null;
            card.addEventListener('mousemove', function (e) {
                if (raf) return;
                raf = requestAnimationFrame(function () {
                    raf = null;
                    var r = card.getBoundingClientRect();
                    var x = (e.clientX - r.left) / r.width - 0.5;
                    var y = (e.clientY - r.top) / r.height - 0.5;
                    card.classList.add('tilt-active');
                    card.style.transform = 'perspective(900px) rotateX(' + (-y * 4).toFixed(2) + 'deg) rotateY(' + (x * 5).toFixed(2) + 'deg) translateY(-2px)';
                });
            });
            card.addEventListener('mouseleave', function () {
                if (raf) { cancelAnimationFrame(raf); raf = null; }
                card.style.transform = '';
            });
        });
    }

    // ===== 滚动触发段落淡入：文章正文子元素进入视口时浮现 =====
    var revealObserver = null;
    function initScrollReveal() {
        if (reduceMotion) return;
        var content = document.querySelector('.markdown-content');
        if (!content) return;
        if (!revealObserver) {
            revealObserver = new IntersectionObserver(function (entries) {
                entries.forEach(function (en) {
                    if (en.isIntersecting) {
                        en.target.classList.add('revealed');
                        revealObserver.unobserve(en.target);
                    }
                });
            }, { rootMargin: '0px 0px -8% 0px' });
        }
        content.querySelectorAll(':scope > *').forEach(function (el) {
            if (el.classList.contains('scroll-reveal')) return;
            el.classList.add('scroll-reveal');
            revealObserver.observe(el);
        });
    }

    function initAll() { initCardTilt(); initScrollReveal(); }
    if (!window.__tiltRevealInit) {
        window.__tiltRevealInit = true;
        initAll();
        document.addEventListener('astro:page-load', initAll);
    }
})();
</script>

<!--
    触屏设备上让代码块的复制按钮默认隐藏，点一下代码块才显形。
    expressive-code 没给 <pre> 加 tabindex，点击代码区不会产生焦点，
    所以纯 CSS 的 :focus-within 拿不到这个状态，只能在这里补一个类。
    显隐规则见 src/styles/expressive-code.css 的 @media (hover: none) 段。
-->


</Layout>
