---
import { Icon } from "astro-icon/components";
import TypewriterText from "@/components/features/TypewriterText.astro";
import { backgroundWallpaper } from "@/config";
import { encodeMailto, MAILTO_ONCLICK_SCRIPT } from "@/utils/email-utils";

interface Props {
	showHomeText: boolean;
	initialRandomSubtitle: string | undefined;
}

const { showHomeText, initialRandomSubtitle } = Astro.props;
const homeText = backgroundWallpaper.common?.homeText;
const homeTextLinks = homeText?.links;
const homeTextLinksEnable = homeText?.linksEnable !== false;
---
{homeText?.enable && (
    <div class={`banner-home-text-overlay absolute inset-0 z-20 flex items-center justify-center ${!showHomeText ? 'hidden' : ''}`}>
        <div class="w-4/5 lg:w-3/4 text-center mb-0">
            <div class="flex flex-col">
                {homeText.title && (
                    <div class="banner-title mb-2 lg:mb-4" style={{ '--banner-title-size': homeText.titleSize || "3rem" }}>
                        {/* 矢量 SVG 标题：内联渲染可访问页面加载的 Zen Maru Gothic 字体，任意 DPI 下均清晰 */}
                        <svg class="banner-logo-svg" viewBox="0 0 744 250" width="744" height="250" role="img" aria-label="eee123 blog" xmlns="http://www.w3.org/2000/svg">
                            <defs>
                                <linearGradient id="bannerBlueGrad" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="#54b8ff"/>
                                    <stop offset="55%" stop-color="#2f8ff5"/>
                                    <stop offset="100%" stop-color="#1a6fd6"/>
                                </linearGradient>
                                <linearGradient id="bannerDarkGrad" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="#4a4a4a"/>
                                    <stop offset="100%" stop-color="#1f1f1f"/>
                                </linearGradient>
                                <filter id="bannerLogoShadow" x="-5%" y="-5%" width="110%" height="115%">
                                    <feDropShadow dx="1" dy="3" stdDeviation="2.5" flood-color="#000" flood-opacity="0.28"/>
                                </filter>
                            </defs>
                            <g transform="skewX(-9)" filter="url(#bannerLogoShadow)" font-family="'Zen Maru Gothic','Hiragino Maru Gothic ProN','Yu Gothic','Microsoft YaHei',sans-serif" font-weight="700">
                                <text x="12" y="182" font-size="108" fill="url(#bannerBlueGrad)">eee123</text>
                                <text x="412" y="182" font-size="108" fill="url(#bannerDarkGrad)">の</text>
                                <ellipse cx="468" cy="92" rx="62" ry="23" fill="none" stroke="url(#bannerDarkGrad)" stroke-width="4.5" transform="rotate(-22 468 92)"/>
                                <path d="M468 56 L472 88 L504 92 L472 96 L468 128 L464 96 L432 92 L464 88 Z" fill="#2f8ff5"/>
                                <path d="M468 64 L468 120 M436 92 L500 92" stroke="#7fd0ff" stroke-width="2" stroke-linecap="round" opacity="0.85"/>
                                <text x="516" y="182" font-size="108" fill="url(#bannerDarkGrad)">blog</text>
                            </g>
                        </svg>
                    </div>
                )}
                {/* 四张动画并排循环播放，保持完整比例不裁切。
                    动态 WebP（带透明通道）优先，体积约为 GIF 的 1/4；不支持时回退 GIF */}
                <div class="banner-gifs flex items-center justify-center gap-0 mt-0.5" style="pointer-events: none;">
                    {[1, 2, 3, 4].map((i) => (
                        <picture class="banner-gif w-auto max-w-full object-contain shrink-0" style="aspect-ratio: auto;">
                            <source srcset={`/assets/gifs/ba-${i}.webp`} type="image/webp" />
                            <img
                                src={`/assets/gifs/ba-${i}.gif`}
                                alt={``}
                                class="banner-gif w-auto max-w-full object-contain shrink-0"
                                style="aspect-ratio: auto;"
                                loading="eager"
                            />
                        </picture>
                    ))}
                </div>
                {/* 横幅标题下方的链接图标（subtitle 的兄弟节点，避免被打字机/随机副标题的 textContent 覆盖清掉） */}
                {homeTextLinksEnable && homeTextLinks && homeTextLinks.length > 0 && (
                    <div class="banner-links mt-5 flex items-center justify-center gap-3 pointer-events-auto">
                        {homeTextLinks.map((link) => {
                            // mailto 链接做 base64 加密防爬虫（点击时才解码导航，与 Profile 一致）
                            const isMailto = link.url.startsWith("mailto:");
                            const encodedEmail = isMailto
                                ? encodeMailto(link.url)
                                : undefined;
                            const isExternal = link.url.startsWith("http");
                            return (
                                <a
                                    href={isMailto ? "#" : link.url}
                                    aria-label={link.name}
                                    title={link.name}
                                    data-encoded-email={encodedEmail}
                                    target={!isMailto && isExternal ? "_blank" : undefined}
                                    rel={!isMailto && isExternal ? "noopener" : undefined}
                                    class={link.showName ? "banner-link banner-link-text" : "banner-link"}
                                    style="color: #fff"
                                    onclick={isMailto ? MAILTO_ONCLICK_SCRIPT : undefined}
                                >
                                    {/* 内联 fill: currentColor，避免 CSS 加载前 SVG 默认黑色图标闪现 */}
                                    <Icon name={link.icon} class="text-[1.25rem]" style="fill: currentColor" />
                                    {link.showName && <span>{link.name}</span>}
                                </a>
                            );
                        })}
                    </div>
                )}
            </div>
        </div>
    </div>
)}

<script is:inline>
    function setRandomSubtitle() {
        const subtitleElement = document.getElementById('banner-subtitle');
        if (!subtitleElement) return;

        const subtitlesData = subtitleElement.dataset.subtitles;
        if (!subtitlesData) return;

        try {
            const subtitles = JSON.parse(subtitlesData);
            // Only randomize if it's an array and typewriter is NOT enabled (check for typewriter class)
            if (Array.isArray(subtitles) && subtitles.length > 0 && !subtitleElement.querySelector('.typewriter')) {
                // Use a global variable to persist the subtitle across Swup navigations
                // This variable will be reset on full page reload (F5), meeting the requirement
                if (!window.fireflyCachedSubtitle) {
                    const randomIndex = Math.floor(Math.random() * subtitles.length);
                    window.fireflyCachedSubtitle = subtitles[randomIndex];
                }
                subtitleElement.textContent = window.fireflyCachedSubtitle;
            }
        } catch (e) {
            console.error("Failed to parse subtitles", e);
        }
    }

    // Run on initial load
    setRandomSubtitle();
</script>

<style is:global>
    .banner-logo-svg {
        height: 16rem !important;
        width: auto !important;
        max-width: 100%;
        margin: 0 auto;
        display: block;
        /* 矢量图，无需插值；保留极轻投影增强层次（SVG 内部已有主投影） */
        filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.25));
    }
    @media (max-width: 768px) {
        .banner-logo-svg {
            height: 8rem !important;
        }
    }
</style>
