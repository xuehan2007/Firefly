---
---
{/* 站内链接悬浮预览卡：悬停/聚焦 200ms 后抓取目标页标题、摘要、封面 */}
<div id="link-preview-card" class="link-preview-card" role="tooltip" aria-hidden="true">
    <div class="link-preview-card__cover">
        <img alt="" />
    </div>
    <div class="link-preview-card__body">
        <div class="link-preview-card__title"></div>
        <div class="link-preview-card__desc"></div>
        <div class="link-preview-card__site">
            <span class="link-preview-card__dot"></span>
            <span class="link-preview-card__domain"></span>
        </div>
    </div>
</div>

<script>
    interface PreviewData {
        title: string;
        description: string;
        image: string;
    }

    const HOVER_DELAY = 200;

    const card = document.getElementById("link-preview-card") as HTMLElement;
    const coverImg = card.querySelector(".link-preview-card__cover img") as HTMLImageElement;
    const coverWrap = card.querySelector(".link-preview-card__cover") as HTMLElement;
    const titleEl = card.querySelector(".link-preview-card__title") as HTMLElement;
    const descEl = card.querySelector(".link-preview-card__desc") as HTMLElement;
    const domainEl = card.querySelector(".link-preview-card__domain") as HTMLElement;

    let showTimer: ReturnType<typeof setTimeout> | undefined;
    let hideTimer: ReturnType<typeof setTimeout> | undefined;
    let currentLink: HTMLAnchorElement | null = null;

    // 已完成的请求缓存；inflight 保证悬停抖动时不重复请求
    const cache = new Map<string, PreviewData | null>();
    const inflight = new Map<string, Promise<PreviewData | null>>();

    /** 判断链接是否适合显示预览：仅同域普通页面 */
    function previewable(a: HTMLAnchorElement): boolean {
        const rawHref = a.getAttribute("href");
        if (!rawHref || rawHref.startsWith("#")) return false;
        if (a.hasAttribute("download") || a.dataset.noPreview !== undefined) return false;

        let u: URL;
        try {
            u = new URL(a.href);
        } catch {
            return false;
        }
        if (u.origin !== location.origin) return false;
        // 同页锚点
        if (u.pathname === location.pathname && u.hash) return false;
        // 后台 / API / 常见文件
        if (/^\/(api|dashboard|admin)(\/|$)/.test(u.pathname)) return false;
        if (/\.(jpe?g|png|gif|webp|avif|svg|zip|rar|7z|pdf)$/i.test(u.pathname)) return false;
        if (a.closest("[data-no-preview]")) return false;
        return true;
    }

    async function loadPreview(rawUrl: string): Promise<PreviewData | null> {
        const url = rawUrl.split("#")[0];
        if (cache.has(url)) return cache.get(url) ?? null;
        const pending = inflight.get(url);
        if (pending) return pending;

        const promise = (async () => {
            try {
                const res = await fetch(url, { credentials: "same-origin" });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const doc = new DOMParser().parseFromString(await res.text(), "text/html");
                const meta = (key: string): string =>
                    doc
                        .querySelector(`meta[property="${key}"],meta[name="${key}"]`)
                        ?.getAttribute("content")
                        ?.trim() ?? "";
                const title =
                    meta("og:title") ||
                    doc.querySelector("title")?.textContent?.trim() ||
                    url;
                const description = (meta("og:description") || meta("description")).slice(0, 110);
                let image = meta("og:image");
                if (image && !/^https?:/i.test(image)) {
                    image = new URL(image, location.origin).href;
                }
                const data: PreviewData = { title, description, image };
                cache.set(url, data);
                return data;
            } catch {
                cache.set(url, null);
                return null;
            } finally {
                inflight.delete(url);
            }
        })();

        inflight.set(url, promise);
        return promise;
    }

    function render(data: PreviewData, url: string) {
        titleEl.textContent = data.title;
        descEl.textContent = data.description;
        if (data.description) descEl.classList.remove("is-empty");
        else descEl.classList.add("is-empty");
        if (data.image) {
            coverImg.src = data.image;
            coverWrap.classList.remove("is-hidden");
        } else {
            coverWrap.classList.add("is-hidden");
        }
        domainEl.textContent = new URL(url).pathname;
    }

    function position(a: HTMLAnchorElement) {
        card.classList.add("is-visible");
        card.setAttribute("aria-hidden", "false");

        const rect = a.getBoundingClientRect();
        const cw = card.offsetWidth;
        const ch = card.offsetHeight;

        // 水平：先对齐链接中心，再夹进视口
        let left = rect.left + rect.width / 2 - cw / 2;
        left = Math.max(8, Math.min(left, window.innerWidth - cw - 8));

        // 垂直：默认放下方，空间不够翻到上方
        let top = rect.bottom + 8;
        if (top + ch > window.innerHeight - 8) top = rect.top - ch - 8;
        top = Math.max(8, top);

        card.style.left = `${left}px`;
        card.style.top = `${top}px`;
    }

    function hide() {
        clearTimeout(showTimer);
        card.classList.remove("is-visible");
        card.setAttribute("aria-hidden", "true");
        currentLink = null;
    }

    function scheduleShow(a: HTMLAnchorElement) {
        currentLink = a;
        clearTimeout(hideTimer);
        clearTimeout(showTimer);
        showTimer = setTimeout(async () => {
            const data = await loadPreview(a.href);
            // 等待期间已移开或切页则放弃
            if (currentLink !== a || !data) return;
            render(data, a.href);
            position(a);
        }, HOVER_DELAY);
    }

    function scheduleHide() {
        clearTimeout(showTimer);
        hideTimer = setTimeout(hide, 120);
    }

    // 事件委托：监听挂在 document 上，Swup 切换页面后依然有效
    document.addEventListener("pointerover", (e) => {
        const a = (e.target as Element | null)?.closest?.("a") as HTMLAnchorElement | null;
        if (a && previewable(a)) scheduleShow(a);
    });
    document.addEventListener("pointerout", (e) => {
        const a = (e.target as Element | null)?.closest?.("a") as HTMLAnchorElement | null;
        if (!a) return;
        const related = (e as MouseEvent).relatedTarget as Element | null;
        if (!related || !a.contains(related)) scheduleHide();
    });
    document.addEventListener("focusin", (e) => {
        const a = (e.target as Element | null)?.closest?.("a") as HTMLAnchorElement | null;
        if (a && previewable(a)) scheduleShow(a);
    });
    document.addEventListener("focusout", () => scheduleHide());

    // 滚动 / 点击 / 调整窗口 / Swup 切页时立即隐藏，避免卡片悬空
    window.addEventListener("scroll", hide, { passive: true, capture: true });
    window.addEventListener("resize", hide);
    document.addEventListener("click", hide);
    document.addEventListener("swup:content:replace", hide);
</script>

<style>
    .link-preview-card {
        position: fixed;
        z-index: 9999;
        width: 300px;
        max-width: calc(100vw - 16px);
        border-radius: 14px;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.9);
        color: rgba(0, 0, 0, 0.88);
        border: 1px solid rgba(0, 0, 0, 0.08);
        box-shadow: 0 16px 48px rgba(0, 0, 0, 0.22);
        backdrop-filter: blur(16px) saturate(1.4);
        -webkit-backdrop-filter: blur(16px) saturate(1.4);
        opacity: 0;
        visibility: hidden;
        transform: translateY(4px) scale(0.98);
        transition:
            opacity 0.18s ease,
            transform 0.18s ease,
            visibility 0.18s;
        pointer-events: none;
    }

    :global(.dark) .link-preview-card {
        background: rgba(17, 20, 27, 0.92);
        color: rgba(255, 255, 255, 0.92);
        border-color: rgba(255, 255, 255, 0.1);
        box-shadow: 0 16px 48px rgba(0, 0, 0, 0.55);
    }

    .link-preview-card.is-visible {
        opacity: 1;
        visibility: visible;
        transform: translateY(0) scale(1);
    }

    .link-preview-card__cover {
        height: 150px;
        overflow: hidden;
    }
    .link-preview-card__cover.is-hidden {
        display: none;
    }
    .link-preview-card__cover img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .link-preview-card__body {
        padding: 12px 14px 13px;
    }

    .link-preview-card__title {
        font-size: 0.92rem;
        font-weight: 700;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .link-preview-card__desc {
        margin-top: 5px;
        font-size: 0.78rem;
        line-height: 1.5;
        opacity: 0.68;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .link-preview-card__desc.is-empty {
        display: none;
    }

    .link-preview-card__site {
        margin-top: 9px;
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.72rem;
        opacity: 0.6;
    }

    .link-preview-card__dot {
        width: 6px;
        height: 6px;
        border-radius: 999px;
        background: var(--primary);
        box-shadow: 0 0 8px var(--primary);
        flex-shrink: 0;
    }
</style>
