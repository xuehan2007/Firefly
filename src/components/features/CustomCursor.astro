---
/**
 * CustomCursor.astro
 *
 * 用逐帧 PNG 实现跟随鼠标的动画光标（浏览器不支持 .ani，APNG 动态切换 src 不播放，
 * 因此用 setInterval 逐帧切换 <img> src，最可靠）。
 */
---

<div id="custom-cursor" aria-hidden="true">
  <img id="custom-cursor-img" src="/assets/cursors/pointer/0.png" alt="" />
</div>

<style>
  #custom-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 32px;
    height: 32px;
    pointer-events: none;
    z-index: 2147483647;
    will-change: transform;
    display: none;
  }
  #custom-cursor img {
    width: 32px;
    height: 32px;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }
  @media (hover: hover) and (pointer: fine) {
    html.has-custom-cursor,
    html.has-custom-cursor * {
      cursor: none !important;
    }
    html.has-custom-cursor #custom-cursor {
      display: block;
    }
  }
</style>

<script is:inline data-swup-ignore-script>
(function () {
  if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;

  // 状态配置：帧数 + 热点坐标
  const STATES = {
    pointer:     { frames: 24, hx: 3,  hy: 3  },
    link:        { frames: 12, hx: 4,  hy: 4  },
    text:        { frames: 24, hx: 16, hy: 16 },
    move:        { frames: 12, hx: 16, hy: 16 },
    unavailable: { frames: 24, hx: 16, hy: 16 },
    cross:       { frames: 24, hx: 16, hy: 16 },
    help:        { frames: 24, hx: 16, hy: 16 },
    working:     { frames: 24, hx: 3,  hy: 3  },
    busy:        { frames: 24, hx: 16, hy: 16 },
    alternate:   { frames: 12, hx: 3,  hy: 3  },
  };
  const FRAME_MS = 80; // 每帧持续时间

  // 预加载所有帧
  const frameCache = {};
  for (const state in STATES) {
    frameCache[state] = [];
    for (let i = 0; i < STATES[state].frames; i++) {
      const img = new Image();
      img.src = `/assets/cursors/${state}/${i}.png`;
      frameCache[state].push(img);
    }
  }

  const cursorEl = document.getElementById("custom-cursor");
  const imgEl = document.getElementById("custom-cursor-img");
  if (!cursorEl || !imgEl) return;

  let currentState = "pointer";
  let frameIndex = 0;
  let mx = -100, my = -100;

  function detectState(target) {
    if (!target) return "pointer";
    if (target.closest("[disabled], [aria-disabled='true']")) return "unavailable";
    if (target.closest("input[type='text'], input[type='password'], input[type='email'], input[type='search'], input[type='url'], input[type='tel'], input[type='number'], textarea, [contenteditable='true']")) return "text";
    if (target.closest("a[href], button, [role='button'], [role='link'], input[type='button'], input[type='submit'], input[type='reset'], select, label[for]")) return "link";
    return "pointer";
  }

  function setCursor(state) {
    if (state === currentState) return;
    currentState = state;
    frameIndex = 0;
  }

  function tick() {
    const s = STATES[currentState];
    imgEl.src = `/assets/cursors/${currentState}/${frameIndex}.png`;
    cursorEl.style.transform = `translate3d(${mx - s.hx}px, ${my - s.hy}px, 0)`;
    frameIndex = (frameIndex + 1) % s.frames;
  }

  document.documentElement.classList.add("has-custom-cursor");

  window.addEventListener("mousemove", (e) => {
    mx = e.clientX;
    my = e.clientY;
  }, { passive: true });

  document.addEventListener("mouseover", (e) => {
    setCursor(detectState(e.target));
  }, { passive: true });

  document.addEventListener("mouseleave", () => { cursorEl.style.display = "none"; });
  document.addEventListener("mouseenter", () => { cursorEl.style.display = "block"; });

  setInterval(tick, FRAME_MS);
  tick();
})();
</script>
